# .env 不入库（已在 .gitignore）；本文件只作模板，复制为 .env 后填入实际值。
# 三项均必填：LangChain ChatOpenAI 使用的 Chat Completions 文本模型接口（V2 全链路唯一 LLM 出口，见 src/drama_interaction/llm.py）。

# 模型 ID
LLM_MODEL_ID=your-llm-model-id
# API Key
LLM_API_KEY=your-llm-api-key
# 端点 Base URL（第三方端点通常以 /v1 结尾）
LLM_BASE_URL=https://your-llm-endpoint/v1
# PostgreSQL checkpoint database（必须配置；不支持 SQLite 回退）
CHECKPOINT_DATABASE_URL=postgresql://your-user:your-password@localhost:5432/drama_interaction

# ———————— V2 媒体与多模态模型配置（十六项能力字段均必填）————————
AUDIO_SEPARATOR_ACCESS_KEY_ID=your-access-key-id
AUDIO_SEPARATOR_ACCESS_KEY_SECRET=your-access-key-secret
AUDIO_SEPARATOR_BUCKET=your-bucket-appid
AUDIO_SEPARATOR_REGION=ap-guangzhou

ASR_MODEL_ID=qwen-audio-3.0-asr-flash-filetrans
ASR_API_KEY=your-dashscope-api-key
ASR_BASE_URL=https://dashscope.aliyuncs.com/api/v1

AUDIO_OBSERVER_MODEL_ID=qwen3.5-omni-flash
AUDIO_OBSERVER_API_KEY=your-dashscope-api-key
AUDIO_OBSERVER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

OCR_MODEL_ID=qwen-3.8-flash
OCR_API_KEY=your-dashscope-api-key
OCR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

VLM_MODEL_ID=qwen-3.8-flash
VLM_API_KEY=your-dashscope-api-key
VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ———————— LangSmith 监控（可选，不填即关闭）————————
# LangSmith 侧按 LANGSMITH_* 标准变量名自动生效（langgraph 依赖 langsmith，无需额外安装）。
# 是否启用监控（true / false）
LANGSMITH_TRACING=false
# LangSmith WebUI / API 地址
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# 在 LangSmith 创建的 API Key
LANGSMITH_API_KEY=your-langsmith-api-key
# 自定义项目名称，可在 LangSmith WebUI 按名称查看对应运行记录；留空则用默认 project
LANGSMITH_PROJECT=
