[
  {
    "id": 1,
    "start": "00:00:00.000",
    "end": "00:00:10.110",
    "text": "逆子，今天是陛下招驸马，打起精神来。",
    "speech": "单人发言",
    "emotion": "严厉",
    "voice": "语气严厉，音量提高",
    "music": "轻快诙谐的古风背景音乐",
    "audio_cues": [
      "鸟鸣声"
    ],
    "uncertainty": ""
  },
  {
    "id": 2,
    "start": "00:00:11.260",
    "end": "00:00:16.540",
    "text": "老爷，宇儿平时这样都习惯了，你又何必为难他呢？",
    "speech": "单人发言",
    "emotion": "温和劝解",
    "voice": "语调平缓，音量适中",
    "music": "轻快诙谐的古风背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 3,
    "start": "00:00:19.070",
    "end": "00:00:26.170",
    "text": "镇北侯，你怎么把你二公子也带来了，难不成他也要参加比武招亲？",
    "speech": "单人发言",
    "emotion": "充满质疑与嘲讽",
    "voice": "语气夸张，带着明显的戏谑感",
    "music": "轻快诙谐的古风背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 4,
    "start": "00:00:26.320",
    "end": "00:00:37.170",
    "text": "镇北侯，整个皇城谁不知道你家二公子只会花天酒地的废物，他也参加，上场就投降。",
    "speech": "多人重叠发言",
    "emotion": "嘲讽哄笑",
    "voice": "多人笑声与说话声重叠，氛围戏谑",
    "music": "轻快诙谐的古风背景音乐持续",
    "audio_cues": [
      "多人笑声"
    ],
    "uncertainty": ""
  },
  {
    "id": 5,
    "start": "00:00:37.580",
    "end": "00:00:39.180",
    "text": "哎，可以投降吗？",
    "speech": "单人发言",
    "emotion": "疑惑",
    "voice": "语气随意，带着漫不经心的疑惑",
    "music": "轻快诙谐的古风背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 6,
    "start": "00:00:39.440",
    "end": "00:00:49.220",
    "text": "逆子，给我闭嘴！老子戎马一生，怎么就生出你这么个废物，哎。",
    "speech": "单人发言",
    "emotion": "愤怒又无奈",
    "voice": "先厉声呵斥，随后转为低沉疲惫，伴随叹气声",
    "music": "轻快诙谐的古风背景音乐持续",
    "audio_cues": [
      "叹气声"
    ],
    "uncertainty": ""
  },
  {
    "id": 7,
    "start": "00:00:49.830",
    "end": "00:00:57.210",
    "text": "老爷别生气了，不是还有武儿吗，这次就权当是带宇儿出来长长见识。",
    "speech": "单人发言",
    "emotion": "温柔劝慰",
    "voice": "语调轻柔舒缓",
    "music": "转为低沉略带凝重的古风背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 8,
    "start": "00:00:58.330",
    "end": "00:01:06.430",
    "text": "嗯，多和大哥好好学习，你要是有武儿一半争气，我也，哎。",
    "speech": "单人发言",
    "emotion": "恨铁不成钢",
    "voice": "语气沉重，伴随叹气声",
    "music": "低沉凝重的古风背景音乐持续",
    "audio_cues": [
      "叹气声"
    ],
    "uncertainty": ""
  },
  {
    "id": 9,
    "start": "00:01:08.270",
    "end": "00:01:14.280",
    "text": "靖王，就苏宇这纨绔的样子，他能打伤您？你可别欺君啊。",
    "speech": "单人发言",
    "emotion": "质疑",
    "voice": "语气严肃，带着审视的意味",
    "music": "低沉凝重的古风背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 10,
    "start": "00:01:15.310",
    "end": "00:01:23.070",
    "text": "臣不敢，属下敢拿性命担保。",
    "speech": "单人发言",
    "emotion": "恭敬笃定",
    "voice": "语气沉稳郑重",
    "music": "低沉凝重的古风背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 11,
    "start": "00:01:23.070",
    "end": "00:01:31.070",
    "text": "",
    "speech": "",
    "emotion": "",
    "voice": "",
    "music": "宏大激昂的皇家仪式风格管弦乐骤然响起",
    "audio_cues": [
      "密集有力的鼓点声"
    ],
    "uncertainty": ""
  },
  {
    "id": 12,
    "start": "00:01:31.500",
    "end": "00:01:32.510",
    "text": "参见武皇。",
    "speech": "多人齐声发言",
    "emotion": "庄重恭敬",
    "voice": "多人声音洪亮整齐",
    "music": "宏大激昂的皇家仪式风格管弦乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 13,
    "start": "00:01:33.030",
    "end": "00:01:44.490",
    "text": "平身吧，诸位，武乃我大炎国之根本，今日择贤纳才，为景宁公主择以良婿，为驸马。",
    "speech": "单人发言",
    "emotion": "威严庄重",
    "voice": "声线浑厚洪亮，自带帝王气场",
    "music": "宏大激昂的皇家仪式风格管弦乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 14,
    "start": "00:01:44.840",
    "end": "00:01:49.390",
    "text": "听说景宁公主倾国倾城，乃是我大炎第一美人。",
    "speech": "单人发言",
    "emotion": "向往",
    "voice": "语气带着憧憬",
    "music": "宏大激昂的皇家仪式风格管弦乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 15,
    "start": "00:01:49.700",
    "end": "00:01:52.320",
    "text": "要是让我娶到景宁公主，让我死我都愿意。",
    "speech": "单人发言",
    "emotion": "狂热痴迷",
    "voice": "语气激动",
    "music": "宏大激昂的皇家仪式风格管弦乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 16,
    "start": "00:01:54.360",
    "end": "00:02:08.070",
    "text": "的确有几分姿色。",
    "speech": "单人发言",
    "emotion": "轻佻玩味",
    "voice": "语气散漫随意",
    "music": "悠扬大气的古风配乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 17,
    "start": "00:02:18.430",
    "end": "00:02:28.060",
    "text": "公主您看，镇北侯之子苏宇他怎么也来了，难道他也想娶公主？简直是癞蛤蟆想吃天鹅肉异想天开啊。",
    "speech": "单人发言",
    "emotion": "鄙夷嫌弃",
    "voice": "语气带着明显的不屑",
    "music": "悠扬大气的古风配乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 18,
    "start": "00:02:28.330",
    "end": "00:02:30.870",
    "text": "无妨，反正他也撑不过一轮。",
    "speech": "单人发言",
    "emotion": "淡然不屑",
    "voice": "语气平静，满是不在意",
    "music": "悠扬大气的古风配乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 19,
    "start": "00:02:31.140",
    "end": "00:02:35.170",
    "text": "镇北侯有他这样一个废物儿子，也算是家门不幸了。",
    "speech": "单人发言",
    "emotion": "嘲讽",
    "voice": "语气戏谑",
    "music": "悠扬大气的古风配乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 20,
    "start": "00:02:35.520",
    "end": "00:02:42.770",
    "text": "希望各位全力发挥，别藏着掖着，让朕看看我大炎武勋之后的本事。",
    "speech": "单人发言",
    "emotion": "威严",
    "voice": "声线洪亮有力，带着帝王的号召力",
    "music": "悠扬大气的古风配乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 21,
    "start": "00:02:43.160",
    "end": "00:02:47.830",
    "text": "这皇帝老儿身形看着挺眼熟的，就是站这么远都看不清长什么样。",
    "speech": "单人发言",
    "emotion": "散漫随意",
    "voice": "语气漫不经心",
    "music": "悠扬大气的古风配乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 22,
    "start": "00:02:48.260",
    "end": "00:02:53.440",
    "text": "这第一名我拿定了，喂，你问过我吗？",
    "speech": "多人轮流发言",
    "emotion": "先后呈现狂妄挑衅与不屑反问",
    "voice": "前一句语气嚣张，后一句带着漫不经心的挑衅",
    "music": "悠扬大气的古风配乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 23,
    "start": "00:02:55.030",
    "end": "00:03:00.170",
    "text": "宁儿啊，这都是我们大炎的俊才，可有看得上眼的？",
    "speech": "单人发言",
    "emotion": "慈爱温和",
    "voice": "语气平缓亲切",
    "music": "悠扬大气的古风配乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 24,
    "start": "00:03:05.580",
    "end": "00:03:14.070",
    "text": "父皇，能娶景宁的只能是武功高强的英雄，那些纨绔的子弟就不该来参加比赛，特别是像某些人。",
    "speech": "单人发言",
    "emotion": "傲娇不满",
    "voice": "语气带着少女的娇嗔与嫌弃",
    "music": "悠扬大气的古风配乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 25,
    "start": "00:03:14.370",
    "end": "00:03:19.300",
    "text": "嗯，哈哈哈哈，放心，肯定会有你喜欢的。",
    "speech": "单人发言",
    "emotion": "宠溺温和",
    "voice": "伴随爽朗的笑声，语气满是慈爱",
    "music": "悠扬大气的古风配乐持续",
    "audio_cues": [
      "笑声"
    ],
    "uncertainty": ""
  },
  {
    "id": 26,
    "start": "00:03:20.000",
    "end": "00:03:27.760",
    "text": "招亲大比，现在开始！",
    "speech": "单人发言",
    "emotion": "激昂洪亮",
    "voice": "声音极具穿透力，宣告赛事开启",
    "music": "激昂的赛事开场音乐骤然奏响",
    "audio_cues": [],
    "uncertainty": ""
  }
]