[
  {
    "id": 1,
    "start": "00:00:00.330",
    "end": "00:00:04.199",
    "text": "好，什么南蛮第一人，就这就这。",
    "speech": "单人发言",
    "emotion": "嘲讽",
    "voice": "声音洪亮，语气轻蔑",
    "music": "宏大的古风管弦背景音乐",
    "audio_cues": [
      "笑声"
    ],
    "uncertainty": ""
  },
  {
    "id": 2,
    "start": "00:00:06.800",
    "end": "00:00:09.199",
    "text": "姑姑，这苏宇也太厉害了吧。",
    "speech": "单人发言",
    "emotion": "惊叹",
    "voice": "音调偏高，语气充满惊讶",
    "music": "宏大的古风管弦背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 3,
    "start": "00:00:09.400",
    "end": "00:00:18.199",
    "text": "郑北侯，您藏得够深呐，伪装了个傻儿子，就为今天一鸣惊人，下官佩服。",
    "speech": "单人发言",
    "emotion": "恭维",
    "voice": "嗓音略带沧桑，语气郑重",
    "music": "宏大的古风管弦背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 4,
    "start": "00:00:18.400",
    "end": "00:00:23.200",
    "text": "郑北侯，你发掘了苏宇这样的天才，朕记你一功。",
    "speech": "单人发言",
    "emotion": "满意",
    "voice": "威严庄重，语速沉稳",
    "music": "宏大的古风管弦背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 5,
    "start": "00:00:25.400",
    "end": "00:00:30.399",
    "text": "怎么，下手轻了？",
    "speech": "单人发言",
    "emotion": "戏谑",
    "voice": "语气随意带挑衅",
    "music": "背景音乐转为紧张的战斗风格",
    "audio_cues": [
      "金属碰撞声",
      "脆响",
      "重物落地声"
    ],
    "uncertainty": ""
  },
  {
    "id": 6,
    "start": "00:00:31.400",
    "end": "00:00:34.799",
    "text": "好大的狗胆，居然敢重伤拓跋皇子。",
    "speech": "单人发言",
    "emotion": "暴怒",
    "voice": "音量骤升，语气严厉",
    "music": "紧张的战斗背景音乐持续",
    "audio_cues": [
      "器物碎裂声"
    ],
    "uncertainty": ""
  },
  {
    "id": 7,
    "start": "00:00:34.800",
    "end": "00:00:40.199",
    "text": "比试台上拳脚无眼，你们蛮夷要是输不起，就滚出大炎。",
    "speech": "单人发言",
    "emotion": "强硬",
    "voice": "语气嚣张，充满挑衅",
    "music": "紧张的战斗背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 8,
    "start": "00:00:40.400",
    "end": "00:00:44.199",
    "text": "就这点实力，还敢来我大炎叫嚣，赶紧滚吧。",
    "speech": "单人发言",
    "emotion": "不屑",
    "voice": "语速较快，语气嘲讽",
    "music": "紧张的战斗背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 9,
    "start": "00:00:44.400",
    "end": "00:00:51.199",
    "text": "滚出去，滚出去，滚！滚出去，滚出去，滚出去，滚出去。",
    "speech": "多人齐声呐喊",
    "emotion": "激昂",
    "voice": "声浪整齐洪亮",
    "music": "紧张的战斗背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 10,
    "start": "00:00:51.399",
    "end": "00:00:56.399",
    "text": "输，谁说我们输了，今天要让你知道我的厉害。",
    "speech": "单人发言",
    "emotion": "恼羞成怒",
    "voice": "语气凶狠，充满威胁",
    "music": "紧张的战斗背景音乐持续",
    "audio_cues": [
      "能量涌动的特效声"
    ],
    "uncertainty": ""
  },
  {
    "id": 11,
    "start": "00:01:12.399",
    "end": "00:01:15.399",
    "text": "废物，就这。",
    "speech": "单人发言",
    "emotion": "鄙夷",
    "voice": "语气轻佻",
    "music": "节奏紧凑的战斗背景音乐",
    "audio_cues": [
      "衣物摩擦声"
    ],
    "uncertainty": ""
  },
  {
    "id": 12,
    "start": "00:01:16.400",
    "end": "00:01:18.599",
    "text": "好，不愧是我的儿子。",
    "speech": "单人发言",
    "emotion": "激动自豪",
    "voice": "大声喝彩，语气骄傲",
    "music": "节奏紧凑的战斗背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 13,
    "start": "00:01:18.800",
    "end": "00:01:27.799",
    "text": "你们的人也不经打呀，你们蛮夷要是输不起的话，我劝你们趁早对我大炎俯首称臣。",
    "speech": "单人发言",
    "emotion": "狂妄",
    "voice": "语气张扬，充满压迫感",
    "music": "节奏紧凑的战斗背景音乐持续",
    "audio_cues": [
      "笑声",
      "打斗的破空声",
      "能量冲击声"
    ],
    "uncertainty": ""
  },
  {
    "id": 14,
    "start": "00:01:42.400",
    "end": "00:01:46.599",
    "text": "这么远，刀气还能砍断巨石，着实厉害。",
    "speech": "单人发言",
    "emotion": "震惊",
    "voice": "语气带着难以置信",
    "music": "节奏紧凑的战斗背景音乐持续",
    "audio_cues": [
      "脚步声"
    ],
    "uncertainty": ""
  },
  {
    "id": 15,
    "start": "00:01:47.400",
    "end": "00:01:49.599",
    "text": "杨刀君，你一定要替我报仇。",
    "speech": "单人发言",
    "emotion": "急切",
    "voice": "语气带着哭腔和恳求",
    "music": "节奏紧凑的战斗背景音乐持续",
    "audio_cues": [
      "脚步声"
    ],
    "uncertainty": ""
  },
  {
    "id": 16,
    "start": "00:01:50.200",
    "end": "00:01:53.599",
    "text": "大炎人，你死定了。",
    "speech": "单人发言",
    "emotion": "狠厉",
    "voice": "语气冰冷，充满杀意",
    "music": "节奏紧凑的战斗背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 17,
    "start": "00:01:54.000",
    "end": "00:02:09.599",
    "text": "杨刀君可是西夷妖刀，西夷妖刀，就是斩杀数千骑兵的那个妖刀？据说他三岁练刀，八岁悟道，十五岁打遍西夷无敌手，听说与他交战的人，无一生还。",
    "speech": "多人轮流发言",
    "emotion": "众人接连惊叹",
    "voice": "此起彼伏，语气满是敬畏",
    "music": "节奏紧凑的战斗背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 18,
    "start": "00:02:13.000",
    "end": "00:02:15.199",
    "text": "怕了吧，哈哈哈哈。",
    "speech": "单人发言",
    "emotion": "张狂大笑",
    "voice": "笑声粗犷，得意洋洋",
    "music": "节奏紧凑的战斗背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 19,
    "start": "00:02:15.400",
    "end": "00:02:18.799",
    "text": "西夷人居然这么厉害，苏宇能打过吗？",
    "speech": "单人发言",
    "emotion": "担忧",
    "voice": "语气带着焦虑",
    "music": "节奏紧凑的战斗背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 20,
    "start": "00:02:22.200",
    "end": "00:02:28.199",
    "text": "你的功夫不错，只要愿意做我的属下，我可以饶你一条活命。",
    "speech": "单人发言",
    "emotion": "傲慢",
    "voice": "语气居高临下",
    "music": "节奏紧凑的战斗背景音乐持续",
    "audio_cues": [
      "脚步声"
    ],
    "uncertainty": ""
  },
  {
    "id": 21,
    "start": "00:02:29.000",
    "end": "00:02:32.799",
    "text": "就你，做我的狗都不配。",
    "speech": "单人发言",
    "emotion": "极度轻蔑",
    "voice": "语气冰冷，充满嘲讽",
    "music": "节奏紧凑的战斗背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 22,
    "start": "00:02:36.000",
    "end": "00:02:36.599",
    "text": "找死！",
    "speech": "单人发言",
    "emotion": "暴怒",
    "voice": "大声嘶吼",
    "music": "节奏紧凑的战斗背景音乐持续",
    "audio_cues": [
      "打斗的破空声",
      "能量爆发声"
    ],
    "uncertainty": ""
  },
  {
    "id": 23,
    "start": "00:02:45.399",
    "end": "00:02:50.199",
    "text": "烈焰魔强空斩，去死吧，大炎人！",
    "speech": "单人发言",
    "emotion": "歇斯底里",
    "voice": "运功发力的嘶吼声",
    "music": "节奏紧凑的战斗背景音乐持续",
    "audio_cues": [
      "能量涌动声"
    ],
    "uncertainty": ""
  },
  {
    "id": 24,
    "start": "00:02:50.400",
    "end": "00:03:06.199",
    "text": "宇儿小心！怎么可能？",
    "speech": "单人发言",
    "emotion": "惊呼",
    "voice": "语气从紧张转为难以置信",
    "music": "节奏紧凑的战斗背景音乐持续",
    "audio_cues": [
      "兵器交击声",
      "爆炸声",
      "重物撞击声"
    ],
    "uncertainty": ""
  }
]