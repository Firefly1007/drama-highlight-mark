[
  {
    "id": 1,
    "start": "00:00:00.000",
    "end": "00:00:08.400",
    "text": "大哥，你我如此有缘，又一见如故，不如你我二人结拜为兄弟如何？",
    "speech": "单人发言",
    "emotion": "语气恳切",
    "voice": "语速平稳",
    "music": "以琵琶、古筝等传统民乐为主的轻快诙谐背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 2,
    "start": "00:00:08.400",
    "end": "00:00:22.910",
    "text": "大胆，你大胆，既然如此，那以后你我二人便是兄弟。以后有什么事，尽管找大哥，大哥帮你撑腰。",
    "speech": "单人发言",
    "emotion": "语气豪爽",
    "voice": "音量洪亮",
    "music": "以琵琶、古筝等传统民乐为主的轻快诙谐背景音乐",
    "audio_cues": [
      "笑声"
    ],
    "uncertainty": ""
  },
  {
    "id": 3,
    "start": "00:00:22.970",
    "end": "00:00:35.840",
    "text": "大哥，小弟敬你，但是大哥，你可真能吹，什么事都能摆平？",
    "speech": "单人发言",
    "emotion": "语气轻松随意",
    "voice": "语调带着调侃",
    "music": "以琵琶、古筝等传统民乐为主的轻快诙谐背景音乐",
    "audio_cues": [
      "倒酒声",
      "酒杯放置桌面的声响"
    ],
    "uncertainty": ""
  },
  {
    "id": 4,
    "start": "00:00:36.360",
    "end": "00:00:44.850",
    "text": "就算这天塌了，大哥都能给你撑住，喝酒喝酒喝酒。",
    "speech": "单人发言",
    "emotion": "语气豪迈",
    "voice": "音量洪亮",
    "music": "以琵琶、古筝等传统民乐为主的轻快诙谐背景音乐",
    "audio_cues": [
      "大笑声"
    ],
    "uncertainty": ""
  },
  {
    "id": 5,
    "start": "00:00:47.730",
    "end": "00:00:54.240",
    "text": "好的，好哥哥，我敬你我敬你，满上，满上。",
    "speech": "单人发言",
    "emotion": "语气热络",
    "voice": "语速稍快",
    "music": "以琵琶、古筝等传统民乐为主的轻快诙谐背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 6,
    "start": "00:00:54.300",
    "end": "00:01:01.310",
    "text": "来来来，外面好像有情况，我出去看看，哎呀。",
    "speech": "多人交替发言",
    "emotion": "情绪从警觉转为故作放松",
    "voice": "先压低音量示意，后拖长语调感叹",
    "music": "背景音乐转为低沉紧张",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 7,
    "start": "00:01:03.000",
    "end": "00:01:11.610",
    "text": "清场。",
    "speech": "单人发言",
    "emotion": "威严暴怒",
    "voice": "声音陡然拔高，音量极具穿透力",
    "music": "节奏急促的管弦乐，营造出强烈压迫感",
    "audio_cues": [
      "破风声",
      "脚步声",
      "人群的骚动声"
    ],
    "uncertainty": ""
  },
  {
    "id": 8,
    "start": "00:01:13.170",
    "end": "00:01:20.350",
    "text": "今夜此事，谁敢走漏半点风声，杀无赦！",
    "speech": "单人发言",
    "emotion": "狠厉决绝",
    "voice": "咬字极重，带着不容置疑的命令感",
    "music": "节奏急促的管弦乐，营造出强烈压迫感",
    "audio_cues": [
      "武器出鞘的金属声",
      "脚步声",
      "人群的骚动声"
    ],
    "uncertainty": ""
  },
  {
    "id": 9,
    "start": "00:01:22.720",
    "end": "00:01:24.320",
    "text": "国公爷，您这是？",
    "speech": "单人发言",
    "emotion": "带着迟疑与惊慌",
    "voice": "音色轻柔，语气带着试探",
    "music": "节奏急促的管弦乐，营造出强烈压迫感",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 10,
    "start": "00:01:24.470",
    "end": "00:01:25.430",
    "text": "那逆子呢？",
    "speech": "单人发言",
    "emotion": "怒不可遏",
    "voice": "语气冰冷强硬",
    "music": "节奏急促的管弦乐，营造出强烈压迫感",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 11,
    "start": "00:01:25.720",
    "end": "00:01:27.630",
    "text": "您说的是苏二公子？",
    "speech": "单人发言",
    "emotion": "带着小心翼翼的确认",
    "voice": "音色轻柔",
    "music": "节奏急促的管弦乐，营造出强烈压迫感",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 12,
    "start": "00:01:27.880",
    "end": "00:01:31.770",
    "text": "废话，他此刻在哪，又在干什么勾当？",
    "speech": "单人发言",
    "emotion": "情绪愈发愤怒",
    "voice": "音量持续保持高位",
    "music": "节奏急促的管弦乐，营造出强烈压迫感",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 13,
    "start": "00:01:31.970",
    "end": "00:01:42.350",
    "text": "二公子，和，和新交的大哥，在楼上雅间饮酒作乐，他们一掷千金，出手阔绰，奴家，奴家实在不敢怠慢。",
    "speech": "单人发言",
    "emotion": "紧张得语无伦次",
    "voice": "声音发颤，断断续续",
    "music": "节奏急促的管弦乐，营造出强烈压迫感",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 14,
    "start": "00:01:42.620",
    "end": "00:01:57.930",
    "text": "这一掷千金也就罢了，还跟那些不三不四的人称兄道弟。老爷，连您的严令，宇儿都敢违抗，将来若真的成了驸马，只怕是更加变本加厉，给侯府惹来更大的祸端呀！",
    "speech": "单人发言",
    "emotion": "语气焦虑恳切",
    "voice": "音色温婉，语调急切",
    "music": "节奏急促的管弦乐，营造出强烈压迫感",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 15,
    "start": "00:01:58.330",
    "end": "00:02:04.070",
    "text": "好，好得很，我看这逆子，他是活腻了，让开！",
    "speech": "单人发言",
    "emotion": "暴怒到极点",
    "voice": "声音几乎在咆哮",
    "music": "节奏急促的管弦乐，营造出强烈压迫感",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 16,
    "start": "00:02:11.060",
    "end": "00:02:13.730",
    "text": "这镇北侯府的兵把妓院给围了。",
    "speech": "单人发言",
    "emotion": "语气带着意外",
    "voice": "音量压低",
    "music": "节奏急促的管弦乐，营造出强烈压迫感",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 17,
    "start": "00:02:15.200",
    "end": "00:02:16.710",
    "text": "哎呀，苏老弟啊。",
    "speech": "单人发言",
    "emotion": "语气故作镇定",
    "voice": "带着敷衍的笑意",
    "music": "节奏急促的管弦乐，营造出强烈压迫感",
    "audio_cues": [
      "笑声"
    ],
    "uncertainty": ""
  },
  {
    "id": 18,
    "start": "00:02:16.870",
    "end": "00:02:27.680",
    "text": "哎，哥，你家里来人了，老哥我不方便现身，这些暂且避一避，等你处理完家事，咱们再继续喝啊。",
    "speech": "多人交替发言",
    "emotion": "语气带着急智的圆滑",
    "voice": "语速明显加快",
    "music": "节奏急促的管弦乐，营造出强烈压迫感",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 19,
    "start": "00:02:27.750",
    "end": "00:02:35.440",
    "text": "哎，大哥，哎，你别走啊，咱们接着喝呀！",
    "speech": "单人发言",
    "emotion": "语气挽留",
    "voice": "语调带着醉意的含糊",
    "music": "节奏急促的管弦乐，营造出强烈压迫感",
    "audio_cues": [
      "脚步声"
    ],
    "uncertainty": ""
  },
  {
    "id": 20,
    "start": "00:02:39.090",
    "end": "00:02:39.790",
    "text": "逆子！",
    "speech": "单人发言",
    "emotion": "极度愤怒",
    "voice": "声音以极大音量爆发出来",
    "music": "节奏急促的管弦乐，营造出强烈压迫感",
    "audio_cues": [
      "重击鼓点特效声"
    ],
    "uncertainty": ""
  }
