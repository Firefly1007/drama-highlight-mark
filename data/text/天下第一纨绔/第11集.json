[
  {
    "id": 1,
    "start": "00:00:00.000",
    "end": "00:00:05.700",
    "text": "大炎的废物们，谁先来送死，啊？",
    "speech": "单人发言",
    "emotion": "嚣张狂妄",
    "voice": "声音洪亮，语气挑衅",
    "music": "紧张激烈的战斗风格背景音乐",
    "audio_cues": [
      "脚步声"
    ],
    "uncertainty": ""
  },
  {
    "id": 2,
    "start": "00:00:07.300",
    "end": "00:00:09.500",
    "text": "我来教训你，你不是他对手。",
    "speech": "多人轮流发言",
    "emotion": "先后呈现愤怒与冷静的状态",
    "voice": "前一句激昂，后一句沉稳",
    "music": "紧张激烈的战斗风格背景音乐持续",
    "audio_cues": [
      "破空音效"
    ],
    "uncertainty": ""
  },
  {
    "id": 3,
    "start": "00:00:12.800",
    "end": "00:00:20.000",
    "text": "你懂个屁啊！我这一腿可碎百斤巨石，就他，连我一腿都接不下。",
    "speech": "单人发言",
    "emotion": "傲慢不屑",
    "voice": "语速偏快，语气轻蔑",
    "music": "紧张激烈的战斗风格背景音乐持续",
    "audio_cues": [
      "衣物摩擦声"
    ],
    "uncertainty": ""
  },
  {
    "id": 4,
    "start": "00:00:22.600",
    "end": "00:00:30.000",
    "text": "蛮夷杂碎，竟敢辱我大炎，找死！啊！",
    "speech": "多人轮流发言",
    "emotion": "愤怒暴怒",
    "voice": "前一句声音拔高，后一句为惨叫",
    "music": "紧张激烈的战斗风格背景音乐持续",
    "audio_cues": [
      "打斗声",
      "重击声"
    ],
    "uncertainty": ""
  },
  {
    "id": 5,
    "start": "00:00:31.000",
    "end": "00:00:38.500",
    "text": "加油！加油！不愧是王御史的儿子，打得蛮夷毫无还手之力。",
    "speech": "多人轮流发言",
    "emotion": "激动兴奋",
    "voice": "前两句高声呐喊，后一句语气赞叹",
    "music": "紧张激烈的战斗风格背景音乐持续",
    "audio_cues": [
      "打斗声持续"
    ],
    "uncertainty": ""
  },
  {
    "id": 6,
    "start": "00:00:38.700",
    "end": "00:00:52.000",
    "text": "当然，我儿子可不像某人的儿子，是个废物。嘿，嘿，啊！嗯！",
    "speech": "多人轮流发言",
    "emotion": "先得意后痛苦",
    "voice": "前半段洋洋得意，后半段发出痛苦闷哼",
    "music": "紧张激烈的战斗风格背景音乐持续",
    "audio_cues": [
      "打斗声持续",
      "重击声"
    ],
    "uncertainty": ""
  },
  {
    "id": 7,
    "start": "00:00:53.700",
    "end": "00:01:02.500",
    "text": "吃饭吗？用力点，你这个娘们！什么情况，这蛮夷竟然毫发无伤？",
    "speech": "多人轮流发言",
    "emotion": "先嚣张后震惊",
    "voice": "前半段语气戏谑嚣张，后半段满是难以置信",
    "music": "紧张激烈的战斗风格背景音乐持续",
    "audio_cues": [
      "大笑声"
    ],
    "uncertainty": ""
  },
  {
    "id": 8,
    "start": "00:01:03.100",
    "end": "00:01:09.000",
    "text": "陛下，这蛮子的横练功已经练得刀枪不入了。你找死！",
    "speech": "多人轮流发言",
    "emotion": "先后呈现凝重与暴怒的状态",
    "voice": "前一句低沉凝重，后一句厉声怒吼",
    "music": "紧张激烈的战斗风格背景音乐持续",
    "audio_cues": [
      "破空音效"
    ],
    "uncertainty": ""
  },
  {
    "id": 9,
    "start": "00:01:13.500",
    "end": "00:01:22.000",
    "text": "好大的力量！的人！啊，我的儿！",
    "speech": "多人轮流发言",
    "emotion": "先后呈现震惊与悲痛的状态",
    "voice": "前一句满是震惊，后一句带着哭腔惊呼",
    "music": "紧张激烈的战斗风格背景音乐持续",
    "audio_cues": [
      "打斗声",
      "重物落地声"
    ],
    "uncertainty": ""
  },
  {
    "id": 10,
    "start": "00:01:23.000",
    "end": "00:01:35.500",
    "text": "大炎皇帝，你们朝廷不会都是这种废物吧？啊，不如趁早归降我们算了，啊！哈哈哈哈，我来教训教训你。",
    "speech": "多人轮流发言",
    "emotion": "嚣张狂妄",
    "voice": "语气傲慢，充满嘲讽",
    "music": "紧张激烈的战斗风格背景音乐持续",
    "audio_cues": [
      "大笑声",
      "脚步声"
    ],
    "uncertainty": ""
  },
  {
    "id": 11,
    "start": "00:01:38.200",
    "end": "00:01:45.000",
    "text": "是李兄，他可是咱们当中一等一的高手，有他出马，让他好好看看咱们的实。",
    "speech": "单人发言",
    "emotion": "充满期待",
    "voice": "语气激昂，满是信心",
    "music": "紧张激烈的战斗风格背景音乐持续",
    "audio_cues": [
      "重击音效"
    ],
    "uncertainty": ""
  },
  {
    "id": 12,
    "start": "00:01:49.300",
    "end": "00:02:06.000",
    "text": "哎，一个能打的都没有，你们大炎人，果然都是一群废物！还有谁？怎么，大炎皇帝，你们大炎，难道都是一群缩头乌龟吗？",
    "speech": "单人发言",
    "emotion": "极度轻蔑嚣张",
    "voice": "声音洪亮，语气极具挑衅性",
    "music": "紧张激烈的战斗风格背景音乐持续",
    "audio_cues": [
      "叹气声"
    ],
    "uncertainty": ""
  },
  {
    "id": 13,
    "start": "00:02:11.300",
    "end": "00:02:27.000",
    "text": "他怎么还不上朝？今日，谁若胜这蛮族皇子，赏黄金万两，绫罗千匹，异宝百箱。",
    "speech": "单人发言",
    "emotion": "先焦虑后郑重",
    "voice": "前半句低声自语，后半句高声宣告",
    "music": "紧张激烈的战斗风格背景音乐持续",
    "audio_cues": [
      "金属撞击音效"
    ],
    "uncertainty": ""
  },
  {
    "id": 14,
    "start": "00:02:32.300",
    "end": "00:02:42.000",
    "text": "连李公子都不是一合之敌，我们上去也没用啊！父皇，这就是你最信任的武勋之后，连最基本的血性都没有。",
    "speech": "多人轮流发言",
    "emotion": "先后呈现沮丧与失望的状态",
    "voice": "前一句语气无奈，后一句带着失望的情绪",
    "music": "紧张激烈的战斗风格背景音乐持续",
    "audio_cues": [
      "金属摩擦声"
    ],
    "uncertainty": ""
  },
  {
    "id": 15,
    "start": "00:02:42.500",
    "end": "00:02:51.000",
    "text": "许重力有用吗？就这群废物，加在一起都不是拓跋皇子的对手，大炎皇帝，还是早点投降认输吧！",
    "speech": "单人发言",
    "emotion": "傲慢嘲讽",
    "voice": "语气狂妄，充满优越感",
    "music": "紧张激烈的战斗风格背景音乐持续",
    "audio_cues": [
      "大笑声"
    ],
    "uncertainty": ""
  },
  {
    "id": 16,
    "start": "00:02:51.100",
    "end": "00:03:00.800",
    "text": "哈哈哈哈，都说有什么样的皇帝，就有什么样的子民，你们大炎的子民，个个都是废物，你这个皇帝，也比他们强不了多少。",
    "speech": "多人重叠发言",
    "emotion": "嚣张狂妄",
    "voice": "语气极具嘲讽性",
    "music": "紧张激烈的战斗风格背景音乐持续",
    "audio_cues": [
      "大笑声",
      "金属碎裂音效"
    ],
    "uncertainty": ""
  },
  {
    "id": 17,
    "start": "00:03:04.000",
    "end": "00:03:09.000",
    "text": "万贯家财都不能让你出手，你到底图什么呢？我来！",
    "speech": "多人轮流发言",
    "emotion": "先后呈现疑惑与坚定的状态",
    "voice": "前一句低声疑惑，后一句高声呼喊",
    "music": "紧张激烈的战斗风格背景音乐持续",
    "audio_cues": [
      "脚步声"
    ],
    "uncertainty": ""
  },
  {
    "id": 18,
    "start": "00:03:12.300",
    "end": "00:03:19.500",
    "text": "去吧！别给大炎丢人。放心，爹。武儿，到你表现的时候了。",
    "speech": "多人轮流发言",
    "emotion": "先后呈现嘱托、坚定与期待的状态",
    "voice": "语气沉稳，满是期许",
    "music": "紧张激烈的战斗风格背景音乐持续",
    "audio_cues": [
      "衣物摩擦声"
    ],
    "uncertainty": ""
  },
  {
    "id": 19,
    "start": "00:03:25.200",
    "end": "00:03:28.500",
    "text": "镇北侯府苏明武，请战！",
    "speech": "单人发言",
    "emotion": "坚定激昂",
    "voice": "声音洪亮，语气郑重",
    "music": "紧张激烈的战斗风格背景音乐持续",
    "audio_cues": [
      "重击音效"
    ],
    "uncertainty": ""
  }
]