[
  {
    "id": 1,
    "start": "00:00:00.000",
    "end": "00:00:02.300",
    "text": "那我就再试试。",
    "speech": "单人发言",
    "emotion": "坚定",
    "voice": "语气坚定，语速平稳",
    "music": "节奏紧张的史诗感背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 2,
    "start": "00:00:03.300",
    "end": "00:00:10.800",
    "text": "真是荒唐，你？你大哥都不是对手，你上去干什么，送死吗？",
    "speech": "多人重叠发言",
    "emotion": "嘲讽、质疑",
    "voice": "声音拔高，语气充满嘲讽",
    "music": "节奏紧张的史诗感背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 3,
    "start": "00:00:10.900",
    "end": "00:00:17.400",
    "text": "父皇，苏羽是什么人众人皆知，你让他上场，岂不是令我大炎更加颜面扫地。",
    "speech": "单人发言",
    "emotion": "不满、担忧",
    "voice": "语气带着不满与担忧",
    "music": "节奏紧张的史诗感背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 4,
    "start": "00:00:17.500",
    "end": "00:00:22.000",
    "text": "公主莫急，这苏羽啊，说不定能给我们惊喜呢。",
    "speech": "单人发言",
    "emotion": "从容",
    "voice": "语气沉稳从容",
    "music": "节奏紧张的史诗感背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 5,
    "start": "00:00:23.300",
    "end": "00:00:26.100",
    "text": "他能有什么实力，还惊喜。",
    "speech": "单人发言",
    "emotion": "不屑",
    "voice": "语气充满不屑",
    "music": "节奏紧张的史诗感背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 6,
    "start": "00:00:26.300",
    "end": "00:00:31.500",
    "text": "羽儿，你从小体弱，不通武艺，何必逞能呢？",
    "speech": "单人发言",
    "emotion": "关切、无奈",
    "voice": "语气带着关切与无奈",
    "music": "节奏紧张的史诗感背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 7,
    "start": "00:00:31.600",
    "end": "00:00:32.500",
    "text": "试试呗。",
    "speech": "单人发言",
    "emotion": "轻松",
    "voice": "语气轻松随意",
    "music": "节奏紧张的史诗感背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 8,
    "start": "00:00:34.800",
    "end": "00:00:37.400",
    "text": "你不要命了，赶紧给我回去。",
    "speech": "单人发言",
    "emotion": "焦急、愤怒",
    "voice": "声音拔高，语气焦急愤怒",
    "music": "节奏紧张的史诗感背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 9,
    "start": "00:00:38.000",
    "end": "00:00:41.000",
    "text": "放心吧爹，输不了。",
    "speech": "单人发言",
    "emotion": "自信",
    "voice": "语气笃定自信",
    "music": "节奏紧张的史诗感背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 10,
    "start": "00:00:46.700",
    "end": "00:00:54.200",
    "text": "这不是京城第一纨绔吗？你们大炎是没人了吗？派这种废物上来。",
    "speech": "单人发言",
    "emotion": "嘲讽、傲慢",
    "voice": "语气傲慢，充满嘲讽",
    "music": "节奏紧张的史诗感背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 11,
    "start": "00:00:54.300",
    "end": "00:00:56.400",
    "text": "又是镇北侯的儿子。",
    "speech": "单人发言",
    "emotion": "感慨、无奈",
    "voice": "语气带着感慨与无奈",
    "music": "节奏紧张的史诗感背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 12,
    "start": "00:00:57.100",
    "end": "00:00:58.800",
    "text": "胡闹，给我滚下来。",
    "speech": "单人发言",
    "emotion": "愤怒",
    "voice": "大声呵斥，语气愤怒",
    "music": "节奏紧张的史诗感背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 13,
    "start": "00:00:59.000",
    "end": "00:01:06.000",
    "text": "这苏羽想当官想疯了吧，苏羽，快下来，别给我大炎丢人了。",
    "speech": "多人重叠发言",
    "emotion": "嘲讽、嫌弃",
    "voice": "多人声音混杂，语气满是嘲讽",
    "music": "节奏紧张的史诗感背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 14,
    "start": "00:01:06.100",
    "end": "00:01:14.000",
    "text": "居然又派一个废物上来，你这是看不起我吗？啊，去死吧！",
    "speech": "单人发言",
    "emotion": "暴怒",
    "voice": "暴怒大喊，音量骤升",
    "music": "节奏紧张的史诗感背景音乐持续",
    "audio_cues": [
      "打斗破空声"
    ],
    "uncertainty": ""
  },
  {
    "id": 15,
    "start": "00:01:17.700",
    "end": "00:01:23.700",
    "text": "我把皇子用铁锤了，这个大炎人要被砸成肉泥了。",
    "speech": "单人发言",
    "emotion": "狂妄",
    "voice": "语气狂妄",
    "music": "节奏紧张的史诗感背景音乐持续",
    "audio_cues": [
      "重物挥舞的风声"
    ],
    "uncertainty": ""
  },
  {
    "id": 16,
    "start": "00:01:26.400",
    "end": "00:01:28.700",
    "text": "闪过来，怎么可能？",
    "speech": "单人发言",
    "emotion": "震惊",
    "voice": "语气充满震惊",
    "music": "节奏紧张的史诗感背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 17,
    "start": "00:01:28.800",
    "end": "00:01:35.000",
    "text": "拓跋皇子的速度在南蛮冠绝群雄，从来没有人能躲过，这小子今天运气这么好。",
    "speech": "单人发言",
    "emotion": "难以置信",
    "voice": "语气带着难以置信",
    "music": "节奏紧张的史诗感背景音乐持续",
    "audio_cues": [
      "破空声"
    ],
    "uncertainty": ""
  },
  {
    "id": 18,
    "start": "00:01:43.900",
    "end": "00:01:49.500",
    "text": "你是只老鼠吗？只知道躲，敢不敢接我一招？呀！",
    "speech": "单人发言",
    "emotion": "暴怒",
    "voice": "暴怒大喊",
    "music": "节奏紧张的史诗感背景音乐持续",
    "audio_cues": [
      "打斗撞击声"
    ],
    "uncertainty": ""
  },
  {
    "id": 19,
    "start": "00:01:52.200",
    "end": "00:01:52.700",
    "text": "羽儿！",
    "speech": "单人发言",
    "emotion": "紧张",
    "voice": "大声呼喊，语气紧张",
    "music": "节奏紧张的史诗感背景音乐持续",
    "audio_cues": [
      "剧烈打斗声"
    ],
    "uncertainty": ""
  },
  {
    "id": 20,
    "start": "00:02:03.400",
    "end": "00:02:04.200",
    "text": "好！",
    "speech": "单人发言",
    "emotion": "激动振奋",
    "voice": "大声喝彩，语气激动",
    "music": "节奏紧张的史诗感背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 21,
    "start": "00:02:09.700",
    "end": "00:02:10.500",
    "text": "呀！",
    "speech": "单人发言",
    "emotion": "发力呐喊",
    "voice": "发力呐喊",
    "music": "节奏紧张的史诗感背景音乐持续",
    "audio_cues": [
      "重物落地声",
      "剧烈撞击声"
    ],
    "uncertainty": ""
  },
  {
    "id": 22,
    "start": "00:02:29.300",
    "end": "00:02:32.200",
    "text": "哈哈哈哈哈哈！",
    "speech": "单人发言",
    "emotion": "张狂大笑",
    "voice": "张狂的大笑声",
    "music": "节奏紧张的史诗感背景音乐持续",
    "audio_cues": [
      "脚步声"
    ],
    "uncertainty": ""
  },
  {
    "id": 23,
    "start": "00:02:34.100",
    "end": "00:02:34.700",
    "text": "羽儿！",
    "speech": "单人发言",
    "emotion": "关切呼喊",
    "voice": "轻声呼喊",
    "music": "节奏紧张的史诗感背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  }
]