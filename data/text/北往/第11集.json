[
  {
    "id": 1,
    "start": "00:00:00.000",
    "end": "00:00:08.000",
    "text": "",
    "speech": "",
    "emotion": "",
    "voice": "",
    "music": "轻柔的原声吉他纯音乐响起，营造舒缓的氛围",
    "audio_cues": [
      "轻微的脚步声"
    ],
    "uncertainty": ""
  },
  {
    "id": 2,
    "start": "00:00:08.540",
    "end": "00:00:11.070",
    "text": "你好，需要什么花，我可以给你推荐。",
    "speech": "单人发言",
    "emotion": "语气礼貌亲和",
    "voice": "音色温柔，语速平稳",
    "music": "轻柔的原声吉他纯音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 3,
    "start": "00:00:11.330",
    "end": "00:00:14.740",
    "text": "啊，你稍等一下，我问一下家里人。好。",
    "speech": "双人简短对话",
    "emotion": "略带迟疑",
    "voice": "前半段女声柔和，后半段回应声简短干脆",
    "music": "轻柔的原声吉他纯音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 4,
    "start": "00:00:15.970",
    "end": "00:00:21.120",
    "text": "",
    "speech": "",
    "emotion": "",
    "voice": "",
    "music": "轻柔的原声吉他纯音乐持续",
    "audio_cues": [
      "手机来电铃声响起"
    ],
    "uncertainty": ""
  },
  {
    "id": 5,
    "start": "00:00:22.330",
    "end": "00:00:28.780",
    "text": "喂，靳烁，那个，我想买点鲜花装饰家里，你喜欢什么颜色的花？",
    "speech": "单人打电话发言",
    "emotion": "语气带着试探",
    "voice": "音色清亮，语速稍缓",
    "music": "轻柔的原声吉他纯音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 6,
    "start": "00:00:29.130",
    "end": "00:00:30.930",
    "text": "随便。",
    "speech": "电话另一端的单人回应",
    "emotion": "态度冷淡敷衍",
    "voice": "声音低沉，语速极快",
    "music": "轻柔的原声吉他纯音乐持续",
    "audio_cues": [
      "出现类似按压手机按键的音效"
    ],
    "uncertainty": ""
  },
  {
    "id": 7,
    "start": "00:00:31.310",
    "end": "00:00:35.320",
    "text": "啊，我今天东西可能有点多，你能出来接我不？",
    "speech": "单人打电话发言",
    "emotion": "语气带着期待",
    "voice": "音色柔和，语速放缓",
    "music": "轻柔的原声吉他纯音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 8,
    "start": "00:00:35.430",
    "end": "00:00:36.360",
    "text": "我不出门。",
    "speech": "电话另一端的单人回应",
    "emotion": "态度冷漠",
    "voice": "声音低沉，语气简短",
    "music": "轻柔的原声吉他纯音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 9,
    "start": "00:00:36.530",
    "end": "00:00:39.530",
    "text": "什么？哎！",
    "speech": "单人发言",
    "emotion": "语气充满失落和无奈",
    "voice": "音量稍提高，随后叹气",
    "music": "轻柔的原声吉他纯音乐停止，转为略带诙谐感的钢琴纯音乐",
    "audio_cues": [
      "手机挂断的嘟嘟声"
    ],
    "uncertainty": ""
  },
  {
    "id": 10,
    "start": "00:00:40.030",
    "end": "00:00:48.130",
    "text": "咳，你好，麻烦帮我搭配一些色彩鲜艳的花吧。",
    "speech": "单人发言",
    "emotion": "调整情绪后恢复平和",
    "voice": "轻咳一声后开口，语气恢复礼貌",
    "music": "略带诙谐感的钢琴纯音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 11,
    "start": "00:00:48.160",
    "end": "00:00:49.770",
    "text": "没问题，谢谢。",
    "speech": "双人简短对话",
    "emotion": "语气友好",
    "voice": "前半段回应声干脆，后半段道谢声轻柔",
    "music": "略带诙谐感的钢琴纯音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 12,
    "start": "00:00:52.850",
    "end": "00:00:54.880",
    "text": "哎，请问这个是什么啊？",
    "speech": "单人提问发言",
    "emotion": "语气带着好奇",
    "voice": "音色清亮，语速适中",
    "music": "略带诙谐感的钢琴纯音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 13,
    "start": "00:00:55.120",
    "end": "00:01:03.310",
    "text": "啊，这个呀，是移栽的茉莉，现在不是它的花期，如果能熬过这个冬天，明年五月，它就开了。",
    "speech": "单人解答发言",
    "emotion": "语气耐心温和",
    "voice": "音色温柔，语速平稳",
    "music": "略带诙谐感的钢琴纯音乐停止，转为舒缓的吉他纯音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 14,
    "start": "00:01:04.350",
    "end": "00:01:17.760",
    "text": "好，帮我拿一个吧。",
    "speech": "单人发言",
    "emotion": "语气释然",
    "voice": "音色柔和，语速放缓",
    "music": "舒缓的吉他纯音乐持续",
    "audio_cues": [
      "车辆行驶的环境音逐渐出现"
    ],
    "uncertainty": ""
  },
  {
    "id": 15,
    "start": "00:01:19.770",
    "end": "00:01:22.410",
    "text": "果然没来接我。",
    "speech": "单人自言自语",
    "emotion": "语气带着自嘲的无奈",
    "voice": "轻嗤一声后开口，音量不高",
    "music": "舒缓的吉他纯音乐停止，转为带有节奏感的轻快纯音乐",
    "audio_cues": [
      "车辆行驶的环境音持续"
    ],
    "uncertainty": ""
  },
