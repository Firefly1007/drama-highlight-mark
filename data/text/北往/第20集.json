[
  {
    "id": 1,
    "start": "00:00:01.160",
    "end": "00:00:06.130",
    "text": "无聊，我平常自己在家都做些什么呀？",
    "speech": "单人发言",
    "emotion": "慵懒",
    "voice": "语速平缓，语气随意",
    "music": "轻快诙谐的背景音乐起",
