    ],
    "uncertainty": ""
  },
  {
    "id": 5,
    "start": "00:00:22.100",
    "end": "00:00:24.700",
    "text": "等我回来吃饭，拜拜。",
    "speech": "单人发言",
    "emotion": "轻松",
    "voice": "语气轻快",
    "music": "背景音乐切换为带有钢琴的舒缓温馨旋律",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 6,
    "start": "00:00:33.200",
    "end": "00:00:40.500",
    "text": "对了，少爷，我刚才忘了问少夫人，她第一天上班，晚上单位会不会有聚餐呐？",
    "speech": "单人发言",
    "emotion": "关切",
    "voice": "语气恭敬",
    "music": "舒缓温馨的钢琴背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 7,
    "start": "00:00:41.200",
    "end": "00:00:44.200",
    "text": "哦，她说她会回来吃饭的。",
    "speech": "单人发言",
    "emotion": "平和",
    "voice": "语气沉稳",
    "music": "舒缓温馨的钢琴背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 8,
    "start": "00:00:44.800",
    "end": "00:00:46.800",
    "text": "啊，那您想吃点什么？",
    "speech": "单人发言",
    "emotion": "恭敬",
    "voice": "语气礼貌",
    "music": "舒缓温馨的钢琴背景音乐持续",
