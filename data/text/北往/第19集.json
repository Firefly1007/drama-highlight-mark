  {
    "id": 4,
    "start": "00:00:18.100",
    "end": "00:00:18.700",
    "text": "怎么了？",
    "speech": "单人发言",
    "emotion": "疑惑",
    "voice": "语气轻柔",
    "music": "原声吉他背景音乐持续",
    "audio_cues": [
