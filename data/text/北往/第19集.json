    "text": "糖醋排骨，芥末虾球，还有爆辣火鸡面，谢谢。",
    "speech": "单人发言",
    "emotion": "平和",
    "voice": "语速平缓",
    "music": "舒缓温馨的钢琴背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
