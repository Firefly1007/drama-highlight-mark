[
  {
    "id": 1,
    "start": "00:00:00.300",
    "end": "00:00:03.100",
    "text": "老公，你在等我吗？",
    "speech": "单人发言",
    "emotion": "语气轻快",
    "voice": "语调柔和",
    "music": "轻柔的流行背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 2,
    "start": "00:00:04.000",
    "end": "00:00:07.400",
    "text": "这点东西就叫多，还让人来接你。",
    "speech": "单人发言",
    "emotion": "语气平淡",
    "voice": "语调平稳",
    "music": "轻柔的流行背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 3,
    "start": "00:00:08.400",
    "end": "00:00:22.200",
    "text": "我这是拿一路，手都冻僵了。这个给你，这个是我送给你的，进屋吧，我帮你。",
    "speech": "单人发言",
    "emotion": "带着撒娇的意味",
    "voice": "语速稍快",
    "music": "轻柔的流行背景音乐持续",
    "audio_cues": [
      "包装袋摩擦声"
    ],
    "uncertainty": ""
  },
  {
    "id": 4,
    "start": "00:00:24.100",
    "end": "00:00:25.200",
    "text": "你喜欢花？",
    "speech": "单人发言",
    "emotion": "略带疑惑",
    "voice": "语气平缓",
    "music": "轻柔的流行背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 5,
    "start": "00:00:25.600",
    "end": "00:00:26.100",
    "text": "嗯。",
    "speech": "单人发言",
    "emotion": "语气肯定",
    "voice": "声音清脆",
    "music": "轻柔的流行背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 6,
    "start": "00:00:27.700",
    "end": "00:00:31.100",
    "text": "你的快递，我已经给你放到衣帽间了。",
    "speech": "单人发言",
    "emotion": "语气平和",
    "voice": "语调平稳",
    "music": "轻柔的流行背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 7,
    "start": "00:00:32.600",
    "end": "00:00:35.300",
    "text": "谢谢老公，有你真好。",
    "speech": "单人发言",
    "emotion": "满是幸福感",
    "voice": "语气亲昵",
    "music": "轻柔的流行背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 8,
    "start": "00:00:41.700",
    "end": "00:00:43.600",
    "text": "夸张。",
    "speech": "单人发言",
    "emotion": "带着无奈的笑意",
    "voice": "语气放松",
    "music": "轻柔的流行背景音乐持续",
    "audio_cues": [
      "叹气声"
    ],
    "uncertainty": ""
  },
  {
    "id": 9,
    "start": "00:00:57.700",
    "end": "00:01:02.700",
    "text": "我老公这么年轻，他就这么年轻。",
    "speech": "单人发言",
    "emotion": "情绪开始转向不安",
    "voice": "语速放缓",
    "music": "背景音乐转为低沉压抑",
    "audio_cues": [
      "沉重的呼吸声"
    ],
    "uncertainty": ""
  },
  {
    "id": 10,
    "start": "00:01:03.300",
    "end": "00:01:06.500",
    "text": "没事，以后奶奶照顾你。",
    "speech": "单人发言",
    "emotion": "语气带着刻意的安抚感",
    "voice": "语调略显僵硬",
    "music": "低沉压抑的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 11,
    "start": "00:01:06.900",
    "end": "00:01:12.500",
    "text": "不就是站不起来了吗？金叔，看看你现在什么样子，你知道奶奶为你做了多少？",
    "speech": "单人发言",
    "emotion": "情绪激动",
    "voice": "音量拔高",
    "music": "低沉压抑的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 12,
    "start": "00:01:12.600",
    "end": "00:01:15.800",
    "text": "金叔，你现在的样子，我根本看不到。",
    "speech": "单人发言",
    "emotion": "带着绝望感",
    "voice": "声音颤抖",
    "music": "低沉压抑的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 13,
    "start": "00:01:15.900",
    "end": "00:01:20.000",
    "text": "看看你现在什么样子，以后奶奶照顾你。",
    "speech": "多人重叠发言",
    "emotion": "情绪激烈",
    "voice": "多人声音交织",
    "music": "背景音乐变得更加紧张急促",
    "audio_cues": [
      "急促的喘息声"
    ],
    "uncertainty": "多人声音重叠，部分台词细节难以完全分辨"
  },
  {
    "id": 14,
    "start": "00:01:24.300",
    "end": "00:01:46.000",
    "text": "老公，老公，醒醒，我有事情要你帮忙。喂，老公，老公，醒醒，醒醒，老公，醒醒，醒醒，老公，醒醒，醒醒，醒醒，老公，醒醒，醒醒。",
    "speech": "单人持续呼喊",
    "emotion": "极度恐慌焦急",
    "voice": "语速急促，音量反复拔高",
    "music": "紧张的背景音乐达到高潮后短暂留白",
    "audio_cues": [
      "衣服摩擦声"
    ],
    "uncertainty": ""
  },
  {
    "id": 15,
    "start": "00:01:46.500",
    "end": "00:01:47.200",
    "text": "老公。",
    "speech": "单人发言",
    "emotion": "带着哭腔的急切",
    "voice": "声音带着颤抖",
    "music": "音乐短暂停顿",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 16,
    "start": "00:01:48.300",
    "end": "00:01:49.300",
    "text": "老公。",
    "speech": "单人发言",
    "emotion": "急切的呼唤",
    "voice": "语气稍缓但仍带着不安",
    "music": "钢琴旋律响起",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 17,
    "start": "00:01:50.700",
    "end": "00:02:00.000",
    "text": "嘿，我需要你的帮忙，谢谢老公，老公，我真的很需要你，有你在真好。",
    "speech": "单人发言",
    "emotion": "情绪逐渐平复",
    "voice": "语调重新变得柔和",
    "music": "悠扬的弦乐搭配钢琴的背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 18,
    "start": "00:02:04.300",
    "end": "00:02:10.000",
    "text": "老公，嘿，老公你醒了。",
    "speech": "单人发言",
    "emotion": "满是惊喜",
    "voice": "语气轻快起来",
    "music": "悠扬的背景音乐持续至音频结束",
    "audio_cues": [],
    "uncertainty": ""
  }
