[
  {
    "id": 1,
    "start": "00:00:00.310",
    "end": "00:00:06.080",
    "text": "原来她这么优秀啊，在国外有这么好的工作机会，为什么突然回国？",
    "speech": "单人发言",
    "emotion": "疑惑",
    "voice": "语速平缓",
    "music": "",
    "audio_cues": [
      "轻微的呼吸声"
