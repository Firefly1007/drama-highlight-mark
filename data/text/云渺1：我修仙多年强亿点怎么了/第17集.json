    "uncertainty": ""
  },
  {
    "id": 2,
    "start": "00:00:04.600",
    "end": "00:00:05.800",
    "text": "大哥。",
    "speech": "单人发言",
    "emotion": "",
    "voice": "声音轻柔",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 3,
    "start": "00:00:05.800",
    "end": "00:00:06.400",
    "text": "嗯。",
    "speech": "单人发言",
    "emotion": "",
    "voice": "低声回应",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 4,
    "start": "00:00:11.700",
    "end": "00:00:22.200",
    "text": "我最近确实总是梦见外婆，身上裹着红绳，穿插在一起一直在挣扎。不行，我得告诉爸。",
    "speech": "单人发言",
    "emotion": "情绪激动，语气急切",
    "voice": "语速加快，情绪起伏明显",
    "music": "紧张悬疑的背景音乐",
    "audio_cues": [
      "脚步声"
    ],
    "uncertainty": ""
  },
  {
    "id": 5,
    "start": "00:00:27.400",
    "end": "00:00:32.200",
    "text": "我最近总是梦见母亲，每次都看见她在受。",
    "speech": "单人发言",
    "emotion": "悲伤",
    "voice": "声音带着哭腔，语速缓慢",
    "music": "转为忧伤的钢琴背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 6,
    "start": "00:00:34.100",
    "end": "00:00:42.500",
    "text": "咱妈是安安心心走的，那在天之灵也只会享福，怎么可能受苦呢？沈先生您说是不是？",
    "speech": "单人发言",
    "emotion": "试图安抚",
    "voice": "语气刻意放平缓，带有劝慰的意味",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 7,
    "start": "00:00:44.000",
    "end": "00:00:44.800",
    "text": "当然。",
    "speech": "单人发言",
    "emotion": "平静",
    "voice": "语气沉稳",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 8,
    "start": "00:00:45.900",
    "end": "00:00:57.700",
    "text": "听到了吧，咱妈和你们家老爷子那不一样，咱妈生前不肯走，那不是因为有什么执念，而是因为舍不得我们这些小辈，是不是？",
    "speech": "单人发言",
    "emotion": "循循善诱",
    "voice": "语速适中，带有开导的口吻",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 9,
    "start": "00:00:59.800",
    "end": "00:01:09.200",
    "text": "可能是最近发生的事情太多了，才总是做这样的梦。我希望母亲在九泉之下，安适。",
    "speech": "单人发言",
    "emotion": "略带释然",
    "voice": "声音轻柔，带着一丝叹息",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 10,
    "start": "00:01:09.500",
    "end": "00:01:13.800",
    "text": "有你这样愚蠢的女儿，她应该是安适不了。",
    "speech": "单人发言",
    "emotion": "嘲讽",
    "voice": "语气尖锐，带着明显的挑衅感",
    "music": "紧张感骤升的背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  }
]