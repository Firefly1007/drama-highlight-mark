[
  {
    "id": 1,
    "start": "00:00:04.760",
    "end": "00:00:06.830",
    "text": "小姐，我们家大爷来了。",
    "speech": "单人发言",
    "emotion": "略带紧张",
    "voice": "压低声音，语速偏快",
    "music": "轻柔的钢琴背景音乐",
    "audio_cues": [
      "虫鸣背景音"
    ],
    "uncertainty": ""
  },
  {
    "id": 2,
    "start": "00:00:09.310",
    "end": "00:00:12.340",
    "text": "怎么回事，我竟有些瘆得慌。",
    "speech": "单人发言",
    "emotion": "不安发慌",
    "voice": "语气带着疑惑和发慌",
    "music": "轻柔的钢琴背景音乐持续",
    "audio_cues": [
      "虫鸣背景音"
    ],
    "uncertainty": ""
  },
  {
    "id": 3,
    "start": "00:00:14.040",
    "end": "00:00:17.710",
    "text": "你就是周家现在的当家人？",
    "speech": "单人发言",
    "emotion": "冷静从容",
    "voice": "语气平稳，音量适中",
    "music": "背景音乐转为悬疑风格",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 4,
    "start": "00:00:18.340",
    "end": "00:00:22.290",
    "text": "啊，我是，你是？",
    "speech": "单人发言",
    "emotion": "疑惑",
    "voice": "语气带着迟疑和询问",
    "music": "悬疑风格背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 5,
    "start": "00:00:22.950",
    "end": "00:00:23.910",
    "text": "云鸟。",
    "speech": "单人发言",
    "emotion": "淡然",
    "voice": "语速平缓",
    "music": "悬疑风格背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 6,
    "start": "00:00:24.280",
    "end": "00:00:28.360",
    "text": "云小姐，想必今日来是有什么事情。",
    "speech": "单人发言",
    "emotion": "客套试探",
    "voice": "语气客气，带着询问意味",
    "music": "悬疑风格背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 7,
    "start": "00:00:28.660",
    "end": "00:00:30.490",
    "text": "我以为管家应该都告诉你了。",
    "speech": "单人发言",
    "emotion": "略带不满",
    "voice": "语气平淡中带着一丝不耐烦",
    "music": "悬疑风格背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 8,
    "start": "00:00:31.080",
    "end": "00:00:32.140",
    "text": "这事给我说。",
    "speech": "单人发言",
    "emotion": "略带尴尬",
    "voice": "语气略显局促",
    "music": "悬疑风格背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 9,
    "start": "00:00:32.930",
    "end": "00:00:39.110",
    "text": "那你还有闲空与我东扯西扯，看来你也不关心周苍山。",
    "speech": "单人发言",
    "emotion": "语气带着指责",
    "voice": "语速稍快，音量提高",
    "music": "悬疑风格背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 10,
    "start": "00:00:39.530",
    "end": "00:00:43.850",
    "text": "住嘴，你小小年纪也敢直呼我父亲的名讳。",
    "speech": "单人发言",
    "emotion": "愤怒",
    "voice": "声音拔高，语气严厉",
    "music": "悬疑风格背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 11,
    "start": "00:00:47.720",
    "end": "00:00:56.030",
    "text": "人之将死，最后一口气如万箭穿心，你在这与我多耽误一秒，他就会多受折磨一秒。",
    "speech": "单人发言",
    "emotion": "冷静严肃",
    "voice": "语速平稳，语气郑重",
    "music": "悬疑风格背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 12,
    "start": "00:00:56.740",
    "end": "00:01:12.190",
    "text": "我知道，云小姐，不是我不信任你，我家请那大师，大师说我父亲心中想见的人是解放前的人，可是你这个年纪。",
    "speech": "单人发言",
    "emotion": "纠结迟疑",
    "voice": "语气带着困惑和犹豫",
    "music": "悬疑风格背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 13,
    "start": "00:01:12.660",
    "end": "00:01:14.470",
    "text": "哎云小姐，您去哪啊？",
    "speech": "单人发言",
    "emotion": "慌张",
    "voice": "语气急切，带着询问",
    "music": "悬疑风格背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 14,
    "start": "00:01:15.020",
    "end": "00:01:25.140",
    "text": "我不和蠢货打交道，周苍山生了个蠢货，也是他的因果，就让他最后吊着一口气。",
    "speech": "单人发言",
    "emotion": "冷漠",
    "voice": "语气淡然，不带情绪",
    "music": "悬疑风格背景音乐持续",
    "audio_cues": [],
    "uncertainty": "最后部分台词听不清"
  }
]