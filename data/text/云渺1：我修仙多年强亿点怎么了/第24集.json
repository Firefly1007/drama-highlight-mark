    "emotion": "态度恭敬",
    "voice": "语调平稳",
    "music": "低沉悬疑的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 5,
    "start": "00:00:33.700",
    "end": "00:00:41.500",
    "text": "云小姐，我就先回去了，抱歉，今天打扰你了。",
    "speech": "单人发言",
    "emotion": "情绪低落",
    "voice": "声音带着疲惫和沙哑",
    "music": "低沉悬疑的背景音乐持续",
    "audio_cues": [
