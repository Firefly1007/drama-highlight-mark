    "speech": "单人发言",
    "emotion": "语气平静",
    "voice": "语速放缓",
    "music": "低沉悬疑的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 4,
    "start": "00:00:25.800",
    "end": "00:00:28.900",
    "text": "大夫人，云小姐要休息了。",
