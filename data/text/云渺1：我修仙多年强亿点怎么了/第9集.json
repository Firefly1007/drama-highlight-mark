[
  {
    "id": 1,
    "start": "00:00:00.340",
    "end": "00:00:06.300",
    "text": "老奴周苍山见过小姐。",
    "speech": "单人发言",
    "emotion": "声音颤抖，情绪激动",
    "voice": "嗓音苍老，语气郑重",
    "music": "伴随缓慢沉重的弦乐背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 2,
    "start": "00:00:08.100",
    "end": "00:00:17.070",
    "text": "什么奴？什么小姐？难道老爷子是回光返照，糊涂了？",
    "speech": "单人发言",
    "emotion": "疑惑不解",
    "voice": "语气带着错愕与困惑",
    "music": "背景音乐持续，加入轻微悬疑音效",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 3,
    "start": "00:00:17.400",
    "end": "00:00:27.410",
    "text": "豆芽，执念已了，去吧。",
    "speech": "单人发言",
    "emotion": "语气淡然平和",
    "voice": "语调平缓轻柔",
    "music": "舒缓的弦乐旋律延续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 4,
    "start": "00:00:27.760",
    "end": "00:00:30.770",
    "text": "多谢小姐。",
    "speech": "单人发言",
    "emotion": "情绪激动，带着哭腔",
    "voice": "声音哽咽颤抖",
    "music": "背景音乐短暂停顿后继续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 5,
    "start": "00:00:36.960",
    "end": "00:00:43.470",
    "text": "走了？就这样轻飘飘的来，又轻飘飘的走了？",
    "speech": "单人发言",
    "emotion": "错愕茫然",
    "voice": "语气带着难以置信的空洞感",
    "music": "弦乐旋律持续铺底",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 6,
    "start": "00:00:44.620",
    "end": "00:01:01.210",
    "text": "啊，爸，爸，您交代。",
    "speech": "单人发言",
    "emotion": "焦急慌乱",
    "voice": "语速急促，带着喘息",
    "music": "背景音乐保持低沉厚重",
    "audio_cues": [
      "急促的脚步声",
      "衣物摩擦声"
    ],
    "uncertainty": ""
  },
  {
    "id": 7,
    "start": "00:01:07.140",
    "end": "00:01:15.070",
    "text": "爸，这枚扳指从我记事起，一直在您手上，从未摘下，您。",
    "speech": "单人发言",
    "emotion": "语气郑重，带着感慨",
    "voice": "嗓音略带沙哑，语速放缓",
    "music": "背景音乐加入轻微的鼓点音效增强厚重感",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 8,
    "start": "00:01:15.410",
    "end": "00:01:24.620",
    "text": "我说过，只有你能真正继承我身份的时候，才有资格得到这枚扳指。",
    "speech": "单人发言",
    "emotion": "严肃郑重",
    "voice": "语气坚定有力",
    "music": "背景音乐的弦乐声部增强",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 9,
    "start": "00:01:25.910",
    "end": "00:01:56.200",
    "text": "爸，几十年了，我事事追求完美，我一直没有资格拿到这枚扳指，我以为我这辈子都得不到您的认可了，没想到，爸，我发誓，我一定将咱周家的产业发扬光大，再创。",
    "speech": "单人发言",
    "emotion": "情绪激动，带着哭腔与坚定的决心",
    "voice": "声音颤抖哽咽，语速起伏明显",
    "music": "背景音乐推向情感高潮",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 10,
    "start": "00:01:58.010",
    "end": "00:02:15.670",
    "text": "跟家族无关，周苍山自小就是小姐的奴，现在轮到你了，啊？",
    "speech": "单人发言",
    "emotion": "语气沉重决绝",
    "voice": "嗓音苍老，带着不容置疑的力量感",
    "music": "背景音乐逐渐减弱收尾",
    "audio_cues": [],
    "uncertainty": ""
  }
]