    "uncertainty": ""
  },
  {
    "id": 7,
    "start": "00:01:54.177",
    "end": "00:02:00.408",
    "text": "久病卧床，没有异味，看来豆芽的后代，还算孝顺。",
    "speech": "单人发言",
    "emotion": "语气平淡，带着一丝审视",
