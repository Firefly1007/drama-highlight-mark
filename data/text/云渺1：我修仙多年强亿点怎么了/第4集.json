[
  {
    "id": 1,
    "start": "00:00:00.100",
    "end": "00:00:03.400",
    "text": "云小姐留步，你说话怎么这么难听呢？",
    "speech": "单人发言",
    "emotion": "略带不满",
    "voice": "语气直接，音量偏高",
    "music": "",
    "audio_cues": [
      "背景有轻微环境底噪"
    ],
    "uncertainty": ""
  },
  {
    "id": 2,
    "start": "00:00:03.500",
    "end": "00:00:10.000",
    "text": "老爷心念之人是他的同龄人，说不定这位姑娘是他心心念念之人的后人呢。",
    "speech": "单人发言",
    "emotion": "恳切劝说",
    "voice": "语速平缓，语气恭敬",
    "music": "",
    "audio_cues": [
      "背景有轻微环境底噪"
    ],
    "uncertainty": ""
  },
  {
    "id": 3,
    "start": "00:00:11.800",
    "end": "00:00:19.500",
    "text": "是呀，我这是一叶障目，无论真与假，要见了才知道呀。",
    "speech": "单人发言",
    "emotion": "恍然大悟",
    "voice": "语气从迟疑转为坚定",
    "music": "",
    "audio_cues": [
      "背景有鸟叫声"
    ],
    "uncertainty": ""
  },
  {
    "id": 4,
    "start": "00:00:19.600",
    "end": "00:00:23.000",
    "text": "是啊，云小姐，请留步。",
    "speech": "单人发言",
    "emotion": "急切",
    "voice": "音量提高，带有呼喊感",
    "music": "轻柔的钢琴背景音乐渐入",
    "audio_cues": [
      "背景有鸟叫声"
    ],
    "uncertainty": ""
  },
  {
    "id": 5,
    "start": "00:00:26.200",
    "end": "00:00:36.300",
    "text": "对不起，云小姐，我也是关心则乱，你就看在我一片孝心的份上，一同和我见见我的父亲吧。",
    "speech": "单人发言",
    "emotion": "诚恳致歉",
    "voice": "语气放软，带着恳求意味",
    "music": "轻柔的钢琴背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 6,
    "start": "00:00:37.300",
    "end": "00:00:50.700",
    "text": "这女孩年纪轻轻脾气怎么这么大，她不知道我们周家在江城的地位吗？算了，为了父亲低声下气一回又如何。",
    "speech": "单人发言",
    "emotion": "内心纠结后释然",
    "voice": "低声自语，语气从抱怨转为隐忍",
    "music": "轻柔的钢琴背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 7,
    "start": "00:00:51.200",
    "end": "00:00:55.500",
    "text": "罢了，毕竟跟过我，也算有个善终。",
    "speech": "单人发言",
    "emotion": "淡然",
    "voice": "语气平静，语速平缓",
    "music": "轻柔的钢琴背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 8,
    "start": "00:00:57.800",
    "end": "00:01:02.500",
    "text": "跟过，云小姐请。",
    "speech": "单人发言",
    "emotion": "略带疑惑后转为客气",
    "voice": "先迟疑停顿，随后做出邀请手势的语气",
    "music": "轻柔的钢琴背景音乐持续",
    "audio_cues": [
      "清脆的类似风铃的特效音",
      "脚步声"
    ],
    "uncertainty": ""
  },
  {
    "id": 9,
    "start": "00:01:07.700",
    "end": "00:01:13.200",
    "text": "这姑娘身段倒是挺好，走起路来似仙飘渺。",
    "speech": "多人重叠",
    "emotion": "带着好奇的赞叹",
    "voice": "低声议论，语气轻柔",
    "music": "转为悬疑感的弦乐背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 10,
    "start": "00:01:13.400",
    "end": "00:01:28.500",
    "text": "她可真白呀，比她戴的那珍珠都白呢，哎大嫂，这就是那心上人的后人吧？这后人都这么漂亮，难怪老爷子心心念念了七十多年。",
    "speech": "多人重叠",
    "emotion": "充满好奇与惊叹",
    "voice": "低声交头接耳，语气带着八卦感",
    "music": "悬疑感的弦乐背景音乐持续推进",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 11,
    "start": "00:01:28.700",
    "end": "00:01:30.500",
    "text": "云小姐，请。",
    "speech": "单人发言",
    "emotion": "客气有礼",
    "voice": "语气正式，做出邀请姿态",
    "music": "悬疑感的弦乐背景音乐持续增强",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 12,
    "start": "00:01:38.900",
    "end": "00:01:40.000",
    "text": "站住！",
    "speech": "单人发言",
    "emotion": "威严呵斥",
    "voice": "音量陡然提高，语气严厉",
    "music": "音乐骤停，随后响起低沉的重音打击音效",
    "audio_cues": [],
    "uncertainty": ""
  }
]