[
  {
    "id": 1,
    "start": "00:00:01.820",
    "end": "00:00:13.060",
    "text": "你别说了，这不可能，要是像你这样说，那我岂不是残害了母亲。",
    "speech": "单人发言",
    "emotion": "情绪崩溃，带着强烈哭腔与绝望感",
    "voice": "声音颤抖，伴随明显的抽泣声",
    "music": "",
    "audio_cues": [
