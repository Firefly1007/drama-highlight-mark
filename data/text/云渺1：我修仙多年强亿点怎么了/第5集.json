[
  {
    "id": 1,
    "start": "00:00:00.000",
    "end": "00:00:04.950",
    "text": "站住，老大，你也不介绍一下。",
    "speech": "单人发言",
    "emotion": "语气强硬",
    "voice": "声音低沉有力",
    "music": "低沉悬疑的背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 2,
    "start": "00:00:05.000",
    "end": "00:00:10.070",
    "text": "啊，啊，妈，这位，这位是云小姐。",
    "speech": "单人发言",
    "emotion": "语气局促",
    "voice": "略带结巴",
    "music": "低沉悬疑的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 3,
    "start": "00:00:10.500",
    "end": "00:00:25.260",
    "text": "哦，哈哈，原来姓云呐，果真是个好姓，不像你妈我，跟了你爸这么多年，连个姓都没有。",
    "speech": "单人发言",
    "emotion": "情绪中带着嘲讽与不满",
    "voice": "语速放缓，语气带着沧桑感",
    "music": "低沉悬疑的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 4,
    "start": "00:00:25.300",
    "end": "00:00:30.130",
    "text": "豆芽的妻子，倒是比他年轻不少。",
    "speech": "单人发言",
    "emotion": "语气平淡",
    "voice": "声音清冷",
    "music": "低沉悬疑的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 5,
    "start": "00:00:30.500",
    "end": "00:00:48.070",
    "text": "哎，妈，妈，现在万事以大局为主，我爸那口气一直不咽，受痛苦折磨，我们这些做小辈的，日夜揪心呐。",
    "speech": "单人发言",
    "emotion": "语气带着假意的恳切",
    "voice": "刻意放低姿态",
    "music": "低沉悬疑的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 6,
    "start": "00:00:48.200",
    "end": "00:00:53.330",
    "text": "哼哼，他痛不痛苦，关我屁事。",
    "speech": "单人发言",
    "emotion": "情绪带着不屑与怨愤",
    "voice": "语气狠厉",
    "music": "低沉悬疑的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 7,
    "start": "00:00:53.400",
    "end": "00:01:05.790",
    "text": "哎呦，妈，我知道您心里委屈，但是您就算是为了我，行吗，我总不能看着我爸死不瞑目吧。",
    "speech": "单人发言",
    "emotion": "语气带着哀求",
    "voice": "语调起伏明显",
    "music": "低沉悬疑的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 8,
    "start": "00:01:09.200",
    "end": "00:01:32.000",
    "text": "这下，他可瞑目了，哎，是个狐媚子，难怪死了还这么惦记着，进去吧，早去早死。",
    "speech": "单人发言",
    "emotion": "情绪满是怨恨",
    "voice": "语气带着咬牙切齿的恨意",
    "music": "低沉悬疑的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 9,
    "start": "00:01:32.200",
    "end": "00:01:36.530",
    "text": "哎，云小姐，请多包涵，请。",
    "speech": "单人发言",
    "emotion": "语气带着客套",
    "voice": "声音略显尴尬",
    "music": "低沉悬疑的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 10,
    "start": "00:01:40.500",
    "end": "00:01:41.740",
    "text": "这黑气。",
    "speech": "单人发言",
    "emotion": "语气带着疑惑",
    "voice": "声音清冷",
    "music": "背景音乐出现空灵的音效变化",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 11,
    "start": "00:01:53.300",
    "end": "00:01:57.700",
    "text": "你，节哀吧。",
    "speech": "单人发言",
    "emotion": "语气平淡",
    "voice": "声音清冷",
    "music": "背景音乐转为激昂",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 12,
    "start": "00:02:01.700",
    "end": "00:02:32.400",
    "text": "好啊，好，周苍生，你这一辈子对我冷心冷情也便罢了，临了，让我成为最大的笑话，甚至你那心心念念女人的后代，也敢怜悯我，当真是奇耻大辱。",
    "speech": "单人发言",
    "emotion": "情绪彻底爆发，满是悲愤与绝望",
    "voice": "声音带着哭腔与嘶吼，音量拔高",
    "music": "激昂的背景音乐推向高潮后戛然而止",
    "audio_cues": [],
    "uncertainty": ""
  }
]