    "speech": "单人发言",
    "emotion": "淡然平静",
    "voice": "语气平淡",
    "music": "钢琴与弦乐融合的温情背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 11,
    "start": "00:01:21.607",
