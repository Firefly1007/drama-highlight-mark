[
  {
    "id": 1,
    "start": "00:00:00.000",
    "end": "00:00:01.500",
    "text": "你在跟谁打电话？",
    "speech": "单人发言",
    "emotion": "",
    "voice": "语速适中，语气平稳",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 2,
    "start": "00:00:02.350",
    "end": "00:00:05.199",
    "text": "客户，最近客户电话太多了。",
    "speech": "单人发言",
    "emotion": "",
    "voice": "语速偏快，语气略带疲惫",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 3,
    "start": "00:00:10.410",
    "end": "00:00:18.180",
    "text": "辛苦了，我看桌上饭菜没动，你是吃过晚饭了吗？",
    "speech": "单人发言",
    "emotion": "",
    "voice": "语速平缓，语气温柔",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 4,
    "start": "00:00:19.540",
    "end": "00:00:21.959",
    "text": "在外面吃了，吃挺饱的。",
    "speech": "单人发言",
    "emotion": "",
    "voice": "语气平淡",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 5,
    "start": "00:00:23.419",
    "end": "00:00:23.939",
    "text": "好。",
    "speech": "单人发言",
    "emotion": "",
    "voice": "声音轻柔",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 6,
    "start": "00:00:25.719",
    "end": "00:00:26.480",
    "text": "先洗澡。",
    "speech": "单人发言",
    "emotion": "",
    "voice": "语气平静",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 7,
    "start": "00:00:39.330",
    "end": "00:00:44.500",
    "text": "哎哎哎，房租什么时候来交啊？再不交就从这搬出去。",
    "speech": "单人发言",
    "emotion": "情绪激动",
    "voice": "声音拔高，语气尖锐急促",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 8,
    "start": "00:00:45.420",
    "end": "00:00:46.160",
    "text": "我尽快。",
    "speech": "单人发言",
    "emotion": "",
    "voice": "语速偏快，语气隐忍",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 9,
    "start": "00:00:47.500",
    "end": "00:00:50.120",
    "text": "赶紧的，穷鬼。",
    "speech": "单人发言",
    "emotion": "情绪不耐烦",
    "voice": "语气刻薄",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 10,
    "start": "00:00:59.840",
    "end": "00:01:07.060",
    "text": "老子一定会出人头地，小姑娘，到时候哥来娶你。",
    "speech": "单人发言",
    "emotion": "情绪激昂",
    "voice": "语速有力，语气坚定",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 11,
    "start": "00:01:18.719",
    "end": "00:01:19.179",
    "text": "妈。",
    "speech": "单人发言",
    "emotion": "",
    "voice": "声音低沉",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 12,
    "start": "00:01:19.740",
    "end": "00:01:27.380",
    "text": "子云啊，既然现在回国了，婚事也该提上日程了，今年能结上吗？我还着急抱孙子呢。",
    "speech": "单人发言",
    "emotion": "",
    "voice": "语气带着期盼",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  }
