    "id": 14,
    "start": "00:01:54.040",
    "end": "00:01:55.160",
    "text": "我为什么要来找你？",
    "speech": "单人发言",
    "emotion": "带着反问的抵触情绪",
    "voice": "语速平缓",
    "music": "轻柔的钢琴背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 15,
    "start": "00:01:59.620",
