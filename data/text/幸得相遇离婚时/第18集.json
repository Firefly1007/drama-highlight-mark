    "emotion": "语气认真",
    "voice": "语速平缓",
    "music": "轻柔的钢琴背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 12,
    "start": "00:01:40.630",
    "end": "00:01:45.670",
    "text": "江先生回来了，您还是第一次带姑娘回家呢。",
