    "music": "轻柔的钢琴背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 3,
    "start": "00:00:19.040",
    "end": "00:00:24.080",
    "text": "你应该挺有钱的呀，你什么样的女人没有，你到底要干什么？",
    "speech": "单人发言",
    "emotion": "情绪激动，带着不解",
    "voice": "语速稍快，音量提高",
    "music": "轻柔的钢琴背景音乐持续",
