    ],
    "uncertainty": ""
  },
  {
    "id": 2,
    "start": "00:00:13.080",
    "end": "00:00:16.830",
    "text": "你是谁？为什么挽着我老公？",
    "speech": "单人发言",
    "emotion": "带着疑惑与惊慌",
    "voice": "声音略带颤抖",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 3,
    "start": "00:00:17.390",
    "end": "00:00:24.480",
    "text": "你老公？你出轨了？",
    "speech": "多人轮流发言",
    "emotion": "情绪从意外转向震惊",
    "voice": "先以反问语气开口，后声音拔高",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 4,
    "start": "00:00:25.330",
    "end": "00:00:25.870",
    "text": "是。",
    "speech": "单人发言",
    "emotion": "态度冷漠",
    "voice": "语气简短而直接",
    "music": "低沉紧张的弦乐背景音乐渐起",
    "audio_cues": [
      "衣物摩擦声"
    ],
    "uncertainty": ""
  },
  {
    "id": 5,
    "start": "00:00:28.780",
    "end": "00:00:39.140",
    "text": "老公，送我去医院。",
    "speech": "单人发言",
    "emotion": "痛苦又急切",
    "voice": "声音虚弱颤抖",
    "music": "",
    "audio_cues": [
      "女性痛苦的喘息声",
      "沉重的撞击声"
    ],
    "uncertainty": ""
  },
  {
    "id": 6,
    "start": "00:00:39.800",
    "end": "00:00:44.830",
    "text": "不要，不止是孩子。",
    "speech": "单人发言",
    "emotion": "态度冷酷",
    "voice": "语气平淡不带情绪",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 7,
    "start": "00:00:54.320",
    "end": "00:01:00.050",
    "text": "所以我肚子疼，不是偶然。",
    "speech": "单人发言",
    "emotion": "从茫然转向恍然大悟",
    "voice": "语速缓慢，带着难以置信的质感",
    "music": "背景音乐的音量与层次感逐渐增强",
    "audio_cues": [
      "两声带有科幻感的转场音效"
    ],
    "uncertainty": ""
  },
  {
    "id": 8,
    "start": "00:01:07.770",
    "end": "00:01:12.210",
    "text": "你们，简直下贱！",
    "speech": "单人发言",
    "emotion": "情绪崩溃，满是愤怒",
    "voice": "声音带着哭腔与嘶哑",
    "music": "",
    "audio_cues": [
      "物体被推倒的撞击声"
    ],
    "uncertainty": ""
  },
  {
    "id": 9,
    "start": "00:01:17.640",
    "end": "00:01:28.250",
    "text": "唐颖，当初跟你结婚，是我一时昏了头。你什么条件你应该清楚，现在的你，已经配不上如今的我了。",
    "speech": "单人发言",
    "emotion": "语气傲慢且绝情",
    "voice": "语速平稳，带着居高临下的态度",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 10,
    "start": "00:01:30.330",
    "end": "00:01:41.920",
    "text": "结婚前我有工作，我有人追，我为了照顾你，我朝九晚五的工作都辞了，你现在觉得我拿不出手了？",
    "speech": "单人发言",
    "emotion": "满是委屈与悲愤",
    "voice": "声音带着明显的哭腔，情绪激动",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 11,
    "start": "00:01:42.840",
    "end": "00:01:57.720",
    "text": "洛力对你已经够讲良心的了，不然你以为你肚子里的孩子，还能活到现在吗？再说了，我比你漂亮比你有钱，家境也比你好，傻子都知道该选谁吧。",
    "speech": "单人发言",
    "emotion": "语气嚣张又带着嘲讽",
    "voice": "语调轻快，透着得意",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 12,
    "start": "00:02:00.070",
    "end": "00:02:05.180",
    "text": "唐颖，我爱晓艺。",
    "speech": "单人发言",
    "emotion": "态度决绝",
    "voice": "语气坚定直白",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 13,
    "start": "00:02:13.560",
    "end": "00:02:34.760",
    "text": "你说，你爱你外面的小三，当初结婚时说爱我的誓言。",
    "speech": "单人发言",
    "emotion": "陷入极度的悲伤与绝望",
    "voice": "泣不成声，说话断断续续",
