  {
    "id": 4,
    "start": "00:00:25.966",
    "end": "00:00:29.818",
    "text": "你疯了，那好歹也是我的孩子。",
    "speech": "单人发言",
    "emotion": "震惊且带着怒气",
    "voice": "音量明显提高",
    "music": "钢琴旋律持续铺底",
