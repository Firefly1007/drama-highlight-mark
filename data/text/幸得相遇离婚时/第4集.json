[
  {
    "id": 1,
    "start": "00:00:00.000",
    "end": "00:00:10.500",
    "text": "不下车，认识啊。",
    "speech": "单人发言",
    "emotion": "",
    "voice": "语速平缓",
    "music": "轻柔的钢琴背景音乐",
    "audio_cues": [
