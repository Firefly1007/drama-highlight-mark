    ],
    "uncertainty": ""
  },
  {
    "id": 2,
    "start": "00:00:13.000",
    "end": "00:00:17.000",
    "text": "那个人是我老公，我怕他误会。",
    "speech": "单人发言",
    "emotion": "略带局促和紧张",
    "voice": "音量较轻，语气小心翼翼",
    "music": "轻柔的钢琴背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 3,
    "start": "00:00:18.000",
    "end": "00:00:32.800",
    "text": "单面玻璃他看不见，我只是送你回家，你这反应倒像是我们在偷情了。",
    "speech": "单人发言",
    "emotion": "语气带着调侃的意味",
    "voice": "语速平稳，后半句语气略带戏谑",
    "music": "轻柔的钢琴背景音乐持续",
    "audio_cues": [
      "衣物摩擦的细微声响"
    ],
    "uncertainty": ""
  },
  {
    "id": 4,
    "start": "00:00:36.500",
    "end": "00:00:40.000",
    "text": "我只是不知道怎么解释，为什么会有人送我回家。",
    "speech": "单人发言",
    "emotion": "情绪略带无措",
    "voice": "语气带着茫然",
    "music": "钢琴背景音乐加入吉他元素，旋律依旧舒缓",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 5,
    "start": "00:00:40.800",
    "end": "00:01:08.000",
    "text": "人走了，八年的时间果然太久了，当年楼下的小姑娘都结婚了。",
    "speech": "单人发言",
    "emotion": "语气带着感慨",
    "voice": "语速放缓，带着淡淡的怅然",
    "music": "钢琴与弦乐交织的抒情背景音乐",
    "audio_cues": [
      "车门开关声",
      "细碎的车内动作声响",
      "男性的轻笑声"
    ],
    "uncertainty": ""
  },
  {
    "id": 6,
    "start": "00:01:19.000",
    "end": "00:01:20.500",
    "text": "江总，我们现在去哪？",
    "speech": "单人发言",
    "emotion": "语气恭敬",
    "voice": "音量适中，语气正式",
    "music": "抒情背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 7,
    "start": "00:01:25.000",
    "end": "00:01:26.000",
    "text": "回江公馆。",
    "speech": "单人发言",
    "emotion": "语气沉稳",
    "voice": "语速平缓，语调冷静",
    "music": "抒情背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 8,
    "start": "00:01:27.000",
    "end": "00:01:33.000",
    "text": "祖宗我知道，放心吧我一定会尽快解决唐影的，啊。",
    "speech": "单人发言",
    "emotion": "语气带着安抚的意味",
    "voice": "语速偏快，语气带着敷衍的顺从",
    "music": "转为带有悬疑感的电子背景音乐",
    "audio_cues": [
      "手机震动声"
    ],
    "uncertainty": ""
  },
  {
    "id": 9,
    "start": "00:01:33.500",
    "end": "00:01:42.500",
    "text": "你每天都要回家，扫兴死了，我不管，反正东西我已经给你了，一周之内你必须解决，不然你就别来见我。",
    "speech": "电话中的女性发言",
    "emotion": "带着不满和骄纵的情绪",
    "voice": "音调偏高，语气带着撒娇式的抱怨",
    "music": "悬疑感的电子背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 10,
    "start": "00:01:42.600",
    "end": "00:01:48.500",
    "text": "好好好，我知道，啊，老公亲一口，小妖精。",
    "speech": "单人发言",
    "emotion": "语气带着轻浮的宠溺",
    "voice": "语速轻快，语气带着讨好的意味",
    "music": "悬疑感的电子背景音乐持续",
    "audio_cues": [
