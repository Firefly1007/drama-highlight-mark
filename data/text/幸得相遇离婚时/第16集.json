    "text": "先等等看吧。",
    "speech": "单人发言",
    "emotion": "镇定",
    "voice": "语速平缓",
    "music": "舒缓略带悬疑的钢琴背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 5,
