  {
    "id": 7,
    "start": "00:00:48.000",
    "end": "00:00:58.000",
    "text": "看来陆励，把你照顾得挺好的，身材圆润了不少，小心点，别步我的后尘。",
    "speech": "单人发言",
    "emotion": "嘲讽",
    "voice": "语气带着挑衅",
    "music": "舒缓略带悬疑的钢琴背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 8,
    "start": "00:01:02.000",
    "end": "00:01:05.200",
    "text": "唐影，最近过得好吗？",
    "speech": "单人发言",
    "emotion": "故作熟络",
    "voice": "语气刻意温和",
    "music": "背景音乐节奏逐渐增强，情绪转向紧张",
    "audio_cues": [],
    "uncertainty": ""
