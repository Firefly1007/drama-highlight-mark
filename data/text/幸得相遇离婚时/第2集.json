[
  {
    "id": 1,
    "start": "00:00:00.300",
    "end": "00:00:01.800",
    "text": "我让你八点来吗？",
    "speech": "单人发言",
    "emotion": "生气",
    "voice": "音量偏高，语气严厉",
    "music": "低沉悬疑的背景音乐渐起",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 2,
    "start": "00:00:03.100",
    "end": "00:00:06.100",
    "text": "实在抱歉，是我迟到了。",
    "speech": "单人发言",
    "emotion": "愧疚",
    "voice": "语速轻柔，带着歉意",
    "music": "低沉悬疑的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 3,
    "start": "00:00:07.000",
    "end": "00:00:09.700",
    "text": "我马子都生气先走了，道歉有个屁用啊！",
    "speech": "单人发言",
    "emotion": "暴躁愤怒",
    "voice": "音量拔高，语气蛮横",
    "music": "低沉悬疑的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 4,
    "start": "00:00:11.200",
    "end": "00:00:14.600",
    "text": "严静，你的朋友人品不太行。",
    "speech": "单人发言",
    "emotion": "冷静",
    "voice": "语调平稳，带着评判感",
    "music": "低沉悬疑的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 5,
    "start": "00:00:16.700",
    "end": "00:00:24.500",
    "text": "他呀，江城的富二代，材料商的公子哥，从小被他爸给惯坏了，就那臭脾气。",
    "speech": "单人发言",
    "emotion": "无奈",
    "voice": "语气随意，带着吐槽感",
    "music": "低沉悬疑的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 6,
    "start": "00:00:28.900",
    "end": "00:00:30.100",
    "text": "你没看人家大肚子么？",
    "speech": "单人发言",
    "emotion": "提醒",
    "voice": "语气略带提醒",
    "music": "低沉悬疑的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 7,
    "start": "00:00:32.100",
    "end": "00:00:41.300",
    "text": "给什么钱给钱，没揍你就算给她面子，长得还挺好看，孕妇，小爷还没试过呢。",
    "speech": "单人发言",
    "emotion": "轻浮嚣张",
    "voice": "语气轻佻，带着挑衅感",
    "music": "低沉悬疑的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 8,
    "start": "00:00:43.800",
    "end": "00:00:44.800",
    "text": "四，四哥。",
    "speech": "单人发言",
    "emotion": "惊慌",
    "voice": "声音颤抖，带着惧意",
    "music": "节奏加快，紧张感升级的背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 9,
    "start": "00:00:47.200",
    "end": "00:00:52.000",
    "text": "多喝了点马尿，你特么在这耍什么酒疯，四爷的场子也想扰了？",
    "speech": "单人发言",
    "emotion": "严厉斥责",
    "voice": "语气强硬，带着威慑感",
    "music": "节奏加快，紧张感升级的背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 10,
    "start": "00:00:53.700",
    "end": "00:00:56.800",
    "text": "江城的商界，该换换血了。",
    "speech": "单人发言",
    "emotion": "沉稳有气场",
    "voice": "语调低沉有力",
    "music": "节奏加快，紧张感升级的背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 11,
    "start": "00:00:58.000",
    "end": "00:01:06.000",
    "text": "明白，四哥我错了，四哥，我错了四哥，四哥，我错了四哥。",
    "speech": "单人发言",
    "emotion": "惶恐求饶",
    "voice": "语气急切，带着哭腔般的哀求",
    "music": "节奏加快，紧张感升级的背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 12,
    "start": "00:01:09.500",
    "end": "00:01:33.700",
    "text": "",
    "speech": "无",
    "emotion": "",
    "voice": "",
    "music": "舒缓忧伤的钢琴旋律响起",
    "audio_cues": [
      "衣物摩擦声",
      "脚步声"
    ],
    "uncertainty": ""
  },
  {
    "id": 13,
    "start": "00:01:34.200",
    "end": "00:01:35.200",
    "text": "外套脱下来。",
    "speech": "单人发言",
    "emotion": "平和",
    "voice": "语气平缓",
    "music": "舒缓忧伤的钢琴旋律持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 14,
    "start": "00:01:36.700",
    "end": "00:01:38.600",
    "text": "啊，哦。",
    "speech": "单人发言",
    "emotion": "错愕",
    "voice": "语气带着茫然",
    "music": "舒缓忧伤的钢琴旋律持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 15,
    "start": "00:01:49.700",
    "end": "00:01:58.900",
    "text": "吓到你了，抱歉，一个人回去不安全，我送你。",
    "speech": "单人发言",
    "emotion": "温和",
    "voice": "语气轻柔",
    "music": "舒缓忧伤的钢琴旋律持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 16,
    "start": "00:02:01.000",
    "end": "00:02:01.500",
    "text": "不用。",
    "speech": "单人发言",
    "emotion": "拘谨",
    "voice": "语气微弱",
    "music": "舒缓忧伤的钢琴旋律持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 17,
    "start": "00:02:01.900",
    "end": "00:02:07.300",
    "text": "我说我送你，你住哪？",
    "speech": "单人发言",
    "emotion": "坚持",
    "voice": "语调平稳",
    "music": "舒缓忧伤的钢琴旋律持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 18,
    "start": "00:02:09.000",
    "end": "00:02:17.000",
    "text": "为什么我对这个陌生人，有种熟悉的感觉，福苑小区。",
    "speech": "单人发言",
    "emotion": "疑惑",
    "voice": "语速缓慢，带着恍惚感",
    "music": "舒缓忧伤的钢琴旋律持续",
    "audio_cues": [],
    "uncertainty": ""
  }
