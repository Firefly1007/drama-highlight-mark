[
  {
    "id": 1,
    "start": "00:00:00.000",
    "end": "00:00:06.717",
    "text": "你，我。",
    "speech": "单人发言",
    "emotion": "情绪激动",
    "voice": "语速急促，伴随喘息",
    "music": "低沉悬疑的背景音乐",
    "audio_cues": [
      "急促的喘息声",
      "轻微的肢体挣扎声"
    ],
    "uncertainty": ""
  },
  {
    "id": 2,
    "start": "00:00:11.230",
    "end": "00:00:13.473",
    "text": "公共场所，别无理取闹。",
    "speech": "单人发言",
    "emotion": "语气克制",
    "voice": "语调平稳，音量适中",
    "music": "低沉悬疑的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 3,
    "start": "00:00:14.257",
    "end": "00:00:22.033",
    "text": "我就无理取闹怎么了？你是不是看她变漂亮了，就想吃回头草呀？",
    "speech": "单人发言",
    "emotion": "情绪激动，带着质问",
    "voice": "音调拔高，语速加快",
    "music": "低沉悬疑的背景音乐持续",
    "audio_cues": [
      "急促的呼吸声"
    ],
    "uncertainty": ""
  },
  {
    "id": 4,
    "start": "00:00:22.537",
    "end": "00:00:26.430",
    "text": "努努力，像她这种没有魅力的女人是没有人要的。",
    "speech": "单人发言",
    "emotion": "语气轻蔑",
    "voice": "语速较快，带有不屑的语气",
    "music": "低沉悬疑的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 5,
    "start": "00:00:26.907",
    "end": "00:00:27.696",
    "text": "是吗？",
    "speech": "单人发言",
    "emotion": "语气冷淡",
    "voice": "语调平稳，音量适中",
    "music": "低沉悬疑的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 6,
    "start": "00:00:32.184",
    "end": "00:01:03.436",
    "text": "",
    "speech": "无台词人声",
    "emotion": "",
    "voice": "",
    "music": "切换为《爱如潮水》的男声演唱流行歌曲，旋律深情舒缓",
    "audio_cues": [
      "脚步声"
    ],
    "uncertainty": ""
  },
  {
    "id": 7,
    "start": "00:01:04.281",
    "end": "00:01:15.437",
    "text": "我最喜欢的，就是她的情绪。在我看来，你不过就是一个避孕失败以后的廉价产物，你连她一根头发丝儿你都不如。",
    "speech": "单人发言",
    "emotion": "语气冷漠且带有嘲讽",
    "voice": "语速平稳，语调冰冷",
    "music": "《爱如潮水》的男声演唱流行歌曲持续播放",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 8,
    "start": "00:01:19.418",
    "end": "00:01:20.292",
    "text": "我的包！",
    "speech": "单人发言",
    "emotion": "情绪焦急",
    "voice": "音调突然拔高",
    "music": "《爱如潮水》的男声演唱流行歌曲持续播放",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 9,
    "start": "00:01:25.736",
    "end": "00:01:31.308",
    "text": "勾住，手，勾住我。",
    "speech": "单人发言",
    "emotion": "语气强势",
    "voice": "语速缓慢，带有命令感",
    "music": "《爱如潮水》的男声演唱流行歌曲持续播放",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 10,
    "start": "00:01:55.730",
    "end": "00:02:00.487",
    "text": "大半夜你狗叫什么呀？站我车旁边跟个鬼一样吓你爹一跳。",
    "speech": "单人发言",
    "emotion": "语气烦躁且带着怒气",
    "voice": "音量较大，语速偏快",
    "music": "背景音乐转为悬疑紧张的氛围配乐",
    "audio_cues": [
      "夜晚虫鸣声"
    ],
    "uncertainty": ""
  },
  {
    "id": 11,
    "start": "00:02:01.533",
    "end": "00:02:11.347",
    "text": "是她，她跟唐影，这个背影，好熟悉。",
    "speech": "单人发言",
    "emotion": "语气带着惊讶与疑惑",
    "voice": "语速放缓，带有沉思感",
    "music": "悬疑紧张的氛围配乐持续",
    "audio_cues": [
      "夜晚虫鸣声"
    ],
    "uncertainty": ""
  },
  {
    "id": 12,
    "start": "00:02:15.337",
    "end": "00:02:16.479",
    "text": "你放我下来。",
    "speech": "单人发言",
    "emotion": "语气带着抗拒",
    "voice": "音量适中，语调平稳",
    "music": "悬疑紧张的氛围配乐持续",
    "audio_cues": [
      "脚步声"
    ],
    "uncertainty": ""
  },
  {
    "id": 13,
    "start": "00:02:17.531",
    "end": "00:02:22.343",
    "text": "我不仅帮你解了围，我还是你的大客户，你最好听话。",
    "speech": "单人发言",
    "emotion": "语气强势",
    "voice": "语速平稳，带有压迫感",
    "music": "悬疑紧张的氛围配乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 14,
    "start": "00:02:25.047",
    "end": "00:02:26.798",
    "text": "你为什么老对我阴魂不散？",
    "speech": "单人发言",
    "emotion": "语气带着不满",
    "voice": "音调稍高，语速偏快",
    "music": "悬疑紧张的氛围配乐持续",
    "audio_cues": [
      "脚步声"
    ],
    "uncertainty": ""
  },
  {
    "id": 15,
    "start": "00:02:27.788",
    "end": "00:02:33.448",
    "text": "我不是告诉过你，如果有人欺负你的话，你就给我发信息吗，为什么不发呢？",
    "speech": "单人发言",
    "emotion": "语气带着关切与质问",
    "voice": "语速适中，语调柔和下来",
    "music": "悬疑紧张的氛围配乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 16,
    "start": "00:02:34.209",
    "end": "00:02:43.179",
    "text": "你嘴是租来的着急还吗？说话。",
    "speech": "单人发言",
    "emotion": "语气带着调侃",
    "voice": "语速平稳，语调轻松",
    "music": "悬疑紧张的氛围配乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 17,
    "start": "00:02:44.141",
    "end": "00:02:45.694",
    "text": "我跟你压根就不熟。",
    "speech": "单人发言",
    "emotion": "语气坚决",
    "voice": "语速偏快，语调坚定",
    "music": "悬疑紧张的氛围配乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 18,
    "start": "00:02:46.346",
    "end": "00:02:47.288",
    "text": "那就熟一点。",
    "speech": "单人发言",
    "emotion": "语气带着强势的笃定",
    "voice": "语速缓慢，语调平稳",
    "music": "悬疑紧张的氛围配乐持续至音频结束",
    "audio_cues": [],
    "uncertainty": ""
  }
]