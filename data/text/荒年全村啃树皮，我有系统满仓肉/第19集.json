[
  {
    "id": 1,
    "start": "00:00:00.000",
    "end": "00:00:10.400",
    "text": "叫你偷，叫你偷，叫你偷！打，打！",
    "speech": "多人重叠",
    "emotion": "情绪激烈",
    "voice": "多人声音混杂，包含喊叫与哭腔",
    "music": "紧张激烈的背景音乐",
    "audio_cues": [
