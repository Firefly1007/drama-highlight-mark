[
  {
    "id": 1,
    "start": "00:00:00.880",
    "end": "00:00:08.580",
    "text": "叮，天然野生黑牛肝菌三斤五两，价值一百五十八文钱，是否售卖？",
    "speech": "单人发言",
    "emotion": "语气平稳",
    "voice": "清晰的合成女声，语速均匀",
    "music": "轻快俏皮的古风背景音乐",
    "audio_cues": [
      "清脆的系统提示音效"
    ],
    "uncertainty": ""
  },
  {
    "id": 2,
    "start": "00:00:14.840",
    "end": "00:00:21.730",
    "text": "现在一共有二百一十一文钱，够买一百斤大米，够一家人吃将近两个月了。",
    "speech": "单人发言",
    "emotion": "带着惊喜和满足感",
    "voice": "温柔舒缓，语速放缓",
    "music": "延续轻快的古风背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 3,
    "start": "00:00:22.130",
    "end": "00:00:24.310",
    "text": "这是我的，还给我。",
    "speech": "多人重叠发言",
    "emotion": "情绪激动",
    "voice": "孩童的高声喊叫",
    "music": "背景音乐戛然而止，转为紧张的弦乐铺底",
    "audio_cues": [
      "急促的脚步声"
    ],
    "uncertainty": ""
  },
  {
    "id": 4,
    "start": "00:00:24.350",
    "end": "00:00:24.860",
    "text": "四蛋！",
    "speech": "单人发言",
    "emotion": "满是焦急",
    "voice": "女性的惊呼声，音量拔高",
    "music": "紧张的弦乐持续",
    "audio_cues": [
      "倒吸凉气的惊呼声"
    ],
    "uncertainty": ""
  },
  {
    "id": 5,
    "start": "00:00:26.400",
    "end": "00:00:27.630",
    "text": "把兔子给我！",
    "speech": "单人发言",
    "emotion": "蛮横霸道",
    "voice": "男孩的呵斥声，语气强硬",
    "music": "紧张的弦乐持续推进",
    "audio_cues": [
      "推搡的肢体碰撞声"
    ],
    "uncertainty": ""
  },
  {
    "id": 6,
    "start": "00:00:28.070",
    "end": "00:00:33.210",
    "text": "表哥，这是我先抓到的兔子，是我的兔子。",
    "speech": "孩童哭腔发言",
    "emotion": "带着哭腔的委屈",
    "voice": "小男孩的抽泣声，断断续续",
    "music": "紧张的弦乐持续",
    "audio_cues": [
      "孩童的抽泣声"
    ],
    "uncertainty": ""
  },
  {
    "id": 7,
    "start": "00:00:33.220",
    "end": "00:00:35.240",
    "text": "让你给就给，哪来那么多废话。",
    "speech": "单人发言",
    "emotion": "嚣张跋扈",
    "voice": "男孩的凶狠语气，音量较大",
    "music": "紧张的弦乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 8,
    "start": "00:00:35.250",
    "end": "00:00:37.630",
    "text": "就不给，兔子是我的。",
    "speech": "孩童哭腔发言",
    "emotion": "带着哭腔的倔强",
    "voice": "小男孩哭喊着反驳",
    "music": "紧张的弦乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 9,
    "start": "00:00:38.000",
    "end": "00:00:43.520",
    "text": "赵四蛋，你现在翅膀硬了，敢跟我抢东西，你就不怕你娘打你？",
    "speech": "单人发言",
    "emotion": "充满威胁的语气",
    "voice": "男孩的厉声质问",
    "music": "紧张的弦乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 10,
    "start": "00:00:43.720",
    "end": "00:00:48.690",
    "text": "村里谁不知道，你娘最疼的不是你们家四个儿子，而是程朝哥。",
    "speech": "多人轮流发言",
    "emotion": "带着嘲讽的语气",
    "voice": "几个男孩的起哄声，此起彼伏",
    "music": "紧张的弦乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 11,
    "start": "00:00:48.830",
    "end": "00:00:56.310",
    "text": "就是，你娘只要有好吃的，都偷偷塞给程朝哥，你们四个儿子，就是从茅坑里捡来的。",
    "speech": "多人重叠发言",
    "emotion": "肆意嘲笑",
    "voice": "男孩们的哄笑，语气戏谑",
    "music": "紧张的弦乐持续",
    "audio_cues": [
      "孩童的哄笑声"
    ],
    "uncertainty": ""
  },
  {
    "id": 12,
    "start": "00:00:56.320",
    "end": "00:00:59.470",
    "text": "茅坑里捡来的屎娃，哈哈哈。",
    "speech": "多人重叠发言",
    "emotion": "放声大笑",
    "voice": "孩童们的高声嬉笑",
    "music": "紧张的弦乐持续",
    "audio_cues": [
      "密集的哄堂大笑声"
    ],
    "uncertainty": ""
  },
  {
    "id": 13,
    "start": "00:00:59.480",
    "end": "00:01:05.120",
    "text": "我才不是屎娃，娘现在很喜欢我。",
    "speech": "孩童哭腔发言",
    "emotion": "崩溃大哭",
    "voice": "小男孩的哭喊声，声音颤抖",
    "music": "悲伤的弦乐旋律切入",
    "audio_cues": [
      "孩童的嚎啕大哭声"
    ],
    "uncertainty": ""
  },
  {
    "id": 14,
    "start": "00:01:05.130",
    "end": "00:01:11.710",
    "text": "喜欢你？你就不怕我把这件事情告诉你娘，你娘准会把你捆起来，胖揍你一顿。",
    "speech": "单人发言",
    "emotion": "继续威胁",
    "voice": "男孩的得意语气，带着恶意",
    "music": "悲伤的弦乐持续烘托压抑氛围",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 15,
    "start": "00:01:15.450",
    "end": "00:01:25.010",
    "text": "表哥，我错了，兔子给你，我不要了，求求你不要告诉我娘。",
    "speech": "孩童哭腔发言",
    "emotion": "充满恐惧的哀求",
    "voice": "小男孩边哭边断断续续地求饶",
    "music": "悲伤的弦乐推向高潮",
    "audio_cues": [
      "孩童的抽泣声"
    ],
    "uncertainty": ""
  },
  {
    "id": 16,
    "start": "00:01:27.430",
    "end": "00:01:29.720",
    "text": "现在知道怕，晚了！",
    "speech": "单人发言",
    "emotion": "冷酷无情",
    "voice": "男孩的厉声呵斥",
    "music": "紧张的打击乐骤然响起",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 17,
    "start": "00:01:29.730",
    "end": "00:01:36.070",
    "text": "我知道错了，你不要告诉我娘，让我做什么都可以。",
    "speech": "孩童哭腔发言",
    "emotion": "绝望的哭喊",
    "voice": "小男孩的哭声愈发剧烈",
    "music": "紧张的打击乐持续",
    "audio_cues": [
      "孩童的嚎啕声"
    ],
    "uncertainty": ""
  },
  {
    "id": 18,
    "start": "00:01:37.030",
    "end": "00:01:37.560",
    "text": "住手！",
    "speech": "单人发言",
    "emotion": "厉声喝止",
    "voice": "女性的高声呵斥，音量极具穿透力",
    "music": "音乐在高潮处戛然而止",
    "audio_cues": [
      "收尾的音效重音"
    ],
    "uncertainty": ""
  }
]