    "speech": "单人发言",
    "emotion": "带着吐槽的无奈",
    "voice": "内心独白式的平缓语气",
    "music": "温馨的生活化配乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 11,
    "start": "00:01:47.220",
