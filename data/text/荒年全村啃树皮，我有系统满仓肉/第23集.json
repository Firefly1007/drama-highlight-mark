[
  {
    "id": 1,
    "start": "00:00:03.080",
    "end": "00:00:07.400",
    "text": "二弟三弟，你们没事吧，这是？",
    "speech": "单人发言",
    "emotion": "带着担忧与疑惑",
    "voice": "语气关切，语速稍缓",
    "music": "轻快的古风背景音乐",
    "audio_cues": [
      "轻微的器物碰撞声"
    ],
    "uncertainty": ""
  },
  {
    "id": 2,
    "start": "00:00:07.800",
    "end": "00:00:14.100",
    "text": "大嫂，我们没事，还从程家拿了一大锅鸡汤，一大堆东西，娘可太厉害了。",
    "speech": "单人发言",
    "emotion": "兴奋又自豪",
    "voice": "声音洪亮，语速偏快",
    "music": "轻快的古风背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 3,
    "start": "00:00:14.200",
    "end": "00:00:16.100",
    "text": "好了，都去洗手吃饭吧。",
    "speech": "单人发言",
    "emotion": "平和从容",
    "voice": "语气利落",
    "music": "轻快的古风背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 4,
    "start": "00:00:16.500",
    "end": "00:00:17.300",
    "text": "好嘞。",
    "speech": "单人发言",
    "emotion": "愉悦",
    "voice": "回应干脆",
    "music": "轻快的古风背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 5,
    "start": "00:00:18.600",
    "end": "00:00:24.200",
    "text": "娘竟然和程家闹掰了，还抢了一堆东西，莫非她真的转性了？",
    "speech": "单人发言",
    "emotion": "满是震惊与不解",
    "voice": "低声自语，带着迟疑",
    "music": "轻快的古风背景音乐持续",
    "audio_cues": [
      "液体流动声",
      "碗筷摆放声"
    ],
    "uncertainty": ""
  },
  {
    "id": 6,
    "start": "00:00:41.100",
    "end": "00:00:44.200",
    "text": "来四蛋，把这碗给你阿爷阿奶送过去。",
    "speech": "单人发言",
    "emotion": "平和",
    "voice": "语气自然",
    "music": "舒缓的古风背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 7,
    "start": "00:00:44.300",
    "end": "00:00:45.200",
    "text": "嗯。",
    "speech": "单人发言",
    "emotion": "顺从",
    "voice": "小声回应",
    "music": "舒缓的古风背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 8,
    "start": "00:00:45.500",
    "end": "00:01:00.100",
    "text": "慢点啊，老头子，我咋好像闻到肉香味了？",
    "speech": "单人发言",
    "emotion": "疑惑又带着点期待",
    "voice": "话音刚落便响起吸鼻子的声响",
    "music": "舒缓的古风背景音乐持续",
    "audio_cues": [
      "接连不断的吸鼻子声"
    ],
    "uncertainty": ""
  },
  {
    "id": 9,
    "start": "00:01:02.000",
    "end": "00:01:13.200",
    "text": "哎呀，现在谁家里还吃得起肉啊，这再过个三五天呐，这村里起码会有一半人断粮，你说，这可怎么办呐这。",
    "speech": "单人发言",
    "emotion": "满是焦虑与无奈",
    "voice": "语气沉重，语速缓慢",
    "music": "低沉压抑的古风背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 10,
    "start": "00:01:13.300",
    "end": "00:01:18.200",
    "text": "哎呀，去年蝗灾都熬过来了，朝廷呀不会不管咱们的，啊。",
    "speech": "单人发言",
    "emotion": "强作镇定安抚对方",
    "voice": "语气带着劝慰",
    "music": "低沉压抑的古风背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 11,
    "start": "00:01:18.300",
    "end": "00:01:19.300",
    "text": "阿奶。",
    "speech": "单人发言",
    "emotion": "清脆响亮",
    "voice": "孩童的高声呼喊",
    "music": "低沉压抑的古风背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 12,
    "start": "00:01:20.500",
    "end": "00:01:23.800",
    "text": "四蛋咋来了，该不会是被他娘揍了吧？",
    "speech": "单人发言",
    "emotion": "疑惑又带着恶意揣测",
    "voice": "语气带着猜忌",
    "music": "低沉压抑的古风背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 13,
    "start": "00:01:23.900",
    "end": "00:01:24.500",
    "text": "哎呀。",
    "speech": "单人发言",
    "emotion": "叹气",
    "voice": "无奈的感叹声",
    "music": "低沉压抑的古风背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 14,
    "start": "00:01:25.900",
    "end": "00:01:26.600",
    "text": "阿奶。",
    "speech": "单人发言",
    "emotion": "平和",
    "voice": "孩童的声音",
    "music": "节奏稍快带有悬疑感的古风背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 15,
    "start": "00:01:27.700",
    "end": "00:01:29.000",
    "text": "居然真的是肉。",
    "speech": "单人发言",
    "emotion": "震惊又惊喜",
    "voice": "声音带着难以置信的颤抖",
    "music": "节奏稍快带有悬疑感的古风背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 16,
    "start": "00:01:30.000",
    "end": "00:01:31.600",
    "text": "这是娘叫我送过来的。",
    "speech": "单人发言",
    "emotion": "平静",
    "voice": "孩童的声音",
    "music": "节奏稍快带有悬疑感的古风背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 17,
    "start": "00:01:31.800",
    "end": "00:01:36.000",
    "text": "什么？老大媳妇那个败家玩意儿，竟然会送一碗肉过来？",
    "speech": "单人发言",
    "emotion": "极度震惊",
    "voice": "音调拔高，满是不敢相信",
    "music": "节奏稍快带有悬疑感的古风背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 18,
    "start": "00:01:36.800",
    "end": "00:01:38.200",
    "text": "阿奶，我先回去了。",
    "speech": "单人发言",
    "emotion": "平和",
    "voice": "孩童的声音",
    "music": "节奏稍快带有悬疑感的古风背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 19,
    "start": "00:01:38.300",
    "end": "00:01:41.800",
    "text": "你慢点啊，兔肉，兔肉，我要回去吃兔肉。",
    "speech": "多人发言",
    "emotion": "一边假意叮嘱一边急切念叨",
    "voice": "两人声音略有重叠",
    "music": "节奏稍快带有悬疑感的古风背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 20,
    "start": "00:01:41.900",
    "end": "00:01:46.100",
    "text": "你说老大媳妇，啥时候这么孝顺过呀？",
    "speech": "单人发言",
    "emotion": "满是狐疑",
    "voice": "语气带着不解",
    "music": "节奏稍快带有悬疑感的古风背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 21,
    "start": "00:01:46.400",
    "end": "00:01:52.000",
    "text": "黄鼠狼给鸡拜年，憋着坏呢，看她到底想做什么。",
    "speech": "单人发言",
    "emotion": "阴险猜忌",
    "voice": "语气笃定又带着算计",
    "music": "悬疑感的古风背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 22,
    "start": "00:01:52.900",
    "end": "00:01:55.000",
    "text": "那，那还吃吗？",
    "speech": "单人发言",
    "emotion": "犹豫",
    "voice": "迟疑的询问",
    "music": "悬疑感的古风背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 23,
    "start": "00:01:55.100",
    "end": "00:02:01.400",
    "text": "当然吃，既然是她主动送过来的，不吃白不吃，不吃饱哪有力气对付她。",
    "speech": "单人发言",
    "emotion": "蛮横又理直气壮",
    "voice": "语气强硬",
    "music": "悬疑感的古风背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 24,
    "start": "00:02:03.000",
    "end": "00:02:13.000",
    "text": "这香味，老大媳妇什么时候手艺这么好了？",
    "speech": "单人发言",
    "emotion": "沉浸在吃肉的满足中，又带着一丝疑惑",
    "voice": "嘴里嚼着东西，说话含糊不清",
    "music": "诙谐俏皮的古风背景音乐",
    "audio_cues": [
      "清晰的吃肉咀嚼声",
      "吸溜汤汁的声响"
    ],
    "uncertainty": ""
  }
]