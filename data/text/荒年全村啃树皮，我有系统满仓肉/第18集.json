    ],
    "uncertainty": ""
  },
  {
    "id": 3,
    "start": "00:00:22.400",
    "end": "00:00:31.178",
    "text": "啊。",
    "speech": "单人发言",
    "emotion": "气息不稳",
    "voice": "伴随明显的喘息声",
    "music": "背景音乐节奏逐渐加快，加入弦乐元素，情绪转向略带紧张",
