    ],
    "uncertainty": ""
  },
  {
    "id": 16,
    "start": "00:02:06.120",
    "end": "00:02:10.310",
    "text": "别让今天这场雪，掩盖了你明天的路。",
    "speech": "单人发言",
    "emotion": "温柔且坚定",
    "voice": "语气平缓，富有力量感",
