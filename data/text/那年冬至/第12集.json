[
  {
    "id": 1,
    "start": "00:00:00.300",
    "end": "00:00:03.000",
    "text": "老公，你在等我吗？",
    "speech": "单人发言",
    "emotion": "温和",
    "voice": "语调轻柔",
    "music": "轻柔的流行歌曲背景音",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 2,
    "start": "00:00:03.800",
    "end": "00:00:07.000",
    "text": "这点东西就叫多，还让人来接你。",
    "speech": "单人发言",
    "emotion": "略带调侃",
    "voice": "语气随意",
    "music": "轻柔的流行歌曲持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 3,
    "start": "00:00:08.200",
    "end": "00:00:22.200",
    "text": "我这是拿一路，手都冻僵了。这个给你，这个是我送给你的。进屋吧，我帮你。",
    "speech": "单人发言",
    "emotion": "娇憨",
    "voice": "语速自然",
    "music": "轻柔的流行歌曲持续",
    "audio_cues": [
      "包装袋摩擦声"
    ],
    "uncertainty": ""
  },
  {
    "id": 4,
    "start": "00:00:24.100",
    "end": "00:00:25.200",
    "text": "你喜欢花？",
    "speech": "单人发言",
    "emotion": "疑惑",
    "voice": "语调上扬",
    "music": "轻柔的流行歌曲持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 5,
    "start": "00:00:25.600",
    "end": "00:00:26.100",
    "text": "嗯。",
    "speech": "单人发言",
    "emotion": "肯定",
    "voice": "声音简短",
    "music": "轻柔的流行歌曲持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 6,
    "start": "00:00:27.700",
    "end": "00:00:31.500",
    "text": "你的快递，我已经给你放到衣帽间了。",
    "speech": "单人发言",
    "emotion": "平和",
    "voice": "语气平稳",
    "music": "轻柔的流行歌曲持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 7,
    "start": "00:00:32.700",
    "end": "00:00:35.200",
    "text": "谢谢老公，有你真好。",
    "speech": "单人发言",
    "emotion": "甜蜜",
    "voice": "语调轻快",
    "music": "轻柔的流行歌曲持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 8,
    "start": "00:00:41.900",
    "end": "00:00:43.500",
    "text": "夸张。",
    "speech": "单人发言",
    "emotion": "无奈",
    "voice": "带着笑意",
    "music": "轻柔的流行歌曲持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 9,
    "start": "00:00:57.700",
    "end": "00:01:02.000",
    "text": "我老公这么年轻，他就这么年轻。",
    "speech": "单人发言",
    "emotion": "悲伤",
    "voice": "声音略带颤抖",
    "music": "音乐转为低沉压抑",
    "audio_cues": [
      "沉重的呼吸声"
    ],
    "uncertainty": ""
  },
  {
    "id": 10,
    "start": "00:01:02.200",
    "end": "00:01:05.500",
    "text": "没事，以后奶奶照顾你。",
    "speech": "单人发言",
    "emotion": "关切",
    "voice": "语气慈祥",
    "music": "低沉压抑的音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 11,
    "start": "00:01:05.900",
    "end": "00:01:11.500",
    "text": "不就是站不起来了吗？金叔，看看你现在什么样子，你知道奶奶为你做了多少？",
    "speech": "单人发言",
    "emotion": "激动",
    "voice": "音量提高",
    "music": "低沉压抑的音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 12,
    "start": "00:01:11.600",
    "end": "00:01:15.000",
    "text": "金叔，你现在的样子，我根本看不到。",
    "speech": "单人发言",
    "emotion": "痛苦",
    "voice": "声音虚弱",
    "music": "低沉压抑的音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 13,
    "start": "00:01:15.100",
    "end": "00:01:19.200",
    "text": "看看你现在什么样子，以后奶奶照顾你。",
    "speech": "多人重叠",
    "emotion": "情绪激烈",
    "voice": "多人声音交叠",
    "music": "低沉压抑的音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 14,
    "start": "00:01:23.700",
    "end": "00:01:32.000",
    "text": "老公，老公，醒醒，我有事情要你帮忙。",
    "speech": "单人发言",
    "emotion": "焦急",
    "voice": "语速加快",
    "music": "音乐节奏加快",
    "audio_cues": [
      "急促的脚步声"
    ],
    "uncertainty": ""
  },
  {
    "id": 15,
    "start": "00:01:33.000",
    "end": "00:01:46.000",
    "text": "喂，老公，老公，醒醒，醒醒，老公，醒醒，醒醒，老公，醒醒，醒醒，醒醒。",
    "speech": "多人重叠",
    "emotion": "慌乱",
    "voice": "声音反复呼喊",
    "music": "音乐达到紧张高潮后骤停",
    "audio_cues": [
      "衣物摩擦声"
    ],
    "uncertainty": ""
  },
  {
    "id": 16,
    "start": "00:01:46.700",
    "end": "00:01:49.500",
    "text": "老公，老公。",
    "speech": "单人发言",
    "emotion": "带着哭腔",
    "voice": "声音带着哭腔",
    "music": "钢琴轻柔旋律响起",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 17,
    "start": "00:01:50.700",
    "end": "00:02:00.000",
    "text": "嘿，我需要你的帮忙，谢谢老公。老公，我真的很需要你，有你在真好。",
    "speech": "单人发言",
    "emotion": "温柔",
    "voice": "语调舒缓",
    "music": "钢琴搭配弦乐的抒情音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 18,
    "start": "00:02:03.700",
    "end": "00:02:09.500",
    "text": "老公，嘿，老公你醒了。",
    "speech": "单人发言",
    "emotion": "惊喜",
    "voice": "语气雀跃",
    "music": "抒情音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  }
]