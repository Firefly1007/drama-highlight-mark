[
  {
    "id": 1,
    "start": "00:00:00.300",
    "end": "00:04:00.000",
    "text": "给我吃。",
    "speech": "多人重叠",
    "emotion": "激烈",
    "voice": "大声呵斥",
    "music": "紧张激烈的背景音乐",
    "audio_cues": [
      "打斗声",
      "脚步声",
      "衣物摩擦声"
    ],
    "uncertainty": "部分台词被打斗声和音乐掩盖"
  },
  {
    "id": 2,
    "start": "00:00:03.200",
    "end": "00:00:04.400",
    "text": "够了！",
    "speech": "单人发言",
    "emotion": "激动",
    "voice": "声音拔高",
    "music": "紧张的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 3,
    "start": "00:00:08.000",
    "end": "00:00:12.800",
    "text": "我吃完了，放过，放过元方。",
    "speech": "单人发言",
    "emotion": "带着哭腔",
    "voice": "声音颤抖",
    "music": "",
    "audio_cues": [
      "哭泣声"
    ],
    "uncertainty": ""
  },
  {
    "id": 4,
    "start": "00:00:13.500",
    "end": "00:00:30.500",
    "text": "哦，嗯，还真吃完了。呦，今天我们算没白来啊，可以，我再宽限你们几天。我告诉你们，我下次再来，可就没这么轻松了。哼，我们走。",
    "speech": "单人发言",
    "emotion": "嚣张",
    "voice": "语气傲慢",
    "music": "带有压迫感的背景音乐",
    "audio_cues": [
      "脚步声"
    ],
    "uncertainty": ""
  },
  {
    "id": 5,
    "start": "00:00:31.000",
    "end": "00:00:49.000",
    "text": "你怎么样了？小同学，对不起啊，让你受伤了。",
    "speech": "单人发言",
    "emotion": "关切愧疚",
    "voice": "语气轻柔",
    "music": "舒缓略带伤感的背景音乐",
    "audio_cues": [
      "喘息声"
    ],
    "uncertainty": ""
  },
  {
    "id": 6,
    "start": "00:00:51.000",
    "end": "00:00:54.000",
    "text": "刚才那些人，都是什么人啊？",
    "speech": "单人发言",
    "emotion": "疑惑",
    "voice": "语速平缓",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 7,
    "start": "00:00:54.500",
    "end": "00:00:58.500",
    "text": "我爸这几年做生意失败了，欠了他们五万块钱。",
    "speech": "单人发言",
    "emotion": "无奈",
    "voice": "语气低沉",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 8,
    "start": "00:00:59.500",
    "end": "00:01:03.500",
    "text": "这么多钱，不吃不喝，两三年也还不上啊。",
    "speech": "单人发言",
    "emotion": "震惊",
    "voice": "声音提高",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 9,
    "start": "00:01:06.000",
    "end": "00:01:15.000",
    "text": "这就是命吧。对了小同学，你家住哪？要不我送你回去吧。",
    "speech": "单人发言",
    "emotion": "认命后转为关切",
    "voice": "先低沉后柔和",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 10,
    "start": "00:01:15.200",
    "end": "00:01:18.000",
    "text": "嗯，没事，我自己回去就行。",
    "speech": "单人发言",
    "emotion": "客气",
    "voice": "语气平缓",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 11,
    "start": "00:01:30.500",
    "end": "00:01:38.000",
    "text": "元芳，这些给你，医药费。",
    "speech": "单人发言",
    "emotion": "真诚",
    "voice": "语气轻快",
    "music": "温暖的背景音乐",
    "audio_cues": [
      "鸟鸣声"
    ],
    "uncertainty": ""
  },
  {
    "id": 12,
    "start": "00:01:38.200",
    "end": "00:01:40.500",
    "text": "不用了，你家里也困难。",
    "speech": "单人发言",
    "emotion": "推辞",
    "voice": "语气诚恳",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 13,
    "start": "00:01:41.800",
    "end": "00:01:46.000",
    "text": "没事，这是我奖学金。对了，你大几啊？",
    "speech": "单人发言",
    "emotion": "轻松",
    "voice": "语气活泼",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 14,
    "start": "00:01:47.500",
    "end": "00:01:50.000",
    "text": "那个，我大二。",
    "speech": "单人发言",
    "emotion": "腼腆",
    "voice": "语速偏慢",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 15,
    "start": "00:01:51.000",
    "end": "00:01:52.500",
    "text": "我知道了。",
    "speech": "单人发言",
    "emotion": "开心",
    "voice": "带着笑意",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 16,
    "start": "00:02:00.000",
    "end": "00:02:11.000",
    "text": "怎么了元芳，铲土的时候掉坑里了？",
    "speech": "单人发言",
    "emotion": "调侃",
    "voice": "语气轻松",
    "music": "诙谐的背景音乐",
    "audio_cues": [
      "笑声"
    ],
    "uncertainty": ""
  },
  {
    "id": 17,
    "start": "00:02:13.000",
    "end": "00:02:15.000",
    "text": "把头，我让人给打了。",
    "speech": "单人发言",
    "emotion": "委屈",
    "voice": "语气带着怨气",
    "music": "背景音乐持续",
