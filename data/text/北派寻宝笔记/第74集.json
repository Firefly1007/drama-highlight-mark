[
  {
    "id": 1,
    "start": "00:00:00.370",
    "end": "00:00:02.130",
    "text": "啊，哈。",
    "speech": "多人同时发出惊呼声",
    "emotion": "惊慌",
    "voice": "短促的惊呼声",
    "music": "紧张的背景音乐",
    "audio_cues": [
      "短促的动作音效"
    ],
    "uncertainty": ""
  },
  {
    "id": 2,
    "start": "00:00:02.430",
    "end": "00:00:13.510",
    "text": "喜欢吃鸡蛋是吧，来，把它们全给我吃了，我就放过你们。小婊子，叔叔我们请你们吃鸡蛋呐，哈哈哈。",
    "speech": "单人发言",
    "emotion": "嚣张戏谑",
    "voice": "语气粗鲁，带着明显的恶意和狂笑",
    "music": "紧张的背景音乐持续",
    "audio_cues": [
      "清脆的类似玻璃或金属小物件碰撞的声音"
    ],
    "uncertainty": ""
  },
  {
    "id": 3,
    "start": "00:00:13.730",
    "end": "00:00:17.620",
    "text": "你们太过分了！对呀，我们就是很过分呐。",
    "speech": "多人轮流发言",
    "emotion": "一方愤怒，另一方嚣张",
    "voice": "女声愤怒高亢，男声粗野",
    "music": "紧张的背景音乐持续",
    "audio_cues": [
      "多人重叠的狂笑"
    ],
    "uncertainty": ""
  },
  {
    "id": 4,
    "start": "00:00:17.710",
    "end": "00:00:25.220",
    "text": "哈哈哈，来，吃！你们这太欺负人了！",
    "speech": "多人轮流发言",
    "emotion": "一方张狂，一方愤怒",
    "voice": "前半段带着狂笑，后半段声音激动拔高",
    "music": "紧张的背景音乐持续推进",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 5,
    "start": "00:00:28.280",
    "end": "00:00:31.180",
    "text": "你他妈是哪根葱？你谁呀？",
    "speech": "单人发言",
    "emotion": "凶狠蛮横",
    "voice": "语气凶狠，音量提高",
    "music": "背景音乐节奏变得更紧凑",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 6,
    "start": "00:00:31.520",
    "end": "00:00:36.330",
    "text": "我是李静的同学，你们要是再胡闹，我就报警。",
    "speech": "单人发言",
    "emotion": "强作镇定，带着愤怒",
    "voice": "语速较快，语气坚定",
    "music": "紧张的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 7,
    "start": "00:00:36.790",
    "end": "00:00:45.580",
    "text": "报警？哼哼，报警，欠债还钱天经地义，你他妈敢报警？",
    "speech": "单人发言",
    "emotion": "嘲讽且凶狠",
    "voice": "发出冷笑，语气充满威胁",
    "music": "紧张的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 8,
    "start": "00:00:46.310",
    "end": "00:00:56.010",
    "text": "啊！林峰！别拦他！我，我吃，我吃。",
    "speech": "多人重叠发言",
    "emotion": "惊恐、痛苦、绝望",
    "voice": "混杂着惨叫声、哭腔和颤抖的声音",
    "music": "音乐短暂停顿后转为更压抑的氛围",
    "audio_cues": [
      "击打肉体的音效",
      "惊呼声"
    ],
    "uncertainty": ""
  },
  {
    "id": 9,
    "start": "00:01:05.170",
    "end": "00:01:13.250",
    "text": "呃，呃，哈哈哈，吃一口可不行哦，要全部都吃了。",
    "speech": "多人重叠发言后单人发言",
    "emotion": "戏谑张狂",
    "voice": "伴随狂笑，语气嚣张",
    "music": "压抑的背景音乐持续",
    "audio_cues": [
      "女性的呕吐声"
    ],
    "uncertainty": ""
  },
  {
    "id": 10,
    "start": "00:01:13.460",
    "end": "00:01:32.680",
    "text": "好，我吃，大哥，我求求你了，他没在家，家里只有我们母女，你放过我们吧，到时候我挣钱还你，我挣钱还你，我求求你放过我们吧大。",
    "speech": "单人发言",
    "emotion": "哀求、崩溃、哭腔浓重",
    "voice": "声音颤抖，带着剧烈的哭腔和抽泣",
    "music": "压抑的背景音乐持续",
    "audio_cues": [
      "多人重叠的张狂笑声"
    ],
    "uncertainty": ""
  },
  {
    "id": 11,
    "start": "00:01:33.020",
    "end": "00:01:41.020",
    "text": "大哥，我和你们拼了！",
    "speech": "多人重叠发言",
    "emotion": "一方狂笑不止，一方情绪激动到极点",
    "voice": "混杂着狂笑和嘶吼声",
    "music": "背景音乐节奏骤然加快",
    "audio_cues": [
      "肢体冲突的打斗声",
      "发力的闷哼声"
    ],
    "uncertainty": ""
  },
  {
    "id": 12,
    "start": "00:01:42.760",
    "end": "00:01:46.770",
    "text": "别吃了，别吃了！",
    "speech": "单人发言",
    "emotion": "痛苦焦急",
    "voice": "声音带着哭腔和嘶吼",
    "music": "紧张的背景音乐持续",
    "audio_cues": [
      "闷哼声"
    ],
    "uncertainty": ""
  },
  {
    "id": 13,
    "start": "00:01:46.780",
    "end": "00:01:49.370",
    "text": "谁让你爹欠债不还钱呐。",
    "speech": "单人发言",
    "emotion": "嚣张蛮横",
    "voice": "语气粗野",
    "music": "紧张的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 14,
    "start": "00:01:50.320",
    "end": "00:01:53.090",
    "text": "别吃了，再吃下去真的会死人的。",
    "speech": "单人发言",
    "emotion": "焦急绝望",
    "voice": "嘶吼着说话",
    "music": "紧张的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 15,
    "start": "00:01:53.100",
    "end": "00:02:00.370",
    "text": "多嘴！给我干他！我操！",
    "speech": "多人发言",
