[
  {
    "id": 1,
    "start": "00:00:00.000",
    "end": "00:00:02.500",
    "text": "不是，啥活啊？我不卖身啊！",
    "speech": "单人发言",
    "emotion": "惊慌",
    "voice": "语速偏快，语气急促",
    "music": "节奏紧张的管弦背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 2,
    "start": "00:00:02.540",
    "end": "00:00:14.510",
    "text": "寻龙千万看缠山，一重缠是一重关，小伙子，可曾听闻土行？",
    "speech": "单人发言",
    "emotion": "沉稳神秘",
    "voice": "嗓音低沉沙哑，语速缓慢",
    "music": "节奏紧张的管弦背景音乐持续",
    "audio_cues": [
      "快速敲击的机关声"
    ],
    "uncertainty": ""
  },
  {
    "id": 3,
    "start": "00:00:15.070",
    "end": "00:00:16.860",
    "text": "土，土行？",
    "speech": "单人发言",
    "emotion": "震惊",
    "voice": "语气迟疑，略带结巴",
    "music": "",
    "audio_cues": [
      "金属嗡鸣特效声"
    ],
    "uncertainty": ""
  },
  {
    "id": 4,
    "start": "00:00:17.080",
    "end": "00:00:33.670",
    "text": "没错，你想要风风光光开着大奔回家，成为全村首富，就跟我来，若是你还惦记你那点鸡毛钱，就当我看错人了。",
    "speech": "单人发言",
    "emotion": "循循善诱",
    "voice": "语气从容，带有引导性",
    "music": "转为带有悬疑感的背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 5,
    "start": "00:00:35.700",
    "end": "00:00:36.310",
    "text": "哎。",
    "speech": "单人发言",
    "emotion": "茫然",
    "voice": "轻声应答",
    "music": "",
    "audio_cues": [
      "脚步声"
    ],
    "uncertainty": ""
  },
  {
    "id": 6,
    "start": "00:00:39.330",
    "end": "00:00:42.200",
    "text": "打算什么时候还钱啊，跟你那死爹一样完犊子。",
    "speech": "单人发言",
    "emotion": "暴躁愤怒",
    "voice": "音调拔高，语气尖锐",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 7,
    "start": "00:00:42.310",
    "end": "00:00:44.060",
    "text": "你那爹妈就是穷死的。",
    "speech": "单人发言",
    "emotion": "嚣张",
    "voice": "语气蛮横",
    "music": "",
    "audio_cues": [
      "重击鼓点特效声"
    ],
    "uncertainty": ""
  },
  {
    "id": 8,
    "start": "00:00:46.580",
    "end": "00:00:57.480",
    "text": "我向元丰，一定要出人头地！哎，等等我，等等我，等等我！",
    "speech": "单人发言",
    "emotion": "情绪激昂",
    "voice": "从坚定呐喊转为急促呼喊",
    "music": "抒情励志的钢琴背景音乐",
    "audio_cues": [
      "脚步声"
    ],
    "uncertainty": ""
  },
  {
    "id": 9,
    "start": "00:00:59.670",
    "end": "00:01:02.700",
    "text": "哈哈哈，好小子。",
    "speech": "单人发言",
    "emotion": "满意",
    "voice": "发出爽朗的笑声",
    "music": "激昂的管弦背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 10,
    "start": "00:01:05.510",
    "end": "00:01:24.350",
    "text": "这个老人，江湖外号云鹤，跟他走下天桥的那一刻，我就算拜师入门了，分为南北两派，南派心细，北派胆大，而我师傅，则是北派传人，我沈元丰的故事，也从这一刻开始。",
    "speech": "旁白式叙述",
    "emotion": "沉稳",
    "voice": "语速平稳，带有回忆感",
    "music": "激昂的管弦背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 11,
    "start": "00:01:25.770",
    "end": "00:01:42.780",
    "text": "元丰啊，这趟活，你负责散土，我昨天教你的，记住了吧？",
    "speech": "单人发言",
    "emotion": "和蔼",
    "voice": "语气亲切",
    "music": "轻快诙谐的管弦背景音乐",
    "audio_cues": [
      "汽车行驶声",
      "车门开关声",
      "脚步声"
    ],
    "uncertainty": ""
  },
  {
    "id": 12,
    "start": "00:01:42.830",
    "end": "00:01:43.470",
    "text": "记住了。",
    "speech": "单人发言",
    "emotion": "恭敬",
    "voice": "语气干脆",
    "music": "轻快诙谐的管弦背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 13,
    "start": "00:01:43.720",
    "end": "00:01:50.770",
    "text": "跟我好好干，两年内必成全村首富，哈哈哈，走吧，见见大家伙。",
    "speech": "单人发言",
    "emotion": "自信豪迈",
    "voice": "发出洪亮的大笑声",
    "music": "轻快诙谐的管弦背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 14,
    "start": "00:02:09.110",
    "end": "00:02:12.310",
    "text": "哟，来了个小伙子呀！",
    "speech": "单人发言",
    "emotion": "轻佻",
    "voice": "语调婉转，带有挑逗意味",
    "music": "神秘诡异的背景音乐",
    "audio_cues": [
      "脚步声"
    ],
    "uncertainty": ""
  },
  {
    "id": 15,
    "start": "00:02:18.320",
    "end": "00:02:25.320",
    "text": "咳，咳，就是不知道。",
    "speech": "多人发言",
    "emotion": "戏谑",
    "voice": "先后发出咳嗽声和轻笑声，语气慵懒",
    "music": "神秘诡异的背景音乐持续",
    "audio_cues": [
      "蛇类爬行的沙沙声"
    ],
    "uncertainty": ""
  }
]