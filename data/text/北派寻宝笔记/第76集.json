[
  {
    "id": 1,
    "start": "00:00:00.000",
    "end": "00:00:02.300",
    "text": "谁他妈干的？",
    "speech": "单人发言",
    "emotion": "生气",
    "voice": "音量偏高，语气直接",
    "music": "低沉悬疑的背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 2,
    "start": "00:00:02.500",
    "end": "00:00:09.100",
    "text": "看你小子，一脸不服气的样子，怎么，想把场子找回来？",
    "speech": "单人发言",
    "emotion": "语气沉稳",
    "voice": "声线低沉沙哑，语速平缓",
    "music": "低沉悬疑的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 3,
    "start": "00:00:09.200",
    "end": "00:00:12.200",
    "text": "想，把头，我觉得我吃亏了。",
    "speech": "单人发言",
    "emotion": "情绪激动",
    "voice": "语气急切",
    "music": "背景音乐节奏略微加快，增添紧张感",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 4,
    "start": "00:00:13.100",
    "end": "00:00:19.100",
    "text": "那你就忍一忍，等咱们把这事干完，这仇，我给你报。",
    "speech": "单人发言",
    "emotion": "语气强势",
    "voice": "声线浑厚，带有威慑力",
    "music": "背景音乐变得更加激昂",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 5,
    "start": "00:00:20.400",
    "end": "00:00:21.200",
    "text": "谢谢把头。",
    "speech": "单人发言",
    "emotion": "情绪平复",
    "voice": "语气恭敬",
    "music": "激昂的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 6,
    "start": "00:00:27.200",
    "end": "00:00:28.300",
