      "鸟叫声"
    ],
    "uncertainty": ""
  },
  {
    "id": 15,
    "start": "00:03:02.739",
    "end": "00:03:07.739",
    "text": "二哥，快下来吧。",
    "speech": "单人发言",
    "emotion": "催促",
    "voice": "声音洪亮",
    "music": "紧张的悬疑氛围背景音乐持续",
    "audio_cues": [
      "攀爬落地的声响"
    ],
    "uncertainty": ""
  },
  {
    "id": 16,
    "start": "00:03:10.059",
    "end": "00:03:17.739",
    "text": "哈哈哈，元芳，以后还得多练呐，瞅你这小鸡杆儿细腿的。",
    "speech": "单人发言",
    "emotion": "戏谑调侃",
    "voice": "边笑边说，语气轻松",
    "music": "背景音乐逐渐转为宏大的奇幻探险风格",
