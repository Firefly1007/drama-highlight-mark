    ],
    "uncertainty": ""
  },
  {
    "id": 2,
    "start": "00:00:03.000",
    "end": "00:00:09.180",
    "text": "好了好了，别吓唬他了，介绍一下分工吧。",
    "speech": "单人发言",
    "emotion": "沉稳",
    "voice": "语速平缓",
    "music": "轻快的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 3,
    "start": "00:00:09.539",
    "end": "00:00:21.518",
    "text": "好，小伙子，听好了，咱们北派一般是六人，首先是把头，王先生，其次是孙老。",
    "speech": "单人发言",
    "emotion": "从容",
    "voice": "语调清晰，带有引导性",
    "music": "背景音乐转为带有悬疑感的摇滚风格配乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 4,
    "start": "00:00:21.519",
    "end": "00:00:23.319",
    "text": "哈哈哈。",
    "speech": "多人重叠",
    "emotion": "轻松戏谑",
    "voice": "多人同时发出笑声",
    "music": "悬疑摇滚配乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 5,
    "start": "00:00:28.579",
    "end": "00:00:39.619",
    "text": "再之后就是土工，孙老二和孙老三，土工之后呢，是咱们开路。",
    "speech": "单人发言",
    "emotion": "从容",
    "voice": "语速平稳，叙事连贯",
    "music": "悬疑摇滚配乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 6,
    "start": "00:00:39.859",
    "end": "00:00:43.519",
    "text": "哎呀，这活啊，也归我管。",
    "speech": "单人发言",
    "emotion": "豪爽",
    "voice": "语气粗犷",
    "music": "悬疑摇滚配乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 7,
    "start": "00:00:44.459",
    "end": "00:00:52.940",
    "text": "这最后啊，就是你和我，我呢负责后勤，听明白了吗？",
    "speech": "单人发言",
    "emotion": "从容",
    "voice": "语速放缓，带有询问意味",
    "music": "悬疑摇滚配乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 8,
    "start": "00:00:53.380",
    "end": "00:01:08.300",
    "text": "明白了，既然明白了，好，今晚凌晨上山，下墓。",
    "speech": "多人轮流发言",
    "emotion": "严肃坚决",
    "voice": "声音低沉有力，音量逐渐拔高",
    "music": "配乐转为宏大紧张的管弦乐风格",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 9,
    "start": "00:01:09.300",
    "end": "00:01:21.839",
    "text": "",
    "speech": "无台词",
    "emotion": "",
    "voice": "",
    "music": "紧张的悬疑氛围电子背景音乐",
    "audio_cues": [
      "夜晚虫鸣声",
      "脚步声",
      "喘息声"
    ],
    "uncertainty": ""
  },
  {
    "id": 10,
    "start": "00:01:23.539",
    "end": "00:01:32.060",
    "text": "就在这半山腰上，确定吗把头，错不了，老二老三，动手，明白。",
    "speech": "多人轮流发言",
    "emotion": "谨慎果断",
    "voice": "压低音量，小声交流",
    "music": "紧张的悬疑氛围电子背景音乐持续",
    "audio_cues": [
      "鸟叫声"
    ],
    "uncertainty": ""
  },
  {
    "id": 11,
    "start": "00:01:32.320",
    "end": "00:01:50.719",
    "text": "老大，准备吃饭了，周围没客人吧，风平浪静，开火做饭。",
    "speech": "多人轮流发言",
    "emotion": "警惕",
    "voice": "多人低声对话，部分声音通过通讯设备传出",
    "music": "紧张的悬疑氛围电子背景音乐持续",
    "audio_cues": [
      "挖掘作业的声响",
      "喘息声"
    ],
    "uncertainty": ""
  },
  {
    "id": 12,
    "start": "00:01:51.340",
    "end": "00:02:11.719",
    "text": "好，老二，动手，用金针灌顶，放心吧。有。",
    "speech": "多人轮流发言",
    "emotion": "紧张",
    "voice": "语气急促，伴随发力的喘息声",
    "music": "转为带有危机感的钢琴主导背景音乐",
    "audio_cues": [
