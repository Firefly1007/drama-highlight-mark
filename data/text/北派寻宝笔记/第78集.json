[
  {
    "id": 1,
    "start": "00:00:00.000",
    "end": "00:00:02.000",
    "text": "把头，怎么回事啊？",
    "speech": "单人发言",
    "emotion": "疑惑",
    "voice": "语速稍快，语气带着明显的疑问",
    "music": "低沉悬疑的背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 2,
    "start": "00:00:02.200",
    "end": "00:00:04.800",
    "text": "老三，你说吧。",
    "speech": "单人发言",
    "emotion": "沉重",
    "voice": "语气低沉，语速缓慢",
    "music": "低沉悬疑的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 3,
    "start": "00:00:05.400",
    "end": "00:00:08.200",
    "text": "昨晚，我跟二哥下去找整岔。",
    "speech": "单人发言",
    "emotion": "严肃",
    "voice": "语气郑重",
    "music": "低沉悬疑的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 4,
    "start": "00:00:13.800",
    "end": "00:00:17.800",
    "text": "老三，我去前头青铜门那摸一摸，看看能摸着啥东西呀。",
    "speech": "单人发言",
    "emotion": "谨慎",
    "voice": "压低声音，语气小心",
    "music": "低沉悬疑的背景音乐持续",
    "audio_cues": [
      "脚步声"
    ],
    "uncertainty": ""
  },
  {
    "id": 5,
    "start": "00:00:17.900",
    "end": "00:00:20.200",
    "text": "二哥，你自己小心点，等着我。",
    "speech": "单人发言",
    "emotion": "担忧",
    "voice": "语气带着关切",
    "music": "低沉悬疑的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 6,
    "start": "00:00:20.300",
    "end": "00:00:37.400",
    "text": "啊，呃啊！",
    "speech": "多人重叠",
    "emotion": "惊恐",
    "voice": "多人声音混杂，出现惊呼声",
    "music": "音乐节奏骤然加快，变得紧张惊悚",
    "audio_cues": [
      "脚步声",
      "特效音"
    ],
    "uncertainty": "部分人声被音效覆盖"
  },
  {
    "id": 7,
    "start": "00:00:40.700",
    "end": "00:00:46.400",
    "text": "打那以后，我再也找不见二哥了，把头，让我再下去一次。",
    "speech": "单人发言",
    "emotion": "激动急切",
    "voice": "语速加快，情绪激动",
    "music": "紧张惊悚的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 8,
    "start": "00:00:46.700",
    "end": "00:00:54.700",
    "text": "老三，冷静，这事有点蹊跷，咱们要求援。",
    "speech": "单人发言",
    "emotion": "沉稳",
    "voice": "语气沉稳，试图安抚对方",
    "music": "紧张惊悚的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 9,
    "start": "00:00:55.000",
    "end": "00:00:55.700",
    "text": "报警。",
    "speech": "单人发言",
    "emotion": "惊讶",
    "voice": "声音拔高，语气充满意外",
    "music": "紧张惊悚的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 10,
    "start": "00:00:57.100",
    "end": "00:01:06.100",
    "text": "报警？啊，你脑子被驴踢了吧，啊？难道你想要进去吃十年窝头？",
    "speech": "单人发言",
    "emotion": "愤怒斥责",
    "voice": "音量大幅提高，语气严厉",
    "music": "紧张惊悚的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 11,
    "start": "00:01:09.800",
    "end": "00:01:13.500",
    "text": "这个时间，人差不多应该来了。",
    "speech": "单人发言",
    "emotion": "平静",
    "voice": "语气恢复平缓",
    "music": "紧张惊悚的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 12,
    "start": "00:01:23.700",
    "end": "00:01:31.700",
    "text": "哎，快进快进，哈哈哈，哎去去去，哈哈哈，来。",
    "speech": "单人发言",
    "emotion": "热情",
    "voice": "语气热情，伴随笑声",
    "music": "紧张惊悚的背景音乐持续",
    "audio_cues": [
      "开门声"
    ],
    "uncertainty": ""
  },
  {
    "id": 13,
    "start": "00:01:32.200",
    "end": "00:01:52.400",
    "text": "认识一下，姚家兄妹，姚策，姚玉门，道上有名，家学渊源，尤其是他们的叔叔，是咱们行里大名鼎鼎的牛人，姚师爷，嘿嘿嘿，百度上都能搜到。",
    "speech": "单人发言",
    "emotion": "郑重介绍",
    "voice": "语速平稳，语气郑重",
    "music": "紧张惊悚的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 14,
    "start": "00:01:52.900",
    "end": "00:01:54.000",
    "text": "见过两位前辈。",
    "speech": "单人发言",
    "emotion": "恭敬",
    "voice": "语气恭敬",
    "music": "紧张惊悚的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 15,
    "start": "00:01:55.700",
    "end": "00:01:57.700",
    "text": "新人，客气了。",
    "speech": "单人发言",
    "emotion": "淡然",
    "voice": "语气平和",
    "music": "紧张惊悚的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 16,
    "start": "00:01:58.500",
    "end": "00:02:05.000",
    "text": "这次来呢，主要是请玉门姑娘，帮咱们破解墓穴中的机关。",
    "speech": "单人发言",
    "emotion": "诚恳",
    "voice": "语气诚恳",
    "music": "紧张惊悚的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 17,
    "start": "00:02:05.400",
    "end": "00:02:10.400",
    "text": "我不保证会有效果，今天晚上，咱们一起下墓看看。",
    "speech": "单人发言",
    "emotion": "冷静",
    "voice": "语气冷静客观",
    "music": "紧张惊悚的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 18,
    "start": "00:02:10.600",
    "end": "00:02:13.200",
    "text": "嗯，好，只要能打开青铜门就行。",
    "speech": "单人发言",
    "emotion": "急切",
    "voice": "语气急切",
    "music": "紧张惊悚的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 19,
    "start": "00:02:13.900",
    "end": "00:02:17.400",
    "text": "哎，一切听姚姑娘定夺。",
    "speech": "单人发言",
    "emotion": "恭敬",
    "voice": "语气恭敬",
    "music": "紧张惊悚的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 20,
    "start": "00:02:19.200",
    "end": "00:02:22.300",
    "text": "那就今晚十二点，探堂子。",
    "speech": "单人发言",
    "emotion": "坚定",
    "voice": "语气坚定有力",
    "music": "紧张惊悚的背景音乐推向高潮后结束",
    "audio_cues": [],
    "uncertainty": ""
  }
]