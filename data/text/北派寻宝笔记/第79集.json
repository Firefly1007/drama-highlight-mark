[
  {
    "id": 1,
    "start": "00:00:00.080",
    "end": "00:00:06.180",
    "text": "云峰啊，你去准备一些淡水和压缩饼干，晚上跟他们下去。",
    "speech": "单人发言",
    "emotion": "严肃",
    "voice": "语气沉稳，语速平缓",
    "music": "低沉悬疑的背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 2,
    "start": "00:00:07.320",
    "end": "00:00:08.990",
    "text": "八大头，你不下去啊？",
    "speech": "单人发言",
    "emotion": "疑惑",
    "voice": "语气带着疑问",
    "music": "低沉悬疑的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 3,
    "start": "00:00:11.119",
    "end": "00:00:20.518",
    "text": "我怀疑，有人已经在暗中盯上咱们了，我在这边统筹。去，买点东西。",
    "speech": "单人发言",
    "emotion": "凝重",
    "voice": "语速放缓，语气郑重",
    "music": "低沉悬疑的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 4,
    "start": "00:00:21.639",
    "end": "00:00:22.059",
    "text": "好嘞。",
    "speech": "单人发言",
    "emotion": "干脆",
    "voice": "回应简短利落",
    "music": "低沉悬疑的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 5,
    "start": "00:00:26.438",
    "end": "00:00:26.998",
    "text": "云峰。",
    "speech": "单人发言",
    "emotion": "轻快",
    "voice": "语气清亮",
    "music": "转为轻快活泼的背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 6,
    "start": "00:00:28.358",
    "end": "00:00:28.998",
    "text": "李静。",
    "speech": "单人发言",
    "emotion": "惊讶",
    "voice": "语气带着意外",
    "music": "轻快活泼的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 7,
    "start": "00:00:30.917",
    "end": "00:00:38.557",
    "text": "向云峰，你这么有钱啊？你家是做什么生意的？",
    "speech": "单人发言",
    "emotion": "好奇",
    "voice": "语气带着探究",
    "music": "轻快活泼的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 8,
    "start": "00:00:39.317",
    "end": "00:00:43.817",
    "text": "没什么，就是做点服装生意。",
    "speech": "单人发言",
    "emotion": "局促",
    "voice": "语气略显慌乱，停顿后作答",
    "music": "轻快活泼的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 9,
    "start": "00:00:44.437",
    "end": "00:00:45.397",
    "text": "这样啊。",
    "speech": "单人发言",
    "emotion": "语气平淡",
    "voice": "轻声回应",
    "music": "轻快活泼的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 10,
    "start": "00:00:47.716",
    "end": "00:00:52.356",
    "text": "啊，怎么了？",
    "speech": "单人发言",
    "emotion": "疑惑",
    "voice": "语气带着关切",
    "music": "背景音乐转为抒情忧伤风格",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 11,
    "start": "00:00:55.235",
    "end": "00:01:03.795",
    "text": "云峰，我知道你家有钱，你能不能借我五万块钱？",
    "speech": "单人发言",
    "emotion": "带着哭腔，情绪激动",
    "voice": "声音颤抖，伴随明显的抽泣声",
    "music": "抒情忧伤的背景音乐持续",
    "audio_cues": [
      "抽泣声"
    ],
    "uncertainty": ""
  },
  {
    "id": 12,
    "start": "00:01:07.394",
    "end": "00:01:11.714",
    "text": "只要你借我钱，我，我就是你的人了。",
    "speech": "单人发言",
    "emotion": "绝望",
    "voice": "哭腔浓重，语气卑微",
    "music": "抒情忧伤的背景音乐持续",
    "audio_cues": [
      "抽泣声"
    ],
    "uncertainty": ""
  },
  {
    "id": 13,
    "start": "00:01:24.512",
    "end": "00:01:34.111",
    "text": "我真的没办法了，昨天晚上要债的又来了，他们说要是我再不还钱。",
    "speech": "单人发言",
    "emotion": "崩溃哭诉",
    "voice": "哭声剧烈，说话断断续续",
    "music": "抒情忧伤的背景音乐持续",
    "audio_cues": [
      "剧烈的哭泣声"
    ],
    "uncertainty": ""
  },
  {
    "id": 14,
    "start": "00:01:34.431",
    "end": "00:01:42.510",
    "text": "他就把我爸丢河里，你要是不帮我，我就去卖，去当小姐，去陪老男人睡觉。",
    "speech": "单人发言",
    "emotion": "情绪极度激动",
    "voice": "哭喊着说出决绝的话语",
    "music": "抒情忧伤的背景音乐持续",
    "audio_cues": [
      "剧烈的哭泣声"
    ],
    "uncertainty": ""
  },
  {
    "id": 15,
    "start": "00:01:46.470",
    "end": "00:01:48.350",
    "text": "你又何必作践自己。",
    "speech": "单人发言",
    "emotion": "心疼又无奈",
    "voice": "语气带着叹息",
    "music": "抒情忧伤的背景音乐持续",
    "audio_cues": [
      "轻微抽泣声"
    ],
    "uncertainty": ""
  },
  {
    "id": 16,
    "start": "00:01:53.329",
    "end": "00:01:59.169",
    "text": "我真的没办法，我只能这。",
    "speech": "单人发言",
    "emotion": "无助",
    "voice": "哭腔未消，语气虚弱",
    "music": "抒情忧伤的背景音乐持续",
    "audio_cues": [
      "抽泣声"
    ],
    "uncertainty": ""
  },
  {
    "id": 17,
    "start": "00:02:00.448",
    "end": "00:02:02.728",
    "text": "好，我帮你。",
    "speech": "单人发言",
    "emotion": "下定决心",
    "voice": "语气坚定",
    "music": "抒情忧伤的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 18,
    "start": "00:02:04.328",
    "end": "00:02:09.327",
    "text": "求求你了，我只能靠你了。",
    "speech": "单人发言",
    "emotion": "带着哭腔的哀求",
    "voice": "声音颤抖，满是依赖",
    "music": "抒情忧伤的背景音乐持续至结束",
    "audio_cues": [
      "抽泣声"
    ],
    "uncertainty": ""
  }
]