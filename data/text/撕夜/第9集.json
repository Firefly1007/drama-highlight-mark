    ],
    "uncertainty": ""
  },
  {
    "id": 9,
    "start": "00:00:36.040",
    "end": "00:00:38.158",
    "text": "江小姐，你要出去？",
    "speech": "单人发言",
    "emotion": "疑惑",
    "voice": "语气沉稳",
    "music": "悬疑氛围背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 10,
    "start": "00:00:38.640",
    "end": "00:00:41.557",
    "text": "嗯，我去买菜，我给楚爷做点饭吃。",
    "speech": "单人发言",
    "emotion": "平和",
    "voice": "语气自然",
    "music": "悬疑氛围背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 11,
    "start": "00:00:41.840",
    "end": "00:00:44.357",
    "text": "你说，你要给楚爷做饭？",
    "speech": "单人发言",
    "emotion": "震惊",
    "voice": "音量提高",
    "music": "悬疑氛围背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 12,
    "start": "00:00:44.640",
    "end": "00:00:55.317",
    "text": "嗯，他知道我给别的男人做过饭有点不开心，所以哄哄他，你放心，我不会再逃跑。",
    "speech": "单人发言",
    "emotion": "温柔",
    "voice": "语速平缓",
    "music": "转为轻快诙谐的背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 13,
    "start": "00:00:56.160",
    "end": "00:01:02.436",
    "text": "江小姐还真是让人琢磨不透，上次你被楚爷抓回来，为了逃跑可连",
    "speech": "单人发言",
    "emotion": "感慨",
    "voice": "语气带着无奈",
    "music": "轻快诙谐的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 14,
    "start": "00:01:02.477",
    "end": "00:01:07.237",
