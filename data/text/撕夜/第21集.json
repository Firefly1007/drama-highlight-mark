  {
    "id": 2,
    "start": "00:00:10.700",
    "end": "00:00:11.600",
    "text": "这半年。",
    "speech": "单人发言",
    "emotion": "低沉",
    "voice": "语速平稳，声音低沉",
    "music": "紧张的背景音乐持续",
