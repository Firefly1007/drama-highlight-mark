  {
    "id": 3,
    "start": "00:00:08.070",
    "end": "00:00:11.760",
    "text": "我都说了是我自愿的，怎么会是强迫？",
    "speech": "单人发言",
    "emotion": "态度坚决",
    "voice": "语气清晰有力",
    "music": "低沉悬疑的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 4,
    "start": "00:00:12.730",
    "end": "00:00:16.360",
    "text": "江清池你胡说什么呀，你喜欢的不是我吗？",
