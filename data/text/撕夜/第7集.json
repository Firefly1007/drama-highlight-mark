  {
    "id": 2,
    "start": "00:00:06.300",
    "end": "00:00:10.000",
    "text": "叶芷，你说话呀，你到底什么意思啊？",
    "speech": "单人发言",
    "emotion": "情绪激动",
    "voice": "音量拔高，语速急促",
    "music": "流行抒情背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 3,
    "start": "00:00:10.600",
    "end": "00:00:14.700",
    "text": "叶俊良，我说得很清楚了，我不喜欢你。",
    "speech": "单人发言",
    "emotion": "态度决绝",
    "voice": "语气坚定清晰",
    "music": "流行抒情背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 4,
    "start": "00:00:14.800",
    "end": "00:00:25.700",
    "text": "你不喜欢我？那你明里暗里的跟我表白算什么？你送我的花，给我做的饭又算什么呢？我现在好不容易答应你了，你给我玩什么欲擒故纵呢？",
    "speech": "单人发言",
    "emotion": "愤怒不解",
    "voice": "音量持续升高，语气带着质问",
    "music": "流行抒情背景音乐持续",
    "audio_cues": [
