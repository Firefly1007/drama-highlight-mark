    ],
    "uncertainty": ""
  },
  {
    "id": 5,
    "start": "00:00:27.200",
    "end": "00:00:35.400",
    "text": "以前是我眼瞎，我现在只想跟楚晨安在一起，我要跟他结婚。",
    "speech": "单人发言",
    "emotion": "态度坚决",
    "voice": "语速平稳，语气笃定",
    "music": "流行抒情背景音乐持续",
