[
  {
    "id": 1,
    "start": "00:00:00.000",
    "end": "00:00:07.000",
    "text": "这个江清池到底什么意思呀？这个时候给我装什么清纯？",
    "speech": "单人发言",
    "emotion": "不满",
    "voice": "语气带着质问与烦躁",
    "music": "低沉压抑的悬疑背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 2,
    "start": "00:00:07.400",
    "end": "00:00:12.000",
    "text": "她要是真的跟那个楚晨安在一起，那我们岂不是股份更要不回来了？",
    "speech": "单人发言",
    "emotion": "慌张焦虑",
    "voice": "语速偏快，语气急切",
    "music": "低沉压抑的悬疑背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 3,
    "start": "00:00:13.000",
    "end": "00:00:22.500",
    "text": "本来还想让她多活一段时间，既然如此，那便一不做，二不休。",
    "speech": "单人发言",
    "emotion": "阴狠决绝",
    "voice": "语调缓慢，透着冷酷的算计感",
    "music": "背景音乐节奏加快，紧张感升级",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 4,
    "start": "00:00:24.000",
    "end": "00:00:26.000",
    "text": "想办法把她骗出来。",
    "speech": "单人发言",
    "emotion": "冷静阴鸷",
    "voice": "压低声音，语气暗藏阴谋",
    "music": "紧张的背景音乐持续推进",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 5,
    "start": "00:00:30.000",
    "end": "00:00:43.000",
    "text": "给，你爱的咖啡。",
    "speech": "单人发言",
    "emotion": "平和自然",
    "voice": "语气温柔，带着日常的亲昵感",
    "music": "舒缓轻柔的钢琴背景音乐响起",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 6,
    "start": "00:00:47.000",
    "end": "00:01:07.000",
    "text": "你记得我喜欢喝什么？阿芷，你要是再不听话，我就把这咖啡液注射到你血管里，然后跟你一块去死。",
    "speech": "单人发言",
    "emotion": "偏执疯狂",
    "voice": "语气骤然转冷，带着强烈的威胁感",
    "music": "背景音乐从舒缓转为诡异紧绷",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 7,
    "start": "00:01:21.000",
    "end": "00:01:22.000",
    "text": "楚言。",
    "speech": "单人发言",
    "emotion": "情绪激动",
    "voice": "大声呼喊",
    "music": "诡异的背景音乐短暂停顿",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 8,
    "start": "00:01:27.000",
    "end": "00:01:32.000",
    "text": "你怕我下毒？还是，还是小心点好。",
    "speech": "双人轮流对话",
    "emotion": "一方淡然，另一方带着警惕",
    "voice": "对话节奏平缓，暗藏试探",
    "music": "轻柔的钢琴旋律重新响起",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 9,
    "start": "00:01:33.000",
    "end": "00:01:40.000",
    "text": "果然冰冻三尺非一日之寒，我忽然对楚晨安转变态度，任谁都会怀疑。",
    "speech": "单人内心独白",
    "emotion": "冷静自省",
    "voice": "语调平缓，带着沉思感",
    "music": "轻柔的钢琴背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 10,
    "start": "00:01:42.000",
    "end": "00:02:02.000",
    "text": "没关系，要是能死在阿芷手里，倒也不错啊。我去趟公司。",
    "speech": "双人轮流对话",
    "emotion": "一方带着释然感，另一方流露不舍",
    "voice": "对话氛围柔和，带着淡淡的温情",
    "music": "背景音乐加入轻缓的吉他旋律",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 11,
    "start": "00:02:02.000",
    "end": "00:02:10.000",
    "text": "那你什么时候回来？晚点回来，要去谈几个项目，怎么了？",
    "speech": "双人轮流对话",
    "emotion": "一方带着关切，另一方语气随意",
    "voice": "日常对话的自然节奏",
    "music": "轻缓的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 12,
    "start": "00:02:11.000",
    "end": "00:02:18.000",
    "text": "那你快点，我等你回来。你最好是乖乖的。",
    "speech": "双人轮流对话",
    "emotion": "一方带着娇嗔，另一方暗藏警告",
    "voice": "语气亲昵中带着一丝强势",
    "music": "轻缓的背景音乐持续推进",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 13,
    "start": "00:02:35.000",
    "end": "00:02:42.000",
    "text": "喂，喂，清芷，爸妈晕倒了你赶紧过来啊！什么？",
    "speech": "双人电话对话",
    "emotion": "一方焦急万分，另一方震惊错愕",
    "voice": "电话那头语速急促，接电话的人声音陡然拔高",
    "music": "背景音乐骤然切换为急促紧张的风格",
    "audio_cues": [],
    "uncertainty": ""
  }
]