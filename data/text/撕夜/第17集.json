[
  {
    "id": 1,
    "start": "00:00:00.000",
    "end": "00:00:08.400",
    "text": "真的不用我陪你进去吗？",
    "speech": "单人发言",
    "emotion": "温和关切",
    "voice": "语调平稳，音量适中",
    "music": "轻柔的钢琴背景音乐",
    "audio_cues": [
