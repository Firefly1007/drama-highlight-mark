    ],
    "uncertainty": ""
  },
  {
    "id": 2,
    "start": "00:00:09.300",
    "end": "00:00:11.300",
    "text": "我就去取咱妈妈的遗像。",
    "speech": "单人发言",
    "emotion": "平静略带低落",
    "voice": "语速偏缓，声音轻柔",
    "music": "轻柔的钢琴背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 3,
    "start": "00:00:15.100",
    "end": "00:00:17.500",
    "text": "那我很快结束，然后回来接你。",
    "speech": "单人发言",
    "emotion": "温柔体贴",
    "voice": "语气笃定",
    "music": "轻柔的钢琴背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 4,
    "start": "00:00:19.700",
    "end": "00:00:22.000",
    "text": "工作要紧，你路上小心。",
    "speech": "单人发言",
    "emotion": "平和叮嘱",
    "voice": "语调舒缓",
    "music": "轻柔的钢琴背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 5,
    "start": "00:00:26.400",
    "end": "00:00:35.000",
    "text": "一个小时之前，我们已经是合法夫妻了。老婆，别再想跑。",
    "speech": "单人发言",
    "emotion": "带着笑意的认真",
    "voice": "语气宠溺",
    "music": "轻柔的钢琴背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 6,
    "start": "00:00:40.700",
    "end": "00:00:47.400",
    "text": "知道了，老公。新婚快乐。",
    "speech": "单人发言",
    "emotion": "柔和带笑意",
    "voice": "声音甜美",
    "music": "钢琴旋律加入弦乐，氛围渐暖",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 7,
    "start": "00:01:01.700",
    "end": "00:01:09.500",
    "text": "哟，这江家二小姐出去鬼混了那么多天，还知道回家呢？",
    "speech": "单人发言",
    "emotion": "嘲讽尖锐",
    "voice": "语调拔高，语气刻薄",
    "music": "音乐转为带有悬疑感的钢琴独奏",
    "audio_cues": [
      "脚步声",
      "开门声"
    ],
    "uncertainty": ""
  },
  {
    "id": 8,
    "start": "00:01:10.700",
    "end": "00:01:15.800",
    "text": "江家哪来的二小姐？我妈明媒正娶，只生了我一个。",
    "speech": "单人发言",
    "emotion": "冷静反击",
    "voice": "语速平稳，态度坚定",
    "music": "悬疑感的钢琴背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 9,
    "start": "00:01:16.000",
    "end": "00:01:24.300",
    "text": "你，哎小妈，你这项链挺好看啊，最新的情侣款。",
    "speech": "单人发言",
    "emotion": "从容戏谑",
    "voice": "语气带着调侃",
    "music": "悬疑感的钢琴背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 10,
    "start": "00:01:26.500",
    "end": "00:01:30.000",
    "text": "什么情侣款，我自己戴着玩的。",
    "speech": "单人发言",
    "emotion": "慌张尴尬",
    "voice": "笑声僵硬，语气局促",
    "music": "悬疑感的钢琴背景音乐持续",
    "audio_cues": [
      "不自然的干笑声"
    ],
    "uncertainty": ""
  },
  {
    "id": 11,
    "start": "00:01:32.300",
    "end": "00:01:44.000",
    "text": "清芷，清芷，你怎么突然回来了？是不是那个沈承安不要你了？没有关系，你回到我身边，我要你啊。",
    "speech": "单人发言",
    "emotion": "轻浮得意",
    "voice": "语气油滑",
    "music": "音乐节奏加快，紧张感上升",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 12,
    "start": "00:01:51.200",
    "end": "00:01:56.700",
    "text": "哎清芷，你，哼，有妈生没妈养的东西。",
    "speech": "多人先后发言",
    "emotion": "先后带着错愕与恶毒",
    "voice": "先后出现惊讶的语气与狠厉的语调",
    "music": "紧张的背景音乐骤停",
    "audio_cues": [
      "脚步声"
    ],
    "uncertainty": ""
  },
  {
    "id": 13,
    "start": "00:02:16.100",
    "end": "00:02:22.100",
    "text": "妈，我带你回，真正属于我们的家。",
    "speech": "单人发言",
    "emotion": "深情坚定",
    "voice": "语速放缓，声音饱含情绪",
    "music": "舒缓且带有温情的钢琴背景音乐响起",
    "audio_cues": [],
