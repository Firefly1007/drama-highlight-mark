    ],
    "uncertainty": ""
  },
  {
    "id": 4,
    "start": "00:00:21.770",
    "end": "00:00:24.060",
    "text": "长安，有没有事？哪里受伤了？",
    "speech": "单人发言",
    "emotion": "焦急关切",
    "voice": "语速偏快，语气急切",
    "music": "背景音乐转为舒缓",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 5,
    "start": "00:00:24.530",
    "end": "00:00:26.070",
    "text": "你是来陪我一起死的？",
    "speech": "单人发言",
    "emotion": "虚弱",
    "voice": "声音微弱，气息不稳",
    "music": "舒缓的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 6,
    "start": "00:00:26.330",
    "end": "00:00:29.610",
    "text": "谁说要陪你死，我是来救你的。",
    "speech": "单人发言",
    "emotion": "坚定",
    "voice": "语气笃定有力",
    "music": "舒缓的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 7,
    "start": "00:00:31.070",
    "end": "00:00:40.450",
    "text": "你应该希望我早点死，这样你就可以自由了，反正你也不喜欢我。",
    "speech": "单人发言",
    "emotion": "低落自嘲",
    "voice": "语速缓慢，语气无力",
    "music": "舒缓的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 8,
    "start": "00:00:41.110",
    "end": "00:00:47.770",
    "text": "沈长安，你要是再说这种话，我真的就不理你了，这辈子我要我们一起活下去。",
    "speech": "单人发言",
    "emotion": "带着嗔怪的坚定",
    "voice": "语气郑重，音量适中",
    "music": "舒缓的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 9,
    "start": "00:00:55.820",
    "end": "00:01:00.410",
