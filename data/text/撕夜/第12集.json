    "uncertainty": ""
  },
  {
    "id": 3,
    "start": "00:00:17.700",
    "end": "00:00:21.460",
    "text": "啊，来一个陪你的。",
    "speech": "多人重叠",
    "emotion": "混杂",
    "voice": "多人声音交织",
    "music": "紧张悬疑的背景音乐持续",
