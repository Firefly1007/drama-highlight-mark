[
  {
    "id": 1,
    "start": "00:00:00.000",
    "end": "00:00:03.130",
    "text": "我现在就送你上路。",
    "speech": "单人发言",
    "emotion": "狠厉",
    "voice": "语调狠厉，音量偏高",
    "music": "",
