    "uncertainty": ""
  },
  {
    "id": 2,
    "start": "00:00:03.340",
    "end": "00:00:12.710",
    "text": "我靠，妈的，谁他妈打我？谁？给老子滚出来！",
    "speech": "单人发言",
    "emotion": "暴怒",
    "voice": "大声吼叫，语气暴躁",
    "music": "紧张悬疑的背景音乐",
