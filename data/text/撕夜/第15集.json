    "start": "00:00:03.280",
    "end": "00:00:04.870",
    "text": "还好送回来的及时。",
    "speech": "单人发言",
    "emotion": "平静",
    "voice": "语气沉稳",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 3,
    "start": "00:00:09.030",
    "end": "00:00:09.550",
    "text": "疼吗？",
    "speech": "单人发言",
    "emotion": "关切",
