[
  {
    "id": 1,
    "start": "00:00:05.920",
    "end": "00:00:06.670",
    "text": "清池。",
    "speech": "单人发言",
    "emotion": "",
    "voice": "语速较快，音量平稳",
    "music": "以弦乐为主的低沉悬疑背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 2,
    "start": "00:00:07.080",
    "end": "00:00:11.580",
    "text": "站住，拿你母亲遗像干嘛，要去哪啊？",
    "speech": "单人发言",
    "emotion": "语气严厉",
    "voice": "音量拔高，语气严肃",
    "music": "以弦乐为主的低沉悬疑背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 3,
    "start": "00:00:13.620",
    "end": "00:00:21.170",
    "text": "清池，是不是我做了哪里不好让你生气了，要不我们坐下来好好聊一聊，嗯？",
    "speech": "单人发言",
    "emotion": "语气带着讨好和试探",
    "voice": "语速放缓，音量适中",
    "music": "以弦乐为主的低沉悬疑背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 4,
    "start": "00:00:21.520",
    "end": "00:00:30.820",
    "text": "就是呀，有什么话坐下来好好说嘛，你追着俊良这么久，我跟你爸早就把她当成半个女",
    "speech": "单人发言",
    "emotion": "语气亲和",
    "voice": "语调柔和",
    "music": "以弦乐为主的低沉悬疑背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 5,
    "start": "00:00:30.940",
    "end": "00:00:32.540",
    "text": "婿了，哈哈哈。",
    "speech": "单人发言",
    "emotion": "带着笑意",
    "voice": "伴随笑声",
    "music": "以弦乐为主的低沉悬疑背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 6,
    "start": "00:00:45.410",
    "end": "00:00:49.540",
    "text": "好啊，那我就一次性把话都说明白。",
    "speech": "单人发言",
    "emotion": "语气冷静决绝",
    "voice": "语速平稳，音量清晰",
    "music": "以弦乐为主的低沉悬疑背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 7,
    "start": "00:00:58.820",
    "end": "00:01:13.010",
    "text": "我妈生前将山语集团百分之一百的股份都留给了我，并且要求只要我还活着，这笔股份只能转赠，任何人不能继承。",
    "speech": "单人发言",
    "emotion": "语气坚定",
    "voice": "语速平缓，咬字清晰有力",
    "music": "以弦乐为主的低沉悬疑背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 8,
    "start": "00:01:13.620",
    "end": "00:01:17.310",
    "text": "你母亲头发长见识短，你哪有能力管理公司啊？",
    "speech": "单人发言",
    "emotion": "语气轻蔑且带着怒气",
    "voice": "音量明显拔高",
    "music": "以弦乐为主的低沉悬疑背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 9,
    "start": "00:01:17.880",
    "end": "00:01:22.270",
    "text": "所以，我决定将这笔股份赠与我的丈夫。",
    "speech": "单人发言",
    "emotion": "语气果断",
    "voice": "语速平稳，态度强硬",
    "music": "以弦乐为主的低沉悬疑背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 10,
    "start": "00:01:26.830",
    "end": "00:01:29.120",
    "text": "清池，我就知道你……",
    "speech": "单人发言",
    "emotion": "语气带着惊喜",
    "voice": "语速偏快",
    "music": "以强烈节奏鼓点和合成器音效为主的紧张动感背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 11,
    "start": "00:01:29.180",
    "end": "00:01:34.770",
    "text": "俊良，你在我们家干嘛呀，你自己没有家吗？",
    "speech": "单人发言",
    "emotion": "语气疏离冷淡",
    "voice": "语速平缓，语调冰冷",
    "music": "以强烈节奏鼓点和合成器音效为主的紧张动感背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 12,
    "start": "00:01:37.140",
    "end": "00:01:41.270",
    "text": "你这话什么意思呀，我在这儿不是为了等你吗？",
    "speech": "单人发言",
    "emotion": "语气带着不解和委屈",
    "voice": "音量稍提高",
    "music": "以强烈节奏鼓点和合成器音效为主的紧张动感背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 13,
    "start": "00:01:41.710",
    "end": "00:01:44.580",
    "text": "可是我不是跟你说过了吗，我不喜欢你。",
    "speech": "单人发言",
    "emotion": "语气坚决",
    "voice": "语速平稳，态度明确",
    "music": "以强烈节奏鼓点和合成器音效为主的紧张动感背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 14,
    "start": "00:01:45.730",
    "end": "00:01:52.070",
    "text": "江清池，你是不是还和楚承安在一起呢，他就是个恶魔，他迟早玩死你的！",
    "speech": "单人发言",
    "emotion": "语气激动且带着恐慌",
    "voice": "语速加快，音量拔高",
    "music": "以强烈节奏鼓点和合成器音效为主的紧张动感背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 15,
    "start": "00:01:52.600",
    "end": "00:01:56.530",
    "text": "那你就当我口味独特，喜欢冰月了。",
    "speech": "单人发言",
    "emotion": "语气带着挑衅",
    "voice": "语速平缓，语调淡然",
    "music": "以强烈节奏鼓点和合成器音效为主的紧张动感背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 16,
    "start": "00:01:56.770",
    "end": "00:01:57.780",
    "text": "江清池你！",
    "speech": "单人发言",
    "emotion": "语气愤怒",
    "voice": "音量拔高",
    "music": "以强烈节奏鼓点和合成器音效为主的紧张动感背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 17,
    "start": "00:01:59.230",
    "end": "00:02:03.530",
    "text": "清池，你跟那个楚承安，到底发展到哪一步了？",
    "speech": "单人发言",
    "emotion": "语气严厉质问",
    "voice": "语速沉稳，音量威严",
    "music": "以强烈节奏鼓点和合成器音效为主的紧张动感背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 18,
    "start": "00:02:10.160",
    "end": "00:02:11.040",
    "text": "我们结婚了。",
    "speech": "单人发言",
    "emotion": "语气平静却极具冲击力",
    "voice": "语速平缓，语调清晰",
    "music": "以强烈节奏鼓点和合成器音效为主的紧张动感背景音乐",
