    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 3,
    "start": "00:00:12.760",
    "end": "00:00:17.390",
    "text": "如果可以，我想跟你结婚。",
    "speech": "单人发言",
    "emotion": "",
    "voice": "",
