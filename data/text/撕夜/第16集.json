    "start": "00:00:24.110",
    "end": "00:00:24.780",
    "text": "为什么？",
    "speech": "单人发言",
    "emotion": "",
    "voice": "",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 5,
    "start": "00:00:29.610",
    "end": "00:00:39.300",
    "text": "因为我离开你，我就会死。如果我死了，你也不会独活。",
    "speech": "单人发言",
    "emotion": "",
    "voice": "",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 6,
    "start": "00:00:44.550",
    "end": "00:00:46.840",
    "text": "你凭什么觉得我会跟你一起死？",
    "speech": "单人发言",
    "emotion": "",
    "voice": "",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 7,
    "start": "00:00:49.810",
    "end": "00:00:50.670",
    "text": "你会吗？",
    "speech": "单人发言",
    "emotion": "",
    "voice": "",
