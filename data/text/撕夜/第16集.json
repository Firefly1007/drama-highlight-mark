    "uncertainty": ""
  },
  {
    "id": 2,
    "start": "00:00:07.910",
    "end": "00:00:09.590",
    "text": "你知道你刚刚说了什么。",
    "speech": "单人发言",
    "emotion": "",
    "voice": "",
