[
  {
    "id": 1,
    "start": "00:00:03.840",
    "end": "00:00:05.510",
    "text": "哪个喊你动我衣服的？",
    "speech": "单人发言",
    "emotion": "略带生气",
    "voice": "音量偏高，语气直接",
    "music": "轻快的背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 2,
    "start": "00:00:05.620",
    "end": "00:00:12.380",
    "text": "啊，孙娃儿，我是想，没事嘛。",
    "speech": "单人发言",
    "emotion": "慌乱",
    "voice": "语速稍快，带着慌乱感",
    "music": "轻快的背景音乐",
    "audio_cues": [
      "连续的打喷嚏声"
    ],
    "uncertainty": ""
  },
  {
    "id": 3,
    "start": "00:00:16.080",
    "end": "00:00:18.170",
    "text": "你是不是悄咪咪在心里头诀我了？",
    "speech": "单人发言",
    "emotion": "怀疑",
    "voice": "语气带着质问感",
    "music": "轻快的背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 4,
    "start": "00:00:18.920",
    "end": "00:00:19.720",
    "text": "我。",
    "speech": "单人发言",
    "emotion": "迟疑",
    "voice": "声音较小，吞吞吐吐",
    "music": "轻快的背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 5,
    "start": "00:00:20.740",
    "end": "00:00:28.330",
    "text": "啥子嘛，是我诀的你，你只敢对我妈妈歪，妈，走，我们两个去外头晒太阳。",
    "speech": "单人发言",
    "emotion": "理直气壮",
    "voice": "音量大，语气带着孩子气的强硬",
    "music": "轻快的背景音乐",
    "audio_cues": [
      "脚步声"
    ],
    "uncertainty": ""
  },
  {
    "id": 6,
    "start": "00:00:31.230",
    "end": "00:00:41.030",
    "text": "哎，哎等下等下，嘿，这柜子上的锁咋都能动了？",
    "speech": "单人发言",
    "emotion": "疑惑",
    "voice": "语气带着惊讶和不解",
    "music": "轻快的背景音乐",
    "audio_cues": [
      "脚步声",
      "金属锁具转动的声音"
    ],
    "uncertainty": ""
  },
  {
    "id": 7,
    "start": "00:00:44.400",
    "end": "00:00:48.130",
    "text": "我铺盖耶，你做啥子啊？",
    "speech": "单人发言",
    "emotion": "激动",
    "voice": "音量突然拔高，情绪激动",
    "music": "背景音乐转为带有紧张感的旋律",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 8,
    "start": "00:00:48.620",
    "end": "00:00:49.990",
    "text": "啥子铺盖？",
    "speech": "单人发言",
    "emotion": "茫然",
    "voice": "语气带着疑惑",
    "music": "带有紧张感的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 9,
    "start": "00:00:50.300",
    "end": "00:00:57.130",
    "text": "哎呀这是我的嫁妆铺盖，新丝棉做的，你看这棉花是今年新弹进去的。",
    "speech": "单人发言",
    "emotion": "心疼又着急",
    "voice": "语速偏快，带着惋惜的情绪",
    "music": "带有紧张感的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 10,
    "start": "00:00:57.320",
    "end": "00:01:06.330",
    "text": "哎，哦豁，我昨天好像看到奶奶从屋头拿了个大东西走。",
    "speech": "单人发言",
    "emotion": "恍然大悟",
    "voice": "语气从叹气转为突然想起事情的恍然感",
    "music": "带有紧张感的背景音乐持续",
    "audio_cues": [
      "翻动布料的声响"
    ],
    "uncertainty": ""
  },
  {
    "id": 11,
    "start": "00:01:14.200",
    "end": "00:01:21.730",
    "text": "我看她是粪坑头游泳，不怕死，老太婆尖尖脚，我去来了跑不脱。",
    "speech": "单人发言",
    "emotion": "愤怒",
    "voice": "语气强硬，带着怒气",
    "music": "节奏强烈的背景音乐",
    "audio_cues": [
      "脚步声"
    ],
    "uncertainty": ""
  }
