  {
    "id": 39,
    "start": "00:03:00.000",
    "end": "00:03:04.000",
    "text": "三哥，你没事吧？让我看看。",
    "speech": "单人发言",
    "emotion": "语气关切",
    "voice": "音量适中，语速正常",
    "music": "紧张悬疑的背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 40,
    "start": "00:03:04.000",
