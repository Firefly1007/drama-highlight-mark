    ],
    "uncertainty": ""
  },
  {
    "id": 14,
    "start": "00:01:25.830",
    "end": "00:01:27.030",
    "text": "我又想起，哎等等等等等。",
    "speech": "单人发言",
    "emotion": "慌张阻止",
    "voice": "语气急切慌乱",
    "music": "节奏轻快诙谐的背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 15,
    "start": "00:01:31.360",
    "end": "00:01:36.280",
    "text": "你先给我说一下，你这次想起来的，还是我吗？",
    "speech": "单人发言",
    "emotion": "忐忑不安",
    "voice": "语气带着试探和紧张",
    "music": "节奏轻快诙谐的背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 16,
    "start": "00:01:37.110",
    "end": "00:01:38.330",
    "text": "这次是大哥的事。",
    "speech": "单人发言",
    "emotion": "笃定",
    "voice": "语气肯定",
    "music": "节奏轻快诙谐的背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 17,
    "start": "00:01:38.530",
    "end": "00:01:44.930",
    "text": "好，那就请你大声的说出来吧！",
    "speech": "多人轮流发言",
    "emotion": "从放松转为激动催促",
    "voice": "语气从放松转为大声催促",
    "music": "节奏轻快诙谐的背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 18,
    "start": "00:01:45.730",
    "end": "00:01:54.170",
    "text": "大哥，你还记得有一年，你内裤被放了辣椒粉，屁股辣了三天三夜吗？",
    "speech": "单人发言",
    "emotion": "带着调侃的回忆感",
    "voice": "语速平缓，带有戏剧性",
    "music": "节奏轻快诙谐的背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 19,
    "start": "00:01:55.330",
    "end": "00:01:58.110",
    "text": "哈哈哈，你这都记得呢？",
    "speech": "单人发言",
    "emotion": "哭笑不得",
    "voice": "带着无奈的笑意",
    "music": "节奏轻快诙谐的背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 20,
    "start": "00:02:00.300",
    "end": "00:02:03.170",
    "text": "没错，就是阿也放的。",
    "speech": "单人发言",
    "emotion": "笃定",
    "voice": "语气肯定",
    "music": "节奏轻快诙谐的背景音乐",
    "audio_cues": [
