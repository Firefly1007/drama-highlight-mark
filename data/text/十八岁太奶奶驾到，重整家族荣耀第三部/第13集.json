    "speech": "单人发言",
    "emotion": "慌张恳求",
    "voice": "语气带着讨好和慌乱",
    "music": "节奏轻快诙谐的背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 4,
    "start": "00:00:27.520",
    "end": "00:00:31.440",
