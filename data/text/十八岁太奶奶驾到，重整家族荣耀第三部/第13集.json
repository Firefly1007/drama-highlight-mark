  {
    "id": 25,
    "start": "00:02:36.400",
    "end": "00:02:40.190",
    "text": "啊，上半身打的基础，下半身就不基础。",
    "speech": "单人发言",
    "emotion": "一本正经",
    "voice": "语气平缓",
    "music": "节奏轻快诙谐的背景音乐",
    "audio_cues": [
      "卡通音效"
