[
  {
    "id": 1,
    "start": "00:00:00.000",
    "end": "00:00:13.300",
    "text": "我想起来阿也小时候，偷偷砸了爷爷盘了三年的核桃，然后骗他说是被狗叼走了。",
    "speech": "单人发言",
    "emotion": "平静中带着回忆感",
    "voice": "语速平缓，带有回忆的叙述感",
    "music": "低沉的悬疑背景音乐",
    "audio_cues": [
