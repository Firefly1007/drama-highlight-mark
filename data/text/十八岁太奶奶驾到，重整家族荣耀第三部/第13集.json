    ],
    "uncertainty": ""
  },
  {
    "id": 2,
    "start": "00:00:20.780",
    "end": "00:00:23.070",
    "text": "原来是你这个狗东西啊！",
    "speech": "单人发言",
    "emotion": "愤怒",
