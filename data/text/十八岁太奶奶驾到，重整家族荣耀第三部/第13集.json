    ],
    "uncertainty": ""
  },
  {
    "id": 8,
    "start": "00:00:44.830",
    "end": "00:00:46.250",
    "text": "我又想起来了。",
    "speech": "单人发言",
    "emotion": "突然想起事情的错愕",
    "voice": "语气带着震惊",
    "music": "节奏轻快诙谐的背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 9,
    "start": "00:00:47.010",
    "end": "00:00:48.060",
    "text": "又想起什么了？",
    "speech": "单人发言",
    "emotion": "急切追问",
    "voice": "语气带着好奇和催促",
    "music": "节奏轻快诙谐的背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 10,
    "start": "00:00:51.220",
    "end": "00:01:05.670",
    "text": "阿也小时候有一次尿急，就往桌上的杯子里尿尿，爷爷你问到底是什么东西，他骗您说那是放久了的冰红茶，您一口就给干了。",
    "speech": "单人发言",
    "emotion": "哭笑不得",
    "voice": "语速适中，带着讲述往事的戏剧性",
    "music": "节奏轻快诙谐的背景音乐",
    "audio_cues": [
      "羊叫声",
      "呕吐声"
    ],
    "uncertainty": ""
  },
  {
    "id": 11,
    "start": "00:01:10.400",
    "end": "00:01:14.070",
    "text": "你给我回来，你个小兔崽子，我今天不打死你！",
    "speech": "多人重叠发言",
    "emotion": "多人情绪激烈，以愤怒喊叫为主",
    "voice": "多人声音重叠，语气激动",
    "music": "节奏轻快诙谐的背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 12,
    "start": "00:01:14.070",
    "end": "00:01:18.310",
    "text": "啊呀呀呀呀，你肝火太旺了，多吃点丝娃娃败败火。",
    "speech": "多人重叠发言",
    "emotion": "多人情绪激烈，以愤怒喊叫为主",
    "voice": "多人声音重叠，语气激动",
    "music": "节奏轻快诙谐的背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 13,
    "start": "00:01:19.070",
    "end": "00:01:19.980",
    "text": "第三针。",
    "speech": "单人发言",
    "emotion": "冷静",
    "voice": "语气平稳清晰",
    "music": "节奏轻快诙谐的背景音乐",
    "audio_cues": [
