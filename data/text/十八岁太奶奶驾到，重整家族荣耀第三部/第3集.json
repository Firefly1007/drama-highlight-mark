    ],
    "uncertainty": ""
  },
  {
    "id": 2,
    "start": "00:00:03.600",
    "end": "00:00:11.599",
    "text": "对，怎么样？",
    "speech": "单人发言",
    "emotion": "关切",
    "voice": "语气低沉",
    "music": "轻柔舒缓的钢琴背景音乐响起",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 3,
    "start": "00:00:15.450",
    "end": "00:00:30.196",
    "text": "哎呀，这三少爷，这是创伤后器质性的精神障碍，伴随着严重的智力损伤，他现在的智商啊，只有五岁孩子的水平，可能下半辈子就这样了。",
    "speech": "单人发言",
    "emotion": "略带惋惜",
    "voice": "语速放缓，语气凝重",
    "music": "钢琴背景音乐持续",
    "audio_cues": [
      "塑料类物件的细碎声响"
    ],
    "uncertainty": ""
  },
  {
    "id": 4,
    "start": "00:00:30.300",
    "end": "00:00:39.534",
    "text": "啊？老三这就傻了？啊？",
    "speech": "单人发言",
    "emotion": "震惊，难以置信",
    "voice": "声音拔高，带着颤抖的惊呼",
    "music": "钢琴背景音乐持续",
    "audio_cues": [
      "多人笑声"
    ],
    "uncertainty": ""
  },
  {
    "id": 5,
    "start": "00:00:39.700",
    "end": "00:00:41.583",
    "text": "天呐，老三怎么办呢？",
    "speech": "单人发言",
    "emotion": "慌乱无助",
    "voice": "语气焦急",
    "music": "钢琴背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 6,
    "start": "00:00:41.600",
    "end": "00:00:43.772",
    "text": "英宝，冷静点。",
    "speech": "单人发言",
    "emotion": "沉稳镇定",
    "voice": "语调平稳",
    "music": "钢琴背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 7,
    "start": "00:00:44.500",
    "end": "00:00:49.630",
    "text": "妈妈，还是您淡定，我我扛不住事啊。",
    "speech": "单人发言",
    "emotion": "情绪崩溃",
    "voice": "声音带着哭腔，磕磕巴巴",
    "music": "钢琴背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 8,
    "start": "00:00:50.500",
    "end": "00:00:57.433",
    "text": "不是什么大问题，只需要连续针灸七七四十九天，即可完全恢复正常。",
    "speech": "单人发言",
    "emotion": "自信从容",
    "voice": "语速平稳，语气笃定",
    "music": "转为带有节奏的轻快背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 9,
    "start": "00:00:57.700",
    "end": "00:01:01.732",
    "text": "你一个小姑娘说什么大话啊，谁会相信呢？",
    "speech": "单人发言",
    "emotion": "轻视质疑",
    "voice": "语气带着嘲讽",
    "music": "轻快的背景音乐持续",
    "audio_cues": [
      "笑声"
    ],
    "uncertainty": ""
  },
  {
    "id": 10,
    "start": "00:01:02.000",
    "end": "00:01:06.733",
    "text": "哈哈，太好了，老三有救了，老三有救了！",
    "speech": "单人发言",
    "emotion": "欣喜若狂",
    "voice": "音量明显提高，语气激动",
    "music": "轻快的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 11,
    "start": "00:01:07.200",
    "end": "00:01:17.333",
    "text": "哎，季老先生，你们季家可是大家族啊，你们要相信医生嘛，我可是海城的第一西医啊。",
    "speech": "单人发言",
    "emotion": "急切辩解",
    "voice": "语速偏快，语气夸张",
    "music": "轻快的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 12,
    "start": "00:01:17.400",
    "end": "00:01:23.033",
    "text": "我跟你说啊，在这个家里，我只相信荣小姐，我就听荣小姐的话。",
    "speech": "单人发言",
    "emotion": "态度坚定",
    "voice": "语气果断",
    "music": "轻快的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 13,
    "start": "00:01:23.200",
    "end": "00:01:28.301",
    "text": "她，还是一婴儿肥的女娃，就把你们骗得服服帖帖的。",
    "speech": "单人发言",
    "emotion": "不屑",
    "voice": "语气充满鄙夷",
    "music": "轻快的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 14,
    "start": "00:01:28.400",
    "end": "00:01:37.432",
    "text": "怎么说话呢？哎？",
    "speech": "单人发言",
    "emotion": "略带愠怒",
    "voice": "语调上扬",
    "music": "背景音乐转为带有国风元素的动感配乐",
    "audio_cues": [
      "转场音效",
      "物品晃动的声响"
    ],
    "uncertainty": ""
  },
  {
    "id": 15,
    "start": "00:01:44.800",
    "end": "00:01:47.333",
    "text": "哎，你干嘛？",
    "speech": "单人发言",
    "emotion": "疑惑",
    "voice": "语气带着不解",
    "music": "国风动感配乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 16,
    "start": "00:01:48.100",
    "end": "00:01:50.833",
    "text": "好了，现在试试直起背。",
    "speech": "单人发言",
    "emotion": "平静",
    "voice": "语气淡然",
    "music": "国风动感配乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 17,
    "start": "00:01:53.100",
    "end": "00:02:01.766",
    "text": "我这驼背很多年了，根本就治不好，你以为你个小丫头，就能把我给治好了？",
    "speech": "单人发言",
    "emotion": "嘲讽",
    "voice": "语气夸张，充满戏谑",
    "music": "国风动感配乐持续",
    "audio_cues": [
      "衣物或身体活动的声响"
    ],
    "uncertainty": ""
  },
  {
    "id": 18,
    "start": "00:02:02.500",
    "end": "00:02:08.539",
    "text": "哎？哎哎哎？哎，哎好了，哈哈哈。",
    "speech": "多人重叠",
    "emotion": "极度震惊",
    "voice": "多人同时发出惊呼",
    "music": "国风动感配乐持续",
    "audio_cues": [
      "多人惊呼声",
      "拍手鼓掌的声响"
    ],
    "uncertainty": ""
  },
  {
    "id": 19,
    "start": "00:02:09.300",
    "end": "00:02:12.300",
    "text": "只是暂时缓解，回头再给你开些中药。",
    "speech": "单人发言",
    "emotion": "从容淡定",
    "voice": "语气平缓",
    "music": "国风动感配乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 20,
    "start": "00:02:12.800",
    "end": "00:02:29.066",
    "text": "哎呀，你看，我对你态度不端，你还给我诊治，哎呀，你的医术和格局，在我之上啊！哎呀，佩服佩服，季老先生，我告辞了，告辞了。哎呦，哈哈哈。",
    "speech": "单人发言",
    "emotion": "充满敬佩与尴尬",
    "voice": "语气热情又带着不好意思的笑意",
    "music": "国风动感配乐持续",
    "audio_cues": [
      "多人笑声"
    ],
    "uncertainty": ""
  },
  {
    "id": 21,
    "start": "00:02:29.200",
    "end": "00:02:35.333",
    "text": "拿捏了，我妈妈出身于中医世家，医术yyds。",
    "speech": "单人发言",
    "emotion": "自豪得意",
    "voice": "语气轻快",
    "music": "国风动感配乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 22,
    "start": "00:02:35.400",
    "end": "00:02:39.733",
    "text": "yyds，这下有了太奶奶，我们三哥终于有救了。",
    "speech": "单人发言",
    "emotion": "兴奋激动",
    "voice": "语气高昂",
    "music": "转为节奏强劲的英文流行歌曲",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 23,
    "start": "00:02:45.300",
    "end": "00:03:07.733",
    "text": "[英文演唱]",
    "speech": "单人演唱",
    "emotion": "深情",
    "voice": "男声磁性有力",
    "music": "英文流行歌曲持续播放",
    "audio_cues": [
      "卡通特效音"
    ],
    "uncertainty": ""
  },
  {
    "id": 24,
    "start": "00:03:10.000",
    "end": "00:03:20.700",
    "text": "小姐姐你真漂亮，涵涵的小汽车，能闪光能唱歌，你坐上来，涵涵带你去兜风。",
    "speech": "单人发言",
    "emotion": "天真",
    "voice": "语气稚嫩，语速缓慢",
    "music": "转为诙谐活泼的背景音乐",
    "audio_cues": [
      "卡通气泡音效"
    ],
    "uncertainty": ""
  },
  {
    "id": 25,
    "start": "00:03:21.300",
    "end": "00:03:31.067",
    "text": "什么呀这是？啊，都病成这个样子了啊，傻成这个程度还想着泡妞的事？他是你太奶奶，你尊重点！",
    "speech": "单人发言",
    "emotion": "无奈又生气",
    "voice": "语气拔高，带着训斥的意味",
    "music": "诙谐活泼的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 26,
    "start": "00:03:31.300",
    "end": "00:03:34.433",
    "text": "我的花，我的花。",
    "speech": "单人发言",
    "emotion": "委屈",
    "voice": "声音带着哭腔，语调可怜",
    "music": "诙谐活泼的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 27,
    "start": "00:03:36.000",
    "end": "00:03:42.733",
    "text": "看涵涵还有，姐姐想要多少，就有多少。",
    "speech": "单人发言",
    "emotion": "天真讨好",
    "voice": "语气稚嫩",
    "music": "诙谐活泼的背景音乐持续",
    "audio_cues": [
      "转场特效音"
    ],
    "uncertainty": ""
  },
  {
    "id": 28,
    "start": "00:03:42.900",
    "end": "00:03:46.700",
