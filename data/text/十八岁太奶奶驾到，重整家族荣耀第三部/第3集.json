    "speech": "单人发言",
    "emotion": "疑惑调侃",
    "voice": "语气带着猜测的意味",
    "music": "诙谐活泼的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 29,
    "start": "00:03:47.200",
    "end": "00:03:53.100",
