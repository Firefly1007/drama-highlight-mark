    "speech": "单人发言",
    "emotion": "略带嫌弃",
    "voice": "语气严肃",
    "music": "诙谐活泼的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 30,
    "start": "00:03:53.700",
