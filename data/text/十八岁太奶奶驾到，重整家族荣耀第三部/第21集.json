    ],
    "uncertainty": ""
  },
  {
    "id": 3,
    "start": "00:00:15.000",
    "end": "00:00:20.500",
    "text": "那我也发誓，如果这孩子是我的，我全家死光。",
    "speech": "单人发言",
    "emotion": "情绪激动",
    "voice": "语速较快，语气坚定",
