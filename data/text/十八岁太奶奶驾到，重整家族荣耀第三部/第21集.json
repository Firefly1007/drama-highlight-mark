    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 9,
    "start": "00:01:08.700",
    "end": "00:01:15.500",
    "text": "我这以前以为我跟我四哥是双节，没想到我们季家是一门三节啊。",
    "speech": "单人发言",
    "emotion": "情绪激动",
    "voice": "语气充满感慨",
    "music": "轻快诙谐的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 10,
    "start": "00:01:15.700",
    "end": "00:01:22.500",
