      "出现脚步声"
    ],
    "uncertainty": ""
  },
  {
    "id": 6,
    "start": "00:00:47.500",
    "end": "00:00:54.000",
    "text": "啊，走心不走肾？三弟，难道你？",
    "speech": "单人发言",
    "emotion": "充满震惊",
    "voice": "语气充满难以置信",
    "music": "轻快诙谐的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 7,
    "start": "00:00:55.700",
    "end": "00:01:01.500",
    "text": "脉象显示，确实是纯阳之体，未经阴阳调和。",
    "speech": "单人发言",
    "emotion": "语气平静",
    "voice": "语速平缓，语气笃定",
    "music": "轻快诙谐的背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
