[
  {
    "id": 1,
    "start": "00:00:00.000",
    "end": "00:00:03.000",
    "text": "快看，季家少爷们来了！",
    "speech": "单人发言",
    "emotion": "兴奋激动",
    "voice": "语速快，音量高，尾音上扬",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 2,
    "start": "00:00:03.000",
    "end": "00:00:19.000",
    "text": "",
    "speech": "",
    "emotion": "",
    "voice": "",
    "music": "动感节奏的流行音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 3,
    "start": "00:00:19.000",
    "end": "00:00:24.000",
    "text": "那不是季家大少爷，百亿集团总裁，季知渊吗？",
    "speech": "单人发言",
    "emotion": "惊讶，好奇",
    "voice": "语速中等，音量正常",
    "music": "背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 4,
    "start": "00:00:24.000",
    "end": "00:00:28.000",
    "text": "二少爷，二少爷是大满贯国际影帝，季天庭。",
    "speech": "单人发言",
    "emotion": "兴奋介绍",
    "voice": "语速快，音量提高",
    "music": "背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 5,
    "start": "00:00:28.000",
    "end": "00:00:31.000",
    "text": "哎，四少爷，海城中学校草，季景琛。",
    "speech": "单人发言",
    "emotion": "惊喜",
    "voice": "音量提高，尾音上扬",
    "music": "背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 6,
    "start": "00:00:31.000",
    "end": "00:00:41.000",
    "text": "小少爷……嗯……小少爷叫什么来着？",
    "speech": "单人发言",
    "emotion": "疑惑，迟疑",
    "voice": "语速变慢，有停顿",
    "music": "背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 7,
    "start": "00:00:41.000",
    "end": "00:00:51.000",
    "text": "季家世代书香门第，如今他们几个招摇过市，真是不肖子孙。",
    "speech": "单人发言",
    "emotion": "鄙夷，不屑",
    "voice": "语速平缓，语气轻蔑",
    "music": "背景音乐停止",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 8,
    "start": "00:00:51.000",
    "end": "00:00:56.000",
    "text": "你就酸吧，虽然你长得还不错，但一辈子都别想嫁入季家那样的豪门。",
    "speech": "单人发言",
    "emotion": "嘲讽，挑衅",
    "voice": "语速快，语气尖锐",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 9,
    "start": "00:00:56.000",
    "end": "00:01:00.000",
    "text": "",
    "speech": "",
    "emotion": "",
    "voice": "",
    "music": "",
    "audio_cues": [
      "低沉的笑声",
      "衣物摩擦声",
      "重物放置声"
    ],
    "uncertainty": ""
  },
  {
    "id": 10,
    "start": "00:01:00.000",
    "end": "00:01:04.000",
    "text": "把你们这些乱七八糟的东西都拿走。",
    "speech": "单人发言",
    "emotion": "平静，但带有不容置疑的威严",
    "voice": "语速平缓，音量适中",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 11,
    "start": "00:01:04.000",
    "end": "00:01:10.000",
    "text": "",
    "speech": "",
    "emotion": "",
    "voice": "",
    "music": "",
    "audio_cues": [
      "短暂的安静",
      "脚步声"
    ],
    "uncertainty": ""
  },
  {
    "id": 12,
    "start": "00:01:10.000",
    "end": "00:01:17.000",
    "text": "我不需要进季家，因为我在哪，季家就在哪。",
    "speech": "单人发言",
    "emotion": "自信，坚定",
    "voice": "语速慢，一字一顿，声音清亮有力",
    "music": "",
    "audio_cues": [
      "惊讶的吸气声"
    ],
    "uncertainty": ""
  },
  {
    "id": 13,
    "start": "00:01:17.000",
    "end": "00:01:22.000",
    "text": "怎么可能，季家家主明明是季老爷子。",
    "speech": "单人发言",
    "emotion": "难以置信，质疑",
    "voice": "语速快，音量提高",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 14,
    "start": "00:01:22.000",
    "end": "00:01:42.000",
    "text": "",
    "speech": "",
    "emotion": "",
    "voice": "",
    "music": "紧张悬疑的背景音乐",
    "audio_cues": [
      "汽车引擎声",
      "急刹车声",
      "车门开关声",
      "多人嘈杂声",
      "呼唤声"
    ],
    "uncertainty": ""
  },
  {
    "id": 15,
    "start": "00:01:42.000",
    "end": "00:01:54.000",
    "text": "妈妈！妈妈！妈妈！",
    "speech": "多人重叠",
    "emotion": "急切，担忧",
    "voice": "多人同时呼喊，音量高",
    "music": "悲伤的钢琴背景音乐",
    "audio_cues": [
      "汽车急刹声"
    ],
    "uncertainty": ""
  },
  {
    "id": 16,
    "start": "00:01:54.000",
    "end": "00:02:05.000",
    "text": "妈妈！",
    "speech": "单人发言",
    "emotion": "震惊，不可置信",
    "voice": "声音发颤，带着哭腔",
    "music": "悲伤的钢琴背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 17,
    "start": "00:02:05.000",
    "end": "00:02:12.000",
    "text": "我叫荣玉，是从1955年穿越而来。",
    "speech": "单人发言",
    "emotion": "平静，但略带疲惫和感慨",
    "voice": "语速缓慢，声音轻柔",
    "music": "悲伤的钢琴背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 18,
    "start": "00:02:12.000",
    "end": "00:02:16.000",
    "text": "现颁发，国家终身成就奖！",
    "speech": "单人发言",
    "emotion": "庄重，正式",
    "voice": "音量高，语速适中，有回声",
    "music": "",
    "audio_cues": [
      "掌声",
      "欢呼声"
    ],
    "uncertainty": ""
  },
  {
    "id": 19,
    "start": "00:02:16.000",
    "end": "00:02:22.000",
    "text": "",
    "speech": "",
    "emotion": "",
    "voice": "",
    "music": "",
    "audio_cues": [
      "刺耳的刹车声",
      "巨大的撞击声",
      "玻璃碎裂声"
    ],
    "uncertainty": ""
  },
  {
    "id": 20,
    "start": "00:02:22.000",
    "end": "00:02:34.000",
    "text": "当年我因意外去世，穿越到了70年后，同名同姓的18岁少女身上，重新遇见了我的儿子，和重孙子。",
    "speech": "单人发言",
    "emotion": "平静叙述，略带伤感",
    "voice": "语速缓慢，声音轻柔",
    "music": "舒缓的钢琴背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 21,
    "start": "00:02:34.000",
    "end": "00:02:37.000",
    "text": "今天第一天上学，你为什么迟到了？",
    "speech": "单人发言",
    "emotion": "质问，略带不满",
    "voice": "语速正常，语气严厉",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 22,
    "start": "00:02:37.000",
    "end": "00:02:39.000",
    "text": "我……",
    "speech": "单人发言",
    "emotion": "犹豫，语塞",
    "voice": "声音小，语速慢",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 23,
    "start": "00:02:39.000",
    "end": "00:02:43.000",
    "text": "还有你们几个，都是来干什么的？",
    "speech": "单人发言",
    "emotion": "严肃，质问",
    "voice": "音量提高，语气加重",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 24,
    "start": "00:02:43.000",
    "end": "00:02:49.000",
    "text": "太奶奶，今天是爷爷上老年大学的第一天，我们几个，一起陪您来送他。",
    "speech": "单人发言",
    "emotion": "解释，略带讨好",
    "voice": "语速快，语气轻松",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 25,
    "start": "00:02:49.000",
    "end": "00:02:54.000",
    "text": "妈妈，我能不能不上学？",
    "speech": "单人发言",
    "emotion": "恳求，撒娇",
    "voice": "音量变小，语速慢，尾音拖长",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 26,
    "start": "00:02:54.000",
    "end": "00:02:59.000",
    "text": "不行，你这孩子在家经常熬夜上网，为了身体这个学今天必须上。",
    "speech": "单人发言",
    "emotion": "坚决，不容商量",
    "voice": "语速正常，语气坚定",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 27,
    "start": "00:02:59.000",
    "end": "00:03:07.000",
    "text": "我害怕，我几十年没上学了，我紧张，我，我现在血压都高了，我晕。",
    "speech": "单人发言",
    "emotion": "夸张，装病",
    "voice": "语无伦次，声音发颤，有夸张的喘息声",
    "music": "",
    "audio_cues": [
      "夸张的咳嗽声"
    ],
    "uncertainty": ""
  },
  {
    "id": 28,
    "start": "00:03:07.000",
    "end": "00:03:11.000",
    "text": "你已经是个快80岁的大孩子了，好了，别闹了。",
    "speech": "单人发言",
    "emotion": "无奈，好笑",
    "voice": "语速正常，语气带着笑意",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 29,
    "start": "00:03:11.000",
    "end": "00:03:14.000",
    "text": "快点上学，上课好好听讲，不要交头接耳。",
    "speech": "单人发言",
    "emotion": "叮嘱，略带严肃",
    "voice": "语速快，语气认真",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 30,
    "start": "00:03:14.000",
    "end": "00:03:20.000",
    "text": "在校期间，不要追逐打闹啊，不要晚恋，啊？少喝点水，上课之前记得上厕所，不要尿裤子了。",
    "speech": "单人发言",
    "emotion": "唠叨，关爱",
    "voice": "语速慢，语气温和",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 31,
    "start": "00:03:20.000",
    "end": "00:03:24.000",
    "text": "我们开家长会，不要让我丢了面子啊。",
    "speech": "单人发言",
    "emotion": "半开玩笑，警告",
    "voice": "语速正常，语气轻松",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 32,
    "start": "00:03:24.000",
    "end": "00:03:30.000",
    "text": "你们瞪眼当心瞪是吧？哎，我可没说话。瞪啊，你再瞪我，你再瞪我我告诉你家长去，看他俩，怕他俩！",
    "speech": "多人重叠",
    "emotion": "争吵，嬉闹",
    "voice": "多人同时说话，音量高，语速快",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 33,
    "start": "00:03:30.000",
    "end": "00:03:35.000",
    "text": "",
    "speech": "",
    "emotion": "",
    "voice": "",
    "music": "",
    "audio_cues": [
      "手机铃声响起"
    ],
    "uncertainty": ""
  },
  {
    "id": 34,
    "start": "00:03:35.000",
    "end": "00:03:39.000",
    "text": "好了，书都带好了吗？嗯，上课好好听啊。",
    "speech": "单人发言",
    "emotion": "温和，关切",
    "voice": "语速缓慢，语气轻柔",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 35,
    "start": "00:03:39.000",
    "end": "00:03:43.000",
    "text": "老三回来了！老三回来了！",
    "speech": "多人重叠",
    "emotion": "惊喜，激动",
    "voice": "多人同时呼喊，音量高",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 36,
    "start": "00:03:43.000",
    "end": "00:03:47.000",
    "text": "三哥真的回来了？哎，知渊，马上给我请假，今天这学上不了了！",
    "speech": "单人发言",
    "emotion": "急切，兴奋",
    "voice": "语速快，音量高",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 37,
    "start": "00:03:47.000",
    "end": "00:03:52.000",
    "text": "妈妈，老三三年没回来了，我真的很想他。",
    "speech": "单人发言",
    "emotion": "思念，恳求",
    "voice": "语速慢，声音低沉，带着渴望",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 38,
    "start": "00:03:52.000",
    "end": "00:03:56.000",
    "text": "妈妈……",
    "speech": "单人发言",
    "emotion": "再次恳求",
    "voice": "音量更小，拖长音",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 39,
    "start": "00:03:56.000",
    "end": "00:03:58.000",
    "text": "行吧，就这一次。",
    "speech": "单人发言",
    "emotion": "无奈，妥协",
    "voice": "语速慢，叹了口气",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 40,
    "start": "00:03:58.000",
    "end": "00:04:04.000",
    "text": "真的？耶！太好了！Yes！老三，我来了！",
    "speech": "单人发言",
    "emotion": "狂喜，兴奋",
    "voice": "音量突然拔高，语速快，欢呼",
    "music": "",
    "audio_cues": [
      "欢呼声"
    ],
    "uncertainty": ""
  }
]