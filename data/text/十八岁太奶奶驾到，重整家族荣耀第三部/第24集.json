    "text": "我数三个数，三，二。",
    "speech": "单人发言",
    "emotion": "语气逐渐严肃",
    "voice": "语速放慢，带着威慑力",
    "music": "延续温情舒缓的钢琴背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 27,
    "start": "00:03:18.330",
