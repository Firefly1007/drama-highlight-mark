[
  {
    "id": 1,
    "start": "00:00:00.000",
    "end": "00:00:02.070",
    "text": "小弟你也别难过。",
    "speech": "单人发言",
    "emotion": "",
    "voice": "语气轻松",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 2,
    "start": "00:00:02.110",
    "end": "00:00:02.980",
    "text": "你别过来。",
    "speech": "单人发言",
    "emotion": "抗拒",
    "voice": "语气带着抗拒",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 3,
    "start": "00:00:03.020",
    "end": "00:00:06.070",
    "text": "三哥给你准备了一个独一无二的礼物。",
    "speech": "单人发言",
    "emotion": "略带得意",
    "voice": "语速平稳",
    "music": "轻快诙谐的管弦背景音乐响起",
    "audio_cues": [
      "短促的类似礼物包装的摩擦声"
    ],
    "uncertainty": ""
  },
  {
    "id": 4,
    "start": "00:00:15.430",
    "end": "00:00:21.470",
    "text": "转给你个文档，里面有三哥二十多年的经验总结的泡妹秘籍。",
    "speech": "单人发言",
    "emotion": "认真又带点炫耀",
    "voice": "语气郑重",
    "music": "延续轻快诙谐的管弦背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 5,
    "start": "00:00:23.190",
    "end": "00:00:30.710",
    "text": "我单身这么多年，终于能够脱单了，三哥。",
    "speech": "单人发言",
    "emotion": "激动又带着期盼",
    "voice": "声音带着明显的颤抖",
    "music": "延续轻快诙谐的管弦背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 6,
    "start": "00:00:32.430",
    "end": "00:00:33.070",
    "text": "呵呵。",
    "speech": "单人发言",
    "emotion": "开心",
    "voice": "发出两声轻笑",
    "music": "延续轻快诙谐的管弦背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 7,
    "start": "00:00:44.020",
    "end": "00:00:49.230",
    "text": "三哥，你没发错文件吧，怎么全是你自拍啊？",
    "speech": "单人发言",
    "emotion": "困惑不解",
    "voice": "语气充满疑惑",
    "music": "延续轻快诙谐的管弦背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 8,
    "start": "00:00:49.330",
    "end": "00:00:55.470",
    "text": "没错，泡妹秘籍最关键的。",
    "speech": "单人发言",
    "emotion": "理直气壮",
    "voice": "语气笃定",
    "music": "延续轻快诙谐的管弦背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 9,
    "start": "00:00:58.800",
    "end": "00:00:59.590",
    "text": "靠！",
    "speech": "单人发言",
    "emotion": "无语",
    "voice": "语气带着无奈",
    "music": "延续轻快诙谐的管弦背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 10,
    "start": "00:01:02.360",
    "end": "00:01:09.380",
    "text": "哎呀，你别拦我，我要揍死他，你给我过来，你给我过来，你了不起是吧你。",
    "speech": "多人重叠发言",
    "emotion": "情绪激动，愤怒叫嚷",
    "voice": "多人声音混杂，音量拔高",
    "music": "延续轻快诙谐的管弦背景音乐",
    "audio_cues": [],
    "uncertainty": "部分台词因多人重叠略显模糊"
  },
  {
    "id": 11,
    "start": "00:01:11.310",
    "end": "00:01:17.310",
    "text": "太奶奶，我生病耽误了太多时间，明天我就要回单位报道了。",
    "speech": "单人发言",
    "emotion": "诚恳",
    "voice": "语气平和郑重",
    "music": "转为舒缓温情的管弦背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 12,
    "start": "00:01:19.330",
    "end": "00:01:21.630",
    "text": "你还挺有责任心的，去忙吧。",
    "speech": "单人发言",
    "emotion": "温和赞许",
    "voice": "语气舒缓",
    "music": "延续舒缓温情的管弦背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 13,
    "start": "00:01:28.420",
    "end": "00:01:30.810",
    "text": "太奶奶，我们还会再见。",
    "speech": "单人发言",
    "emotion": "不舍",
    "voice": "语气带着眷恋",
    "music": "延续舒缓温情的管弦背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 14,
    "start": "00:01:38.710",
    "end": "00:01:40.930",
    "text": "有时间我再回来看你。",
    "speech": "单人发言",
    "emotion": "真诚",
    "voice": "语气郑重",
    "music": "延续舒缓温情的管弦背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 15,
    "start": "00:01:41.030",
    "end": "00:01:45.090",
    "text": "你还敢回来，你看我不打死你，你过来你了不起。",
    "speech": "多人重叠发言",
    "emotion": "愤怒叫嚷",
    "voice": "多人声音混杂，音量拔高",
    "music": "延续舒缓温情的管弦背景音乐",
    "audio_cues": [],
    "uncertainty": "部分台词因多人重叠略显模糊"
  },
  {
    "id": 16,
    "start": "00:01:45.130",
    "end": "00:01:46.360",
    "text": "老三棒棒的。",
    "speech": "单人发言",
    "emotion": "赞许",
    "voice": "语气明快",
    "music": "延续舒缓温情的管弦背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 17,
    "start": "00:01:46.530",
    "end": "00:01:48.010",
    "text": "这三哥不挺好。",
    "speech": "单人发言",
    "emotion": "感慨",
    "voice": "语气平和",
    "music": "延续舒缓温情的管弦背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 18,
    "start": "00:01:49.730",
    "end": "00:02:00.070",
    "text": "英宝，既然现在老三的事都解决了，你也没什么理由请假了，是不是该上学了？",
    "speech": "单人发言",
    "emotion": "温和但带着不容拒绝的意味",
    "voice": "语速平稳，语气清晰",
    "music": "延续舒缓温情的管弦背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 19,
    "start": "00:02:03.260",
    "end": "00:02:03.980",
    "text": "上学。",
    "speech": "单人发言",
    "emotion": "茫然",
    "voice": "语气带着迟疑",
    "music": "延续舒缓温情的管弦背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 20,
    "start": "00:02:04.830",
    "end": "00:02:06.860",
    "text": "嗯，上学。",
    "speech": "单人发言",
    "emotion": "肯定",
    "voice": "语气坚定",
    "music": "延续舒缓温情的管弦背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 21,
    "start": "00:02:07.070",
    "end": "00:02:27.430",
    "text": "哎呀，妈妈孙子要上学，为什么我也要上学，命运啊，为什么折磨我。",
    "speech": "单人发言",
    "emotion": "崩溃哀嚎",
    "voice": "声音带着哭腔，语调夸张起伏",
    "music": "转为悲伤滑稽的管弦背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 22,
    "start": "00:02:34.700",
    "end": "00:02:36.770",
    "text": "英宝，起来上学了。",
    "speech": "单人发言",
    "emotion": "温和",
    "voice": "语气轻柔",
    "music": "轻快的日常背景音乐响起",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 23,
    "start": "00:02:37.210",
    "end": "00:02:45.450",
    "text": "哎呦，妈妈，我发烧了，我上不了学了。",
    "speech": "单人发言",
    "emotion": "装病撒娇",
    "voice": "声音带着刻意的虚弱感",
    "music": "延续轻快的日常背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 24,
    "start": "00:02:53.160",
    "end": "00:02:54.970",
    "text": "英宝，上学了。",
    "speech": "单人发言",
    "emotion": "温和",
    "voice": "语气轻柔",
    "music": "转为温情舒缓的钢琴背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 25,
    "start": "00:02:55.540",
    "end": "00:03:03.210",
    "text": "妈妈，我发烧了，上不了学了。",
    "speech": "单人发言",
    "emotion": "装病撒娇",
    "voice": "声音带着刻意的虚弱感，语调拖长",
    "music": "延续温情舒缓的钢琴背景音乐",
