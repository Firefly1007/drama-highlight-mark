[
  {
    "id": 1,
    "start": "00:00:00.000",
    "end": "00:00:03.000",
    "text": "太奶奶，我已经查出来这辆车被谁动了手脚。",
    "speech": "单人发言",
    "emotion": "",
    "voice": "",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 2,
    "start": "00:00:09.430",
    "end": "00:00:11.330",
    "text": "你不说那荣玉肯定死了吗？",
    "speech": "单人发言",
    "emotion": "",
    "voice": "",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 3,
    "start": "00:00:11.680",
    "end": "00:00:16.830",
    "text": "谁知道呢，荣玉是什么怪物，快跑吧，一会儿到了机场就万事大吉了。",
    "speech": "单人发言",
    "emotion": "",
    "voice": "",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 4,
    "start": "00:00:28.380",
    "end": "00:00:29.220",
    "text": "抓住他们！",
    "speech": "单人发言",
    "emotion": "情绪激烈",
    "voice": "大声喊叫",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 5,
    "start": "00:00:30.430",
    "end": "00:00:33.270",
    "text": "站住，站住，快跑快跑！",
    "speech": "多人重叠发言",
    "emotion": "惊慌",
    "voice": "多人声音重叠，语速急促",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 6,
    "start": "00:00:34.030",
    "end": "00:00:34.770",
    "text": "拦住他们！",
    "speech": "单人发言",
    "emotion": "情绪激烈",
    "voice": "大声喊叫",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 7,
    "start": "00:00:34.910",
    "end": "00:00:35.920",
    "text": "哎哎！",
    "speech": "单人发言",
    "emotion": "惊慌",
    "voice": "大声呼喊",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 8,
    "start": "00:00:37.710",
    "end": "00:00:40.330",
    "text": "站住，站回去！",
    "speech": "单人发言",
    "emotion": "严肃",
    "voice": "语气强硬",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 9,
    "start": "00:00:41.490",
    "end": "00:00:42.840",
    "text": "你们要干什么？",
    "speech": "单人发言",
    "emotion": "惊慌",
    "voice": "声音略带颤抖",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 10,
    "start": "00:00:43.200",
    "end": "00:00:48.270",
    "text": "我刚从鬼门关回来，准备把你们也送过去转一转。",
    "speech": "单人发言",
    "emotion": "情绪冰冷",
    "voice": "语调平稳，语气冰冷",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 11,
    "start": "00:00:49.270",
    "end": "00:00:50.830",
    "text": "她的杀气怎么这么强？",
    "speech": "单人发言",
    "emotion": "震惊",
    "voice": "压低声音",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 12,
    "start": "00:00:51.730",
    "end": "00:00:56.060",
    "text": "你车出问题跟我们有什么关系啊，又不是我们弄的。",
    "speech": "单人发言",
    "emotion": "慌张",
    "voice": "语速偏快",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 13,
    "start": "00:00:56.460",
    "end": "00:01:00.470",
    "text": "哦，可我们还没说是因为车的问题。",
    "speech": "单人发言",
    "emotion": "从容",
    "voice": "语调平缓",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 14,
    "start": "00:01:02.010",
    "end": "00:01:06.430",
    "text": "果然是你们两个，我要把你们抓进去，永远都别想出来。",
    "speech": "单人发言",
    "emotion": "愤怒",
    "voice": "语气严厉",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 15,
    "start": "00:01:07.500",
    "end": "00:01:12.330",
    "text": "季老爷子，我肚子里怀的可是你们季家的金孙啊！",
    "speech": "单人发言",
    "emotion": "急切",
    "voice": "语气带着哀求",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 16,
    "start": "00:01:12.720",
    "end": "00:01:19.200",
    "text": "你肚子里就是怀着皇上也不行，你们敢伤害荣小姐，我绝不允许，把他们抓起来！",
    "speech": "单人发言",
    "emotion": "愤怒",
    "voice": "大声命令，语气强硬",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 17,
    "start": "00:01:19.480",
    "end": "00:01:22.920",
    "text": "哎，是是，走，回来。",
    "speech": "多人重叠发言",
    "emotion": "慌乱",
    "voice": "多人声音混杂",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 18,
    "start": "00:01:23.120",
    "end": "00:01:33.640",
    "text": "杀人了，杀人了，杀人了！这孕妇怎么了？是啊，怎么回事，怎么躺地上了？",
    "speech": "多人重叠发言",
    "emotion": "多人情绪激烈",
    "voice": "多人声音混杂，此起彼伏",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 19,
    "start": "00:01:33.670",
    "end": "00:01:42.370",
    "text": "我怀了季家三少爷的孩子，结果季家人嫌弃我出身穷苦，要把我和孩子都送进监狱，要要我跟孩子的命！",
    "speech": "单人发言",
    "emotion": "委屈悲愤",
    "voice": "声音带着哭腔",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 20,
    "start": "00:01:42.590",
    "end": "00:01:47.050",
    "text": "啊，这季家人怎么这样啊，快拍下来发网上。",
    "speech": "多人重叠发言",
    "emotion": "众人情绪激动",
    "voice": "多人声音混杂",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 21,
    "start": "00:01:47.080",
    "end": "00:01:49.810",
    "text": "季家人太坏了，大家不能见死不救啊！",
    "speech": "单人发言",
    "emotion": "情绪激动",
    "voice": "大声呼喊",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 22,
    "start": "00:01:49.880",
    "end": "00:01:54.380",
    "text": "外面传季家是积善之家，怎么背后做出这么龌龊的事？",
    "speech": "多人轮流发言",
    "emotion": "众人愤慨",
    "voice": "多人声音此起彼伏",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 23,
    "start": "00:01:54.510",
    "end": "00:01:55.570",
    "text": "真是虚伪。",
    "speech": "单人发言",
    "emotion": "鄙夷",
    "voice": "",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 24,
    "start": "00:01:57.030",
    "end": "00:01:58.620",
    "text": "你们别听风就是雨啊！",
    "speech": "单人发言",
    "emotion": "急切辩解",
    "voice": "语速偏快",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 25,
    "start": "00:01:59.230",
    "end": "00:02:04.200",
    "text": "鸡蛋和石头我们一定会站鸡蛋这边，对，我们都站在这可怜的孕妇这边。",
    "speech": "多人重叠发言",
    "emotion": "众人情绪激昂",
    "voice": "多人声音混杂",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 26,
    "start": "00:02:04.270",
    "end": "00:02:09.170",
    "text": "今天的公道我们主持了，不会让恶毒的季家把你带走。",
    "speech": "单人发言",
    "emotion": "情绪激昂",
    "voice": "大声发言",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 27,
    "start": "00:02:09.600",
    "end": "00:02:10.070",
    "text": "嗯。",
    "speech": "单人发言",
    "emotion": "沉稳",
    "voice": "低声回应",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 28,
    "start": "00:02:14.160",
    "end": "00:02:17.770",
    "text": "既然是季家的事，为何不问问我的意见？",
    "speech": "单人发言",
    "emotion": "从容",
    "voice": "语调平缓，气场沉稳",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 29,
    "start": "00:02:22.470",
    "end": "00:02:37.060",
    "text": "",
    "speech": "",
    "emotion": "",
    "voice": "",
    "music": "带有节奏的流行抒情背景音乐，旋律舒缓",
    "audio_cues": [
      "清晰的脚步声"
    ],
    "uncertainty": ""
  },
  {
    "id": 30,
    "start": "00:02:47.770",
    "end": "00:02:50.130",
    "text": "三哥，三弟，老三。",
    "speech": "多人轮流发言",
    "emotion": "惊讶",
    "voice": "多人声音先后响起",
    "music": "流行抒情背景音乐持续播放",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 31,
    "start": "00:03:03.330",
    "end": "00:03:07.540",
    "text": "哇，好帅啊，这人是明星吗？",
    "speech": "多人重叠发言",
    "emotion": "众人兴奋惊叹",
    "voice": "多人声音混杂，充满赞叹",
    "music": "流行抒情背景音乐持续播放",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 32,
    "start": "00:03:14.510",
    "end": "00:03:17.710",
    "text": "三哥，他变成以前的样子了。",
    "speech": "单人发言",
    "emotion": "惊讶",
    "voice": "语气带着难以置信",
    "music": "流行抒情背景音乐持续播放",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 33,
    "start": "00:03:19.130",
    "end": "00:03:21.130",
    "text": "老三，恢复记忆了。",
    "speech": "单人发言",
    "emotion": "平静",
    "voice": "语调平缓",
    "music": "流行抒情背景音乐持续播放",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 34,
    "start": "00:03:22.340",
    "end": "00:03:26.340",
    "text": "你说你怀的是我的孩子，但我怎么不认识你？",
    "speech": "单人发言",
    "emotion": "从容",
    "voice": "语气沉稳",
    "music": "流行抒情背景音乐持续播放至音频结束",
    "audio_cues": [],
    "uncertainty": ""
  }
]