    ],
    "uncertainty": ""
  },
  {
    "id": 6,
    "start": "00:00:50.910",
    "end": "00:01:04.490",
    "text": "跑不了了，高利贷的人都找到我了，我们只能一条道走到黑，既然有人想挡我们发财，就别怪我们了。",
    "speech": "单人发言",
    "emotion": "阴狠决绝",
    "voice": "语气低沉狠厉",
    "music": "悬疑紧张的背景音乐持续",
    "audio_cues": [
      "虫鸣声"
    ],
    "uncertainty": ""
  },
  {
    "id": 7,
    "start": "00:01:06.600",
    "end": "00:01:12.110",
    "text": "妈，你跟我来来来，慢点，云宝，快来，跟我来，什么事啊这么急？",
    "speech": "多人对话",
    "emotion": "前者兴奋急切，后者疑惑",
    "voice": "前者语速急促，后者语气带着疑问",
