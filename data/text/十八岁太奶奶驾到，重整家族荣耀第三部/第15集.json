  {
    "id": 4,
    "start": "00:00:29.130",
    "end": "00:00:31.360",
    "text": "我不能坐牢！",
    "speech": "单人喊叫发言",
    "emotion": "情绪崩溃，激动嘶吼",
    "voice": "音量骤然拔高，嘶吼出声",
