    "uncertainty": ""
  },
  {
    "id": 3,
    "start": "00:00:12.000",
    "end": "00:00:14.000",
    "text": "等一下",
    "speech": "单人发言",
    "emotion": "语气急切",
    "voice": "音量中等",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 4,
    "start": "00:00:14.000",
    "end": "00:00:23.000",
    "text": "",
    "speech": "",
    "emotion": "",
    "voice": "",
    "music": "紧张激烈的背景音乐响起",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 5,
    "start": "00:00:23.000",
    "end": "00:00:31.000",
    "text": "啊！啊！啊！啊！敢欺负我三哥！",
    "speech": "单人发言",
    "emotion": "痛苦、愤怒",
    "voice": "音量拔高，语速快",
    "music": "背景音乐持续",
    "audio_cues": [
      "人声重叠",
      "类似击打的音效"
    ],
    "uncertainty": ""
  },
  {
    "id": 6,
    "start": "00:00:31.000",
    "end": "00:00:45.000",
    "text": "",
    "speech": "",
    "emotion": "",
    "voice": "",
    "music": "背景音乐减弱",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 7,
    "start": "00:00:45.000",
    "end": "00:00:54.000",
    "text": "至于你，老三他心地善良，你就这么放任他被别人欺负，你真会如你所说的爱他护他？你肚子里的孩子，真是他的吗？",
    "speech": "单人发言",
    "emotion": "质问、冷淡",
    "voice": "语速适中，语气压迫",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 8,
    "start": "00:00:54.000",
    "end": "00:01:05.000",
    "text": "季老爷子，我真的错了，他丢下怀孕的我，我确实有怨气，加上孕期荷尔蒙作祟，我是真的真的知道错了，求您饶过我一回，给我个机会吧季老爷子。",
    "speech": "单人发言",
    "emotion": "哀求、慌张",
    "voice": "声音发抖，语速快",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 9,
    "start": "00:01:05.000",
    "end": "00:01:18.000",
    "text": "您看，把这个房间里所有值钱的东西都搬走，取消她少奶奶的待遇，好让她在这里安心反思，省得出去败坏季家名声。",
    "speech": "单人发言",
    "emotion": "冷酷、果断",
    "voice": "语速平稳，音量中等",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 10,
    "start": "00:01:18.000",
    "end": "00:01:29.000",
    "text": "是。来人！把这个房间里所有值钱的东西全都拿走，取消她少奶奶的一切待遇。",
    "speech": "单人发言",
    "emotion": "顺从、命令",
    "voice": "音量拔高",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 11,
    "start": "00:01:29.000",
    "end": "00:01:32.000",
    "text": "是是。",
    "speech": "单人发言",
    "emotion": "顺从",
    "voice": "音量较低",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 12,
    "start": "00:01:32.000",
    "end": "00:01:40.000",
    "text": "这个龙宇，感觉不仅是老四老五的同学，他到底是什么人？",
    "speech": "单人发言",
    "emotion": "疑惑",
    "voice": "语速放缓，低声自语",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 13,
    "start": "00:01:40.000",
    "end": "00:01:49.000",
    "text": "涵涵这里痛痛，老婆姐姐，你帮涵涵吹吹。住口！还敢让我妈妈给你吹吹？我打！",
    "speech": "多人对话",
    "emotion": "撒娇、愤怒",
    "voice": "语速变化快，音量起伏大",
    "music": "",
    "audio_cues": [
      "人声重叠"
    ],
    "uncertainty": ""
  },
  {
    "id": 14,
    "start": "00:01:49.000",
    "end": "00:01:54.000",
    "text": "好吧，那儿子你给爹吹吹。",
    "speech": "单人发言",
    "emotion": "无奈、戏谑",
    "voice": "语速放缓",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 15,
    "start": "00:01:54.000",
    "end": "00:01:59.000",
    "text": "我去！看我今天不打死你！",
    "speech": "单人发言",
    "emotion": "愤怒",
    "voice": "音量拔高，语速快",
    "music": "",
    "audio_cues": [
      "击打音效"
    ],
    "uncertainty": ""
  },
  {
    "id": 16,
    "start": "00:01:59.000",
    "end": "00:02:04.000",
    "text": "没事没事没事，来来来，拥抱。",
    "speech": "单人发言",
    "emotion": "安抚、轻松",
    "voice": "语速平缓",
    "music": "",
    "audio_cues": [],
    "uncertainty": ""
  },
