  {
    "id": 6,
    "start": "00:00:32.500",
    "end": "00:00:35.500",
    "text": "天天这么对我，我受不了了。",
    "speech": "单人发言",
    "emotion": "压抑的情绪爆发",
    "voice": "声音带着委屈和愤怒",
    "music": "",
