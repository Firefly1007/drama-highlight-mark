    "speech": "单人发言",
    "emotion": "平静、威严",
    "voice": "语速缓慢，语气不容置疑",
    "music": "快节奏动感背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 20,
    "start": "00:01:05.000",
