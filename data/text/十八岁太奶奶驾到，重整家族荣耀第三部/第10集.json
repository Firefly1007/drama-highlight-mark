    "speech": "单人发言",
    "emotion": "厌恶、狠毒",
    "voice": "压低声音，咬牙切齿",
    "music": "快节奏动感背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 33,
    "start": "00:01:47.500",
    "end": "00:01:51.000",
    "text": "哼，你就等着被赶出家门吧！",
    "speech": "单人发言",
    "emotion": "得意、幸灾乐祸",
    "voice": "语气轻蔑",
    "music": "快节奏动感背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 34,
    "start": "00:01:51.000",
