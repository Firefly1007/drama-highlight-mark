    "speech": "单人发言",
    "emotion": "威严、质问",
    "voice": "语速缓慢，语气低沉",
    "music": "快节奏动感背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 12,
    "start": "00:00:35.500",
    "end": "00:00:38.500",
    "text": "别得意，少奶奶怀的可是季家的金孙。",
    "speech": "单人发言，低声警告",
    "emotion": "不甘、威胁",
    "voice": "压低声音，语速偏慢",
    "music": "快节奏动感背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
