    "speech": "单人发言",
    "emotion": "愤怒、震惊",
    "voice": "音量提高，语气激动",
    "music": "快节奏动感背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 21,
    "start": "00:01:07.500",
