[
  {
    "id": 1,
    "start": "00:00:00.000",
    "end": "00:00:04.000",
    "text": "在季家还没有人是我动不了的。",
    "speech": "单人发言",
    "emotion": "嚣张挑衅",
    "voice": "语调上扬，语气充满自信和威胁",
    "music": "快节奏动感背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 2,
    "start": "00:00:04.000",
    "end": "00:00:06.000",
    "text": "",
    "speech": "",
    "emotion": "",
    "voice": "",
    "music": "快节奏动感背景音乐",
    "audio_cues": [
      "一声短促的吸气或惊叹声"
    ],
    "uncertainty": ""
  },
  {
    "id": 3,
    "start": "00:00:06.000",
    "end": "00:00:12.500",
    "text": "四少爷五少爷，你们看她多嚣张啊！你们就这么放任她在季家无法无天吗？",
    "speech": "单人发言，向他人控诉",
    "emotion": "气愤、委屈",
    "voice": "语速较快，声音尖锐",
    "music": "快节奏动感背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 4,
    "start": "00:00:12.500",
    "end": "00:00:15.000",
    "text": "当然。",
    "speech": "多人重叠发言",
    "emotion": "",
    "voice": "语气肯定",
    "music": "快节奏动感背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 5,
    "start": "00:00:15.000",
    "end": "00:00:18.500",
    "text": "我，我知道你们两个都喜欢她，",
    "speech": "单人发言",
    "emotion": "气愤、急切",
    "voice": "语速快，略有结巴",
    "music": "快节奏动感背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 6,
    "start": "00:00:18.500",
    "end": "00:00:20.500",
    "text": "但是你们都被她骗了！",
    "speech": "单人发言，延续上一句",
    "emotion": "气愤、指责",
    "voice": "音量提高",
    "music": "快节奏动感背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 7,
    "start": "00:00:20.500",
    "end": "00:00:25.500",
    "text": "她就是个绿茶，脚踏两只船，PUA你们，让你们都捧着她。",
    "speech": "单人发言，延续指控",
    "emotion": "厌恶、鄙视",
    "voice": "语速快，咬字用力",
    "music": "快节奏动感背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 8,
    "start": "00:00:25.500",
    "end": "00:00:28.500",
    "text": "你他妈瞎说啥呢？",
    "speech": "单人发言，打断并反驳",
    "emotion": "愤怒、维护",
    "voice": "声音突然拔高，语气粗鲁",
    "music": "快节奏动感背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 9,
    "start": "00:00:28.500",
    "end": "00:00:30.000",
    "text": "容小姐允许我们捧着，",
    "speech": "单人发言",
    "emotion": "平静、理所当然",
    "voice": "语速平缓",
    "music": "快节奏动感背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 10,
    "start": "00:00:30.000",
    "end": "00:00:32.000",
    "text": "是我们的荣幸。",
    "speech": "单人发言，延续上一句",
    "emotion": "平静、坚定",
    "voice": "语气肯定",
    "music": "快节奏动感背景音乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 11,
    "start": "00:00:32.000",
    "end": "00:00:35.500",
