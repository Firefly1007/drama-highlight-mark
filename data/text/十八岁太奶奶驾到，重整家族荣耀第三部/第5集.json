[
  {
    "id": 1,
    "start": "00:00:00.000",
    "end": "00:00:04.799",
    "text": "老爷。",
    "speech": "单人发言",
    "emotion": "",
    "voice": "语气恭敬",
    "music": "轻柔带悬疑感的钢琴背景音乐",
    "audio_cues": [
      "脚步声"
    ],
    "uncertainty": ""
  },
  {
    "id": 2,
    "start": "00:00:05.100",
    "end": "00:00:08.400",
    "text": "小钱，她你认识吗？",
    "speech": "单人发言",
    "emotion": "语气沉稳",
    "voice": "语速平缓",
    "music": "悬疑背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 3,
    "start": "00:00:13.800",
    "end": "00:00:18.000",
    "text": "她叫张丽丽吧，见过，见过很多次。",
    "speech": "单人发言",
    "emotion": "略带迟疑",
    "voice": "语气肯定",
    "music": "背景音乐转为紧张激昂的弦乐",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 4,
    "start": "00:00:27.800",
    "end": "00:00:28.800",
    "text": "她没说谎。",
    "speech": "单人发言",
    "emotion": "冷静",
    "voice": "语速平稳",
    "music": "紧张音乐戛然而止",
    "audio_cues": [
      "清脆的响指声"
    ],
    "uncertainty": ""
  },
  {
    "id": 5,
    "start": "00:00:31.300",
    "end": "00:00:33.000",
    "text": "果然是三哥。",
    "speech": "单人发言",
    "emotion": "恍然大悟",
    "voice": "语气轻松",
    "music": "富有节奏感的电子背景音乐切入",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 6,
    "start": "00:00:35.800",
    "end": "00:00:50.000",
    "text": "先下去吧，事情虽然还没调查清楚，但她怀着孕跑来跑去确实有些危险，不如让张小姐，先留在纪家。",
    "speech": "单人发言",
    "emotion": "从容",
    "voice": "语速不疾不徐",
    "music": "电子背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 7,
    "start": "00:00:51.300",
    "end": "00:00:54.500",
    "text": "如果你说的是真的，纪家不会亏待你。",
    "speech": "单人发言",
    "emotion": "郑重",
    "voice": "语气严肃",
    "music": "电子背景音乐持续",
    "audio_cues": [
      "卡通特效音"
    ],
    "uncertainty": ""
  },
  {
    "id": 8,
    "start": "00:00:56.500",
    "end": "00:00:59.500",
    "text": "哎，哎，哎不是你。",
    "speech": "单人发言",
    "emotion": "慌乱",
    "voice": "语气错愕",
    "music": "电子背景音乐持续",
    "audio_cues": [
      "卡通特效音"
    ],
    "uncertainty": ""
  },
  {
    "id": 9,
    "start": "00:01:00.100",
    "end": "00:01:10.500",
    "text": "这张卡，你随便刷，纪家会以纪家少夫人的规格好好招待你，您看我这样安排行吗？",
    "speech": "单人发言",
    "emotion": "恭敬",
    "voice": "态度恳切",
    "music": "电子背景音乐转为诙谐风格",
    "audio_cues": [
      "卡通特效音"
    ],
    "uncertainty": ""
  },
  {
    "id": 10,
    "start": "00:01:11.000",
    "end": "00:01:13.000",
    "text": "嗯，先这样吧。",
    "speech": "单人发言",
    "emotion": "淡然",
    "voice": "语气平淡",
    "music": "诙谐的管弦乐背景音乐响起",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 11,
    "start": "00:01:14.300",
    "end": "00:01:19.000",
    "text": "那我先去安排房间，有限额啊！",
    "speech": "单人发言",
    "emotion": "略带窘迫",
    "voice": "语速稍快",
    "music": "诙谐管弦乐背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 12,
    "start": "00:01:25.800",
    "end": "00:01:32.000",
    "text": "怎么纪家人都看这女的眼色，这女的到底谁呀？",
    "speech": "单人发言",
    "emotion": "疑惑不解",
    "voice": "低声自语",
    "music": "诙谐管弦乐背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 13,
    "start": "00:01:32.700",
    "end": "00:01:41.500",
    "text": "奥特曼，你要有老婆喽，哎，我不要刚刚那个人做我老婆，我要荣誉姐姐做我老婆。",
    "speech": "多人轮流发言",
    "emotion": "兴奋、抗拒",
    "voice": "年轻男声高亢，另一个男声带着撒娇感",
    "music": "轻快活泼的背景音乐切换",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 14,
    "start": "00:01:41.500",
    "end": "00:01:48.000",
    "text": "哎哎，那不行，那不行，为什么不行，她是你老婆吗？",
    "speech": "多人轮流发言",
    "emotion": "急切、疑惑",
    "voice": "多人声音此起彼伏",
    "music": "轻快背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 15,
    "start": "00:01:48.000",
    "end": "00:01:55.000",
    "text": "哎呦大哥，我，这话可不能乱说，你也不同意，那她是你老婆喽。",
    "speech": "多人轮流发言",
    "emotion": "慌张、调侃",
    "voice": "语气夸张",
    "music": "轻快背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 16,
    "start": "00:01:55.100",
    "end": "00:02:00.000",
    "text": "怎么可能，她不是你们的，那她就是，我的老婆喽。",
    "speech": "多人轮流发言",
    "emotion": "争抢的兴奋感",
    "voice": "语气得意",
    "music": "轻快背景音乐持续",
    "audio_cues": [
      "类似闪电的特效音"
    ],
    "uncertainty": ""
  },
  {
    "id": 17,
    "start": "00:02:00.000",
    "end": "00:02:04.000",
    "text": "哎呦我去，你这混账东西，她是我妈。",
    "speech": "多人轮流发言",
    "emotion": "暴怒",
    "voice": "音量陡然拔高",
    "music": "轻快背景音乐持续",
    "audio_cues": [],
    "uncertainty": ""
  },
  {
    "id": 18,
    "start": "00:02:04.500",
    "end": "00:02:10.500",
    "text": "那她是你妈妈，那她是我老婆，那我就是你爸爸喽。",
    "speech": "单人发言",
    "emotion": "搞怪",
    "voice": "语气带着戏谑",
    "music": "轻快背景音乐持续",
    "audio_cues": [
      "多人哄笑声"
    ],
    "uncertainty": ""
  }
]